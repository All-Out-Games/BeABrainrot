    float2 _113 = fma(in.in_var_TEXCOORD0, params.resolution_time.xy, -user_input.rect_px.xy);
    float _114 = _113.y;
    float _117 = 1.0 - fast::clamp(_114 / _111, 0.0, 1.0);
    float3 _119 = mix(powr(precise::max(user_input.top_color.xyz, float3(0.0)), float3(2.2000000476837158203125)), powr(precise::max(user_input.bottom_color.xyz, float3(0.0)), float3(2.2000000476837158203125)), float3(_117));
    float3 _188;
    if (user_input.rainbow_strength > 0.0)
    {
        float3 _180;
        do
        {
            float _151 = fract(fma((_113.x + (_111 - _114)) / (precise::max(1.0, user_input.rect_px.z - user_input.rect_px.x) + _111), (user_input.rainbow_hue_span > 0.0) ? user_input.rainbow_hue_span : 1.0, params.resolution_time.z * user_input.rainbow_speed));
            float _153 = floor(_151 * 6.0);
            float _155 = fma(_151, 6.0, -_153);
            float _156 = fma(-0.85000002384185791015625, _155, 1.0);
            float _158 = fma(-0.85000002384185791015625, 1.0 - _155, 1.0);
            if (_153 < 1.0)
