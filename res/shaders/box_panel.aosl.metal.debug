    float4 bottom_band_color;
    float outline_px;
    packed_float3 _ao_pad1;
    float4 outline_color;
    float corner_radius_px;
    float rainbow_strength;
    float rainbow_speed;
    float rainbow_hue_span;
    float press;
};

struct type_params
{
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};

struct ps_main_out
{
    float4 out_var_SV_Target0 [[color(0)]];
