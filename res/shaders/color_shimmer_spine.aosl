// Spine variant of color_shimmer.aosl (gold / diamond / candy). The base palette
// remap is luminance-based and works as-is, but the shimmer/sparkle/sweep
// patterns are driven by texture UV — which on a spine is the scattered 4K atlas
// UV, so the sparkle smears across the sheet. Fix: drive those patterns off the
// rig-local position normalized by shapeRect (minX,minY,sizeX,sizeY), exactly
// like rainbow_spine.aosl. albedo is still sampled with the real UV.
!!inputs {
	texture albedo ALBEDO
	texture noise_texture NOISE
	float3 paletteShadow
	float3 paletteMid
	float3 paletteHi
	float paletteBlackPoint
	float paletteWhitePoint
	float paletteGamma
	float tintStrength
	float shadowBoost
	float outlineLow
	float outlineHigh
	float outlineDarken
	float outlineLumaMin
	float outlineLumaMax
	float4 shapeRect // (minX, minY, sizeX, sizeY) in the rig's local space
}

!!pipeline {
	Pixel_Format: RGBA8_SRGB
	Blend_Enabled: true
	Depth_Enabled: true
	Blend_Src: ONE
	Blend_Dst: ONE_MINUS_SRC_ALPHA
	Blend_Op: ADD
	Alpha_Blend_Src: ONE
	Alpha_Blend_Dst: ONE
	Alpha_Blend_Op: ADD
	Blend_Color: (1, 1, 1, 1)
}

!!vs
struct vs_out {
	float4 color: COLOR0;
	float2 uv: UV;
	float2 local_pos: TEXCOORD0;
	float4 pos: SV_Position;
};
vs_out vs_main(vs_in inp) {
	vs_out outp;
	outp.pos = mul(mvp, float4(inp.pos.xy, 0, 1.0f));
	outp.uv = inp.uv;
	outp.color = inp.color;
	outp.local_pos = inp.pos.xy; // pre-MVP local position (rig space)
	return outp;
}

!!ps
float noise(float2 p)
{
	float s = noise_texture.Sample(noise_texture_smp, float2(1.0f, 2.0f - 2.0f*cos(resolution_time.z))*resolution_time.z*20.0f + p*1.0f).x;
	s *= s;
	return s;
}

float ramp(float y, float start, float end)
{
	float inside = step(start,y) - step(end,y);
	float fact = (y-start)/(end-start)*inside;
	return (1.-fact) * inside;
}

float4 ps_main(float4 vtxColor: COLOR0, float2 uv: UV, float2 local_pos: TEXCOORD0): SV_Target0 {
	float4 base = vtxColor * albedo.Sample(albedo_smp, uv);

	// Rig-local shape coordinate; flip Y to match UV's y-down convention so the
	// patterns sweep the same way as the sprite shader.
	float2 shapeSize = max(shapeRect.zw, float2(0.0001f, 0.0001f));
	float2 shape = (local_pos - shapeRect.xy) / shapeSize;
	float2 suv = float2(shape.x, 1.0f - shape.y);

	// Detect near-black outlines (keep as-is), tint everything else
	float luma = dot(base.rgb, float3(0.299f, 0.587f, 0.114f));
	float maxRGB = max(base.r, max(base.g, base.b));
	float nonOutline = smoothstep(outlineLow, outlineHigh, maxRGB);

	float denom = max(0.001f, paletteWhitePoint - paletteBlackPoint);
	float lNorm = saturate((luma - paletteBlackPoint) / denom);
	float shade = pow(lNorm, max(0.01f, paletteGamma));
	float3 toneA = lerp(paletteShadow, paletteMid, smoothstep(0.00f, 0.60f, shade));
	float3 goldTone = lerp(toneA, paletteHi,  smoothstep(0.65f, 1.00f, shade));

	float boost = lerp(1.0f, 1.0f + shadowBoost, 1.0f - shade);
	float tintW = saturate(tintStrength * nonOutline * boost);
	float3 rgb = lerp(base.rgb, goldTone, tintW);

	float outlineMask = 1.0f - nonOutline;
	float edge = 1.0f - outlineMask;
	float targetLuma = lerp(outlineLumaMin, outlineLumaMax, edge);
	float3 outlineGray = float3(targetLuma, targetLuma, targetLuma);
	rgb = lerp(rgb, outlineGray, outlineMask * saturate(outlineDarken));

	float3 gray = float3(luma, luma, luma);
	float vibrance = 0.38f;
	float vibMask = nonOutline * smoothstep(0.12f, 0.95f, shade);
	rgb = saturate(gray + (rgb - gray) * (1.0f + vibrance * vibMask));

	// Shimmer — patterns driven by `suv` (rig shape) instead of atlas UV.
	float t = resolution_time.z;
	float n1 = noise(suv*3.0f + float2(0.00f, 0.00f));
	float n2 = noise(suv*6.0f + float2(5.20f, 1.30f));
	float diagonal = sin((suv.x + suv.y)*24.0f + t*7.5f)*0.5f + 0.5f;
	float diagonal2 = sin((suv.x*1.3f - suv.y*1.1f)*34.0f + t*5.5f)*0.5f + 0.5f;
	float sweepCoord = fmod(suv.x*0.9f + suv.y*0.7f + t*0.85f, 1.0f);
	float sweep = ramp(sweepCoord, 0.35f, 0.65f);
	float baseNoise = (n1*0.6f + n2*0.4f);
	baseNoise = smoothstep(0.30f, 0.95f, baseNoise);
	float shimmer = baseNoise*0.95f + (diagonal*0.22f + diagonal2*0.18f) + sweep*1.25f;
	shimmer *= nonOutline * smoothstep(0.06f, 1.00f, luma);
	shimmer = saturate(shimmer);
	float hot = smoothstep(0.78f, 1.0f, shimmer) * 0.85f;
	float3 shimmerColor = float3(1.00f, 0.98f, 0.96f);
	float whiten = saturate(shimmer*0.35f + hot*0.85f);
	rgb = lerp(rgb, float3(1.0f, 1.0f, 1.0f), whiten);
	rgb += shimmer * shimmerColor * 0.12f;

	float spA = noise(suv*45.0f + float2(7.3f, 3.1f));
	float spB = noise(suv*85.0f + float2(1.1f, 9.7f));
	float twinkle = sin(t*12.0f + spA*9.0f)*0.5f + 0.5f;
	float sparkleMask = spA*0.7f + spB*0.3f + (twinkle-0.5f)*0.20f;
	float sparkle = step(0.965f, sparkleMask) * nonOutline * smoothstep(0.15f, 1.00f, luma);
	float3 sparkleColor = float3(1.00f, 0.95f, 0.55f);
	rgb += sparkle * sparkleColor * 1.35f;

	rgb = saturate(rgb);
	rgb *= base.a;
	return float4(rgb, base.a);
}
