// ray_spin — procedural rotating sun-ray burst, drawn as a UIK
// background_material_override. The rays are computed from the panel centre
// (no texture sampling), so it needs only rect_px — the card's screen rect,
// fed from CSL — and sidesteps atlas-uv handling entirely.

!!inputs {
    texture albedo ALBEDO    // unused by the effect; a UI draw still needs a bound texture
    float4 rect_px           // card screen rect (minX, minY, maxX, maxY)
    float spin_speed         // rotation rate, radians/second
    float fill_scale         // burst radius vs half the smaller rect dimension
}

!!pipeline {
    Pixel_Format: HDR
    Blend_Enabled: true
    Depth_Enabled: true
    Blend_Src: ONE
    Blend_Dst: ONE_MINUS_SRC_ALPHA
    Blend_Op: ADD
    Alpha_Blend_Src: ONE
    Alpha_Blend_Dst: ONE
    Alpha_Blend_Op: ADD
    Blend_Color: (1, 1, 1, 1)
}

!!vs
struct vs_out {
    float4 color: COLOR0;
    float2 uv: UV;
    float2 shadow_uv: TEXCOORD0;
    float4 pos: SV_Position;
};
vs_out vs_main(vs_in inp) {
    vs_out outp;
    outp.pos       = mul(mvp, float4(inp.pos.xy, 0, 1.0f));
    outp.uv        = inp.uv;
    outp.color     = inp.color;
    outp.shadow_uv = (outp.pos.xy + float2(1,1)) / 2;
    return outp;
}

!!ps
float3 to_linear(float3 c) { return pow(max(c, 0.0f), 2.2f); }

float4 ps_main(float4 vtxColor: COLOR0, float2 uv: UV, float2 shadow_uv: TEXCOORD0): SV_Target0 {
    float2 svpos_px = shadow_uv * resolution_time.xy;
    float2 rectMin  = rect_px.xy;
    float2 rectMax  = rect_px.zw;
    float2 center   = (rectMin + rectMax) * 0.5f;

    float2 p   = svpos_px - center;
    float  r   = length(p);
    float  ang = atan2(p.y, p.x) + resolution_time.z * spin_speed;

    // Alternating sun-ray wedges — smooth and seam-free across the wrap.
    float spokes = 12.0f;
    float sp     = frac(ang * spokes / 6.2831853f);
    float tri    = abs(sp - 0.5f) * 2.0f;
    float wedge  = smoothstep(0.42f, 0.78f, tri);

    // Radial fade from the centre outward.
    float maxR   = min(rectMax.x - rectMin.x, rectMax.y - rectMin.y) * 0.5f * max(fill_scale, 1e-3f);
    float radial = saturate(1.0f - r / max(maxR, 1.0f));
    radial = pow(radial, 1.3f);

    float  a   = wedge * radial * vtxColor.a;
    // keep `albedo` referenced so the image-binding count matches the desc
    float3 col = to_linear(vtxColor.rgb) + albedo.Sample(albedo_smp, uv).rgb * 0.0f;
    return float4(col * a, a);
}
