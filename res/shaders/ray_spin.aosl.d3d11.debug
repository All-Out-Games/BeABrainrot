HLSL:
Vertex Shader:
cbuffer user_input: register(b1) {
float4 rect_px;
float spin_speed;
float fill_scale;
};

#define MATRIX_TEXTURE_PROVIDED

struct vs_in {
    float2 pos: POS;
    float2 uv: UV;
    float2 uv2: UV1;
    float4 color: COLOR;
    int matrix_index: MATRIX_INDEX;
};


cbuffer params: register(b0) {
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};
#define FLIP_IF_GL(y) do { } while (0);

Texture2D<float4> matrices: register(t0);
sampler matrices_smp: register(s0);

#ifdef MATRIX_TEXTURE_PROVIDED
int3 create_pixel_coord(int index) {
    int x = index % matrix_image_size;
    int y = index / matrix_image_size;
    return int3(x, y, 0);
}
float4x4 final_mvp(vs_in inp) {
    float4 _0 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 0));
    float4 _1 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 1));
    float4 _2 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 2));
    float4 _3 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 3));
    float4x4 model_matrix = float4x4(_0, _1, _2, _3);
    #ifdef AO_WEB
    model_matrix = transpose(model_matrix);
    #endif
    return mul(mvp, model_matrix);
}
#endif

float4 bc7_correct_alpha(float4 color) {
    // map 254 to 255. this is because bc7 is lossy in the alpha channel and an opaque pixel often outputs as 254 alpha.
    if (color.a > 0.995f && color.a <= 1.0f) color.a = 1.0f;
    return color;
}

struct vs_out {
    float4 color: COLOR0;
    float2 uv: UV;
    float2 screen_uv: TEXCOORD0;
    float4 pos: SV_Position;
};
vs_out vs_main(vs_in inp) {
    vs_out outp;
    outp.pos = mul(mvp, float4(inp.pos.xy, 0, 1.0f));
    outp.uv = inp.uv;
    outp.screen_uv = (outp.pos.xy / outp.pos.w + float2(1,1)) * 0.5f;
    outp.color = inp.color;
    return outp;
}



Fragment Shader:
cbuffer user_input: register(b1) {
float4 rect_px;
float spin_speed;
float fill_scale;
};

Texture2D<float4> albedo: register(t0);
sampler albedo_smp: register(s0);
Texture2D<float4> image: register(t1);
sampler image_smp: register(s1);

#define MATRIX_TEXTURE_PROVIDED

struct vs_in {
    float2 pos: POS;
    float2 uv: UV;
    float2 uv2: UV1;
    float4 color: COLOR;
    int matrix_index: MATRIX_INDEX;
};


cbuffer params: register(b0) {
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};
#define FLIP_IF_GL(y) do { } while (0);

Texture2D<float4> matrices: register(t0);
sampler matrices_smp: register(s0);

#ifdef MATRIX_TEXTURE_PROVIDED
int3 create_pixel_coord(int index) {
    int x = index % matrix_image_size;
    int y = index / matrix_image_size;
    return int3(x, y, 0);
}
float4x4 final_mvp(vs_in inp) {
    float4 _0 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 0));
    float4 _1 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 1));
    float4 _2 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 2));
    float4 _3 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 3));
    float4x4 model_matrix = float4x4(_0, _1, _2, _3);
    #ifdef AO_WEB
    model_matrix = transpose(model_matrix);
    #endif
    return mul(mvp, model_matrix);
}
#endif

float4 bc7_correct_alpha(float4 color) {
    // map 254 to 255. this is because bc7 is lossy in the alpha channel and an opaque pixel often outputs as 254 alpha.
    if (color.a > 0.995f && color.a <= 1.0f) color.a = 1.0f;
    return color;
}

float4 ps_main(float4 vtxColor: COLOR0, float2 uv: UV, float2 screen_uv: TEXCOORD0): SV_Target0
{
    // Pixel position inside the panel rect that UIK feeds us via rect_px.
    float2 svpos_px = screen_uv * resolution_time.xy;
    float2 rectMin  = rect_px.xy;
    float2 rectMax  = rect_px.zw;
    float2 rectSize = max(rectMax - rectMin, 1e-6.xx);
    float2 center   = (rectMin + rectMax) * 0.5f;

    // Rotate the sample coordinate around the panel center. resolution_time.z
    // is elapsed time in seconds (same source box_panel.aosl uses for hue).
    float  ang = resolution_time.z * spin_speed;
    float  c   = cos(ang);
    float  s   = sin(ang);
    float2 p   = svpos_px - center;
    float2 rp  = float2(p.x * c - p.y * s, p.x * s + p.y * c);

    // Map into the burst texture: a centered square sized by the smaller
    // panel dimension, scaled by fill_scale so it can overflow the panel.
    float  half_dim = min(rectSize.x, rectSize.y) * 0.5f * max(fill_scale, 1e-3f);
    float2 uv_img   = rp / (2.0f * half_dim) + 0.5f;

    // Discard anything outside the texture so rotation doesn't clamp-smear.
    float2 inMin = step(0.0f, uv_img);
    float2 inMax = step(uv_img, 1.0f);
    float  mask  = inMin.x * inMin.y * inMax.x * inMax.y;

    float4 tex = image.Sample(image_smp, saturate(uv_img));
    float  a   = tex.a * mask * vtxColor.a;
    return float4(tex.rgb * vtxColor.rgb * a, a);
}

