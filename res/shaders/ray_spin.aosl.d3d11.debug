HLSL:
Vertex Shader:
cbuffer user_input: register(b1) {
float4 rect_px;
float spin_speed;
float fill_scale;
};

#define MATRIX_TEXTURE_PROVIDED

struct vs_in {
    float2 pos: POS;
    float2 uv: UV;
    float2 uv2: UV1;
    float4 color: COLOR;
    int matrix_index: MATRIX_INDEX;
};


cbuffer params: register(b0) {
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};
#define FLIP_IF_GL(y) do { } while (0);

Texture2D<float4> matrices: register(t0);
sampler matrices_smp: register(s0);

#ifdef MATRIX_TEXTURE_PROVIDED
int3 create_pixel_coord(int index) {
    int x = index % matrix_image_size;
    int y = index / matrix_image_size;
    return int3(x, y, 0);
}
float4x4 final_mvp(vs_in inp) {
    float4 _0 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 0));
    float4 _1 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 1));
    float4 _2 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 2));
    float4 _3 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 3));
    float4x4 model_matrix = float4x4(_0, _1, _2, _3);
    #ifdef AO_WEB
    model_matrix = transpose(model_matrix);
    #endif
    return mul(mvp, model_matrix);
}
#endif

float4 bc7_correct_alpha(float4 color) {
    // map 254 to 255. this is because bc7 is lossy in the alpha channel and an opaque pixel often outputs as 254 alpha.
    if (color.a > 0.995f && color.a <= 1.0f) color.a = 1.0f;
    return color;
}

struct vs_out {
    float4 color: COLOR0;
    float2 uv: UV;
    float2 shadow_uv: TEXCOORD0;
    float4 pos: SV_Position;
};
vs_out vs_main(vs_in inp) {
    vs_out outp;
    outp.pos       = mul(mvp, float4(inp.pos.xy, 0, 1.0f));
    outp.uv        = inp.uv;
    outp.color     = inp.color;
    outp.shadow_uv = (outp.pos.xy + float2(1,1)) / 2;
    return outp;
}



Fragment Shader:
cbuffer user_input: register(b1) {
float4 rect_px;
float spin_speed;
float fill_scale;
};

Texture2D<float4> albedo: register(t0);
sampler albedo_smp: register(s0);

#define MATRIX_TEXTURE_PROVIDED

struct vs_in {
    float2 pos: POS;
    float2 uv: UV;
    float2 uv2: UV1;
    float4 color: COLOR;
    int matrix_index: MATRIX_INDEX;
};


cbuffer params: register(b0) {
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};
#define FLIP_IF_GL(y) do { } while (0);

Texture2D<float4> matrices: register(t0);
sampler matrices_smp: register(s0);

#ifdef MATRIX_TEXTURE_PROVIDED
int3 create_pixel_coord(int index) {
    int x = index % matrix_image_size;
    int y = index / matrix_image_size;
    return int3(x, y, 0);
}
float4x4 final_mvp(vs_in inp) {
    float4 _0 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 0));
    float4 _1 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 1));
    float4 _2 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 2));
    float4 _3 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 3));
    float4x4 model_matrix = float4x4(_0, _1, _2, _3);
    #ifdef AO_WEB
    model_matrix = transpose(model_matrix);
    #endif
    return mul(mvp, model_matrix);
}
#endif

float4 bc7_correct_alpha(float4 color) {
    // map 254 to 255. this is because bc7 is lossy in the alpha channel and an opaque pixel often outputs as 254 alpha.
    if (color.a > 0.995f && color.a <= 1.0f) color.a = 1.0f;
    return color;
}

float3 to_linear(float3 c) { return pow(max(c, 0.0f), 2.2f); }

float4 ps_main(float4 vtxColor: COLOR0, float2 uv: UV, float2 shadow_uv: TEXCOORD0): SV_Target0 {
    float2 svpos_px = shadow_uv * resolution_time.xy;
    float2 rectMin  = rect_px.xy;
    float2 rectMax  = rect_px.zw;
    float2 center   = (rectMin + rectMax) * 0.5f;

    float2 p   = svpos_px - center;
    float  r   = length(p);
    float  ang = atan2(p.y, p.x) + resolution_time.z * spin_speed;

    // Alternating sun-ray wedges — smooth and seam-free across the wrap.
    float spokes = 12.0f;
    float sp     = frac(ang * spokes / 6.2831853f);
    float tri    = abs(sp - 0.5f) * 2.0f;
    float wedge  = smoothstep(0.42f, 0.78f, tri);

    // Radial fade from the centre outward.
    float maxR   = min(rectMax.x - rectMin.x, rectMax.y - rectMin.y) * 0.5f * max(fill_scale, 1e-3f);
    float radial = saturate(1.0f - r / max(maxR, 1.0f));
    radial = pow(radial, 1.3f);

    float  a   = wedge * radial * vtxColor.a;
    // keep `albedo` referenced so the image-binding count matches the desc
    float3 col = to_linear(vtxColor.rgb) + albedo.Sample(albedo_smp, uv).rgb * 0.0f;
    return float4(col * a, a);
}

