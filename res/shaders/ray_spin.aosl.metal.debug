Vertex Shader:
#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_params
{
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};

struct vs_main_out
{
    float4 out_var_COLOR0 [[user(locn0)]];
    float2 out_var_UV [[user(locn1)]];
    float2 out_var_TEXCOORD0 [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct vs_main_in
{
    float2 in_var_POS [[attribute(0)]];
    float2 in_var_UV [[attribute(1)]];
    float4 in_var_COLOR [[attribute(3)]];
};

vertex vs_main_out vs_main(vs_main_in in [[stage_in]], constant type_params& params [[buffer(0)]])
{
    vs_main_out out = {};
    float4 _40 = params.mvp * float4(in.in_var_POS, 0.0, 1.0);
    out.out_var_COLOR0 = in.in_var_COLOR;
    out.out_var_UV = in.in_var_UV;
    out.out_var_TEXCOORD0 = (_40.xy + float2(1.0)) * float2(0.5);
    out.gl_Position = _40;
    return out;
}



Fragment Shader:
#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_user_input
{
    float4 rect_px;
    float spin_speed;
    float fill_scale;
};

struct type_params
{
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};

struct ps_main_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct ps_main_in
{
    float4 in_var_COLOR0 [[user(locn0)]];
    float2 in_var_TEXCOORD0 [[user(locn2)]];
};

fragment ps_main_out ps_main(ps_main_in in [[stage_in]], constant type_params& params [[buffer(0)]], constant type_user_input& user_input [[buffer(1)]])
{
    ps_main_out out = {};
    float2 _54 = fma(in.in_var_TEXCOORD0, params.resolution_time.xy, -((user_input.rect_px.xy + user_input.rect_px.zw) * 0.5));
    float _89 = (smoothstep(0.4199999868869781494140625, 0.7799999713897705078125, abs(fract(fma(params.resolution_time.z, user_input.spin_speed, precise::atan2(_54.y, _54.x)) * 1.909859180450439453125) - 0.5) * 2.0) * powr(fast::clamp(1.0 - (length(_54) / precise::max((precise::min(user_input.rect_px.z - user_input.rect_px.x, user_input.rect_px.w - user_input.rect_px.y) * 0.5) * precise::max(user_input.fill_scale, 0.001000000047497451305389404296875), 1.0)), 0.0, 1.0), 1.2999999523162841796875)) * in.in_var_COLOR0.w;
    out.out_var_SV_Target0 = float4(powr(precise::max(in.in_var_COLOR0.xyz, float3(0.0)), float3(2.2000000476837158203125)) * _89, _89);
    return out;
}


