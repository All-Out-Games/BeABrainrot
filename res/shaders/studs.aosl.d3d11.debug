HLSL:
Vertex Shader:
cbuffer user_input: register(b1) {
float mask_in_shadow;
float stud_density;
float stud_size;
float light_strength;
float crevice_strength;
};

#define MATRIX_TEXTURE_PROVIDED

struct vs_in {
    float2 pos: POS;
    float2 uv: UV;
    float2 uv2: UV1;
    float4 color: COLOR;
    int matrix_index: MATRIX_INDEX;
};


cbuffer params: register(b0) {
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};
#define FLIP_IF_GL(y) do { } while (0);

Texture2D<float4> matrices: register(t0);
sampler matrices_smp: register(s0);

#ifdef MATRIX_TEXTURE_PROVIDED
int3 create_pixel_coord(int index) {
    int x = index % matrix_image_size;
    int y = index / matrix_image_size;
    return int3(x, y, 0);
}
float4x4 final_mvp(vs_in inp) {
    float4 _0 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 0));
    float4 _1 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 1));
    float4 _2 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 2));
    float4 _3 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 3));
    float4x4 model_matrix = float4x4(_0, _1, _2, _3);
    #ifdef AO_WEB
    model_matrix = transpose(model_matrix);
    #endif
    return mul(mvp, model_matrix);
}
#endif

float4 bc7_correct_alpha(float4 color) {
    // map 254 to 255. this is because bc7 is lossy in the alpha channel and an opaque pixel often outputs as 254 alpha.
    if (color.a > 0.995f && color.a <= 1.0f) color.a = 1.0f;
    return color;
}

struct vs_out {
    float4 color: COLOR0;
    float2 uv: UV;
    float2 local_pos: TEXCOORD1;
    float2 shadow_uv: TEXCOORD0;
    float4 pos: SV_Position;
};

vs_out vs_main(vs_in inp) {
    vs_out outp;
    outp.pos = mul(final_mvp(inp), float4(inp.pos.xy, 0, 1.0f));
    outp.uv = inp.uv;
    outp.local_pos = inp.pos;
    outp.color = inp.color;
    outp.shadow_uv = (outp.pos.xy + float2(1,1)) / 2;
    return outp;
}



Fragment Shader:
cbuffer user_input: register(b1) {
float mask_in_shadow;
float stud_density;
float stud_size;
float light_strength;
float crevice_strength;
};

Texture2D<float4> albedo: register(t0);
sampler albedo_smp: register(s0);
Texture2D<float4> shadow: register(t1);
sampler shadow_smp: register(s1);
Texture2D<float4> lighting: register(t2);
sampler lighting_smp: register(s2);

#define MATRIX_TEXTURE_PROVIDED

struct vs_in {
    float2 pos: POS;
    float2 uv: UV;
    float2 uv2: UV1;
    float4 color: COLOR;
    int matrix_index: MATRIX_INDEX;
};


cbuffer params: register(b0) {
    float4x4 mvp;
    float4 resolution_time;
    int matrix_image_size;
};
#define FLIP_IF_GL(y) do { } while (0);

Texture2D<float4> matrices: register(t0);
sampler matrices_smp: register(s0);

#ifdef MATRIX_TEXTURE_PROVIDED
int3 create_pixel_coord(int index) {
    int x = index % matrix_image_size;
    int y = index / matrix_image_size;
    return int3(x, y, 0);
}
float4x4 final_mvp(vs_in inp) {
    float4 _0 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 0));
    float4 _1 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 1));
    float4 _2 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 2));
    float4 _3 = matrices.Load(create_pixel_coord(inp.matrix_index.x*4 + 3));
    float4x4 model_matrix = float4x4(_0, _1, _2, _3);
    #ifdef AO_WEB
    model_matrix = transpose(model_matrix);
    #endif
    return mul(mvp, model_matrix);
}
#endif

float4 bc7_correct_alpha(float4 color) {
    // map 254 to 255. this is because bc7 is lossy in the alpha channel and an opaque pixel often outputs as 254 alpha.
    if (color.a > 0.995f && color.a <= 1.0f) color.a = 1.0f;
    return color;
}

float4 ps_main(float4 color: COLOR0, float2 _uv: UV, float2 local_pos: TEXCOORD1, float2 shadow_uv: TEXCOORD0): SV_Target0 {
    float4 base = color * bc7_correct_alpha(albedo.Sample(albedo_smp, _uv));

    float2 cell = frac(local_pos * stud_density) - 0.5;
    float stud_half = stud_size * 0.5;

    // Square stud mask (Chebyshev distance from cell center).
    float cheb = max(abs(cell.x), abs(cell.y));
    float in_stud = 1.0 - smoothstep(stud_half - 0.02, stud_half, cheb);

    // Fake bevel normal; light from top-left (negative x, negative y).
    float2 n = clamp(cell / stud_half, -1.0, 1.0);
    float lit = -0.7071 * (n.x + n.y);

    // Bevel only near the stud edge so the stud top stays flat.
    float edge_mask = smoothstep(stud_half * 0.4, stud_half, cheb);
    float light = in_stud * edge_mask * lit * light_strength;

    // Slight shadow in the gap between studs (set crevice_strength = 0 to leave gaps alone).
    float crevice = (1.0 - in_stud) * crevice_strength;

    // Only apply studs to opaque pixels; leave transparent areas alone.
    float opaque_mask = base.a;
    float3 rgb = base.rgb + (light - crevice) * opaque_mask;
    float4 result = float4(rgb, base.a);

    if (mask_in_shadow != 0.0f) {
        float2 suv = float2(shadow_uv.x, 1 - shadow_uv.y);
        result *= shadow.Sample(shadow_smp, suv).r;
    }

    return result;
}

