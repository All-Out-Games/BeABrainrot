get_brainrot_config :: proc(id: string) -> Brainrot_Config, bool {
    configs := get_brainrot_configs();
    for c: configs {
        if c.id == id return c, true;
    }
    empty: Brainrot_Config;
    return empty, false;
}

spawn_brainrot :: proc(id: string, position: v2) -> LivingEntity {
    configs := get_brainrot_configs();
    for c: configs {
        if c.id != id continue;
        prefab := get_asset(Prefab_Asset, BRAINROT_PREFAB_PATH);
        if prefab == null {
            log_info("spawn_brainrot: prefab not found at '%'.", {BRAINROT_PREFAB_PATH});
            return null;
        }
        e := Scene.instantiate(prefab, position);
        if e == null {
            log_info("spawn_brainrot: Scene.instantiate returned null.");
            return null;
        }
        le := e.get_component(LivingEntity);
        if le == null {
            log_info("spawn_brainrot: prefab root has no LivingEntity component.");
            return null;
        }
        apply_config_to_living_entity(le, c);
        return le;
    }
    log_info("spawn_brainrot: no Brainrot_Config with id '%'.", {id});
    return null;
}
