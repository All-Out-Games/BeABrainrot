// Add a new brainrot: append one line to get_brainrot_configs.
// Find sprite textures with asset_remote_search, then paste the asset path
// (no leading /res) as the last arg.

Brainrot_Config :: struct {
    id: string;
    display_name: string;
    rarity: Rarity;
    base_price: f64;
    base_gps: f64;
    // The 2D image for this brainrot: the world sprite texture for sprite
    // brainrots, and the inventory/index/icon everywhere. For a spine brainrot
    // the world render comes from spine_path (which hides the sprite), but
    // sprite_path is still its flat icon.
    sprite_path: string;
    // Optional Spine_Animator rig. When set it takes precedence for the WORLD
    // render and hides the sprite; sprite_path is still used as the flat icon.
    spine_path: string;
    // Optional SFX played (local-only, to the picking player) when this brainrot
    // is picked up. Empty = silent. Asset must live in this project's res.
    sound_path: string;
    // Sparks-only brainrots are never added to any room's spawnable_brainrot_ids.
    is_premium: bool;
}

add_brainrot :: proc(list: ref [..]Brainrot_Config, id: string, name: string, rarity: Rarity, price: float, gps: float, sprite: string, sound: string = "") {
    c: Brainrot_Config;
    c.id = id;
    c.display_name = name;
    c.rarity = rarity;
    c.base_price = price;
    c.base_gps = gps;
    c.sprite_path = sprite;
    c.sound_path = sound;
    append(ref list, c);
}

// Premium brainrots are sold only for sparks and never appear in any room's
// spawnable_brainrot_ids. They render via a Spine_Animator; the shape-aware
// mutation materials (rainbow_spine / color_shimmer_spine) make modifiers map
// to the rig instead of smearing across the atlas.
add_premium_spine_brainrot :: proc(list: ref [..]Brainrot_Config, id: string, name: string, rarity: Rarity, price: float, gps: float, spine: string, icon: string, sound: string = "") {
    c: Brainrot_Config;
    c.id = id;
    c.display_name = name;
    c.rarity = rarity;
    c.base_price = price;
    c.base_gps = gps;
    c.spine_path = spine;
    c.sprite_path = icon; // sprite_path doubles as the flat icon (world render uses the spine)
    c.sound_path = sound;
    c.is_premium = true;
    append(ref list, c);
}

