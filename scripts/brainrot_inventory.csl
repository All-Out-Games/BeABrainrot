Brainrot_Item_Definition :: class : Item_Definition {
    config_id: string;
    base_price: float;
    base_gps: float;
    rarity: Rarity;
}

Brainrot_Item :: class : Item_Instance {
    level: s64 @ao_serialize;
    mutation: Mutation @ao_serialize;
}

ALL_BRAINROT_DEFINITIONS: [..]Brainrot_Item_Definition;

register_brainrot_definitions :: proc() {
    configs := get_brainrot_configs();
    for c: configs {
        icon: Texture_Asset;
        if c.sprite_path.count > 0 {
            icon = get_asset(Texture_Asset, c.sprite_path);
        }
        defn := Items.register_item_definition(
            {c.id, c.display_name, icon, 1, .COMMON},
            Brainrot_Item_Definition,
            instance_type = Brainrot_Item
        );
        defn.config_id = c.id;
        defn.base_price = c.base_price;
        defn.base_gps = c.base_gps;
        defn.rarity = c.rarity;
        append(ref ALL_BRAINROT_DEFINITIONS, defn);
    }
}

find_brainrot_definition :: proc(config_id: string) -> Brainrot_Item_Definition {
    for d: ALL_BRAINROT_DEFINITIONS {
        if d.config_id == config_id return d;
    }
    return null;
}

add_brainrot_to_inventory :: proc(player: Player, brainrot: LivingEntity, prefer_front: bool = false) -> bool {
    if brainrot == null return false;

    // Cash out any pending gold on the pedestal before storing the item.
    if brainrot.pedestal != null {
        if brainrot.pedestal.accumulated_gold > 0 {
            collect_pedestal_gold(player, brainrot.pedestal.accumulated_gold);
            brainrot.pedestal.accumulated_gold = 0;
        }
        brainrot.pedestal.placed_brainrot = null;
        brainrot.pedestal.gps_tick_timer = 0;
        brainrot.pedestal = null;
    }

    defn := find_brainrot_definition(brainrot.config_id);
    if defn == null {
        show_notification(player, "No item definition for %", {brainrot.config_id});
        return false;
    }

    item := Items.create_item_instance(defn, Brainrot_Item, 1);
    item.level = brainrot.level;
    item.mutation = brainrot.mutation;

    will_destroy: bool;
    if !Items.can_move_item_to_inventory(item, player.default_inventory, ref will_destroy) {
        Items.destroy_item_instance(item);
        show_notification(player, "Inventory full!");
        return false;
    }
    Items.move_item_to_inventory(item, player.default_inventory);

    // Steal path: pull the freshly-stored item to slot 0 so it lands at the
    // front of the hotbar. swap_items moves whatever was in slot 0 to the
    // item's just-assigned slot.
    if prefer_front && item.slot_index != 0 {
        Items.swap_items(player.default_inventory, player.default_inventory, item.slot_index, 0);
    }
    // Also select slot 0 so the stolen brainrot is the one in hand.
    if prefer_front player.select_slot_0_request = true;

    // Record it in the collection index.
    mark_brainrot_discovered(player, brainrot.config_id, brainrot.mutation);

    brainrot.entity.destroy();

    room := player.my_room;
    if room != null save_room_brainrots(player, room);
    return true;
}

// True if every slot in the player's default inventory has a live item.
is_default_inventory_full :: proc(player: Player) -> bool {
    if player == null return true;
    inv := player.default_inventory;
    if inv == null return false;
    if inv.capacity <= 0 return true;
    for i: 0..inv.capacity - 1 {
        item := inv.get_item(i);
        if !#alive(item) return false;
    }
    return true;
}

draw_selected_brainrot_above_player :: proc(player: Player) {
    if player == null return;
    if !#alive(player.entity) return;
    if is_carrying(player) return; // carry effect already shows the world entity (and drives carryingMoving)

    // Above the npc_line you're in the steal zone — the inventory carry preview
    // is hidden and the carry pose shouldn't apply either (the carry EFFECT,
    // handled above via is_carrying, still drives the pose while stealing).
    above_line := false;
    gm := get_game_manager();
    if gm != null && gm.npc_line != null && #alive(gm.npc_line) {
        above_line = player.entity.world_position.y > gm.npc_line.world_position.y;
    }

    // Holding a brainrot from the inventory in-hand → carry pose, same as the
    // carry effect. Set every frame so it clears when nothing is selected.
    holding_from_inventory := #alive(player.selected_brainrot_item) && !above_line;
    if player.animator != null && player.animator.state_machine != null {
        player.animator.state_machine.set_bool("carryingMoving", holding_from_inventory);
    }

    if !holding_from_inventory return;

    defn := player.selected_brainrot_item.get_definition();
    if defn == null return;
    icon := defn.get_icon();
    if icon == null return;

    UI.push_world_draw_context();
    defer UI.pop_draw_context();
    UI.begin_world_space_ui(player.entity);
    defer UI.end_world_space_ui();

    ppu := icon.get_pixels_per_unit();
    if ppu <= 0 ppu = SPRITE_PPU;
    half_w := icon.get_width().(float)  / ppu * 0.5;
    half_h := icon.get_height().(float) / ppu * 0.5;

    pos := player.entity.world_position + v2{0, CARRY_Y_OFFSET};
    if player.animator != null {
        local_bone := player.animator.get_bone_local_position("held_item");
        if local_bone.x != 0 || local_bone.y != 0 {
            pos = player.entity.world_position + local_bone;
        }
    }

    UI.push_z(pos.y);
    defer UI.pop_z();
    UI.push_layer(player.current_floor.(s32));
    defer UI.pop_layer();
    // Honor the icon's pivot ([-1..1]; (0,-1) = bottom-anchored, matches the C# carry layout).
    pivot := icon.get_pivot();
    top    := (1.0 - pivot.y) * half_h;
    bottom := (1.0 + pivot.y) * half_h;
    right  := (1.0 - pivot.x) * half_w;
    left   := (1.0 + pivot.x) * half_w;
    rect := Rect{pos, pos}.grow(top, right, bottom, left);

    // Push the mutation material so a gold/diamond/rainbow brainrot held from
    // the inventory shows its modifier shader, like the carry effects do.
    mat := get_mutation_material(player.selected_brainrot_item.mutation);
    if mat != null {
        UI.push_material(mat);
        UI.quad(rect, icon);
        UI.pop_material();
    } else {
        UI.quad(rect, icon);
    }
}

place_brainrot_from_item :: proc(pedestal: Pedestal, player: Player, item: Brainrot_Item) -> bool {
    if pedestal == null {
        log_info("place_brainrot_from_item: pedestal null");
        return false;
    }
    if player == null {
        log_info("place_brainrot_from_item: player null");
        return false;
    }
    if item == null {
        log_info("place_brainrot_from_item: item null");
        return false;
    }
    if pedestal.placed_brainrot != null && #alive(pedestal.placed_brainrot.entity) {
        log_info("place_brainrot_from_item: slot already filled");
        return false;
    }

    defn := item.get_definition();
    if defn == null {
        log_info("place_brainrot_from_item: defn null");
        return false;
    }
    if defn.#type != Brainrot_Item_Definition {
        log_info("place_brainrot_from_item: defn is not Brainrot_Item_Definition (type=%)", {defn.#type});
        return false;
    }
    brainrot_defn := defn.(Brainrot_Item_Definition);

    saved_level    := item.level;
    saved_mutation := item.mutation;
    target_id      := brainrot_defn.config_id;

    log_info("place_brainrot_from_item: id=% level=% mutation=%", {target_id, saved_level, saved_mutation});

    configs := get_brainrot_configs();
    for c: configs {
        if c.id != target_id continue;
        le := spawn_brainrot_on_pedestal(pedestal, c);
        if le == null {
            log_info("place_brainrot_from_item: spawn returned null");
            return false;
        }
        if saved_level > 0 le.level = saved_level;
        le.mutation = saved_mutation;
        le.owner = player;
        le.state = Brainrot_State.CLAIMED_IN_BASE;
        le.update_visuals();
        Items.destroy_item_instance(item);
        log_info("place_brainrot_from_item: placed % at level %", {c.display_name, le.level});
        tutorial_advance(player, TUT_BASE_BUTTON); // placed a brainrot on a pedestal
        return true;
    }
    log_info("place_brainrot_from_item: no config matched id '%'", {target_id});
    return false;
}

// ===== Sell helpers =====

get_brainrot_item_gps :: proc(item: Brainrot_Item) -> float {
    if item == null return 0;
    if !#alive(item) return 0;
    defn := item.get_definition();
    if defn == null return 0;
    if defn.#type != Brainrot_Item_Definition return 0;
    br_defn := defn.(Brainrot_Item_Definition);
    lvl := item.level;
    if lvl < 1 lvl = 1;
    e := (lvl - 1).(float);
    g := br_defn.base_gps * pow(GPS_PER_LEVEL_MULT, e);
    g *= get_mutation_gps_multiplier(item.mutation);
    return g;
}

get_brainrot_item_sell_price :: proc(item: Brainrot_Item) -> float {
    return get_brainrot_item_gps(item) * 10.0;
}

sell_brainrot_item :: proc(player: Player, item: Brainrot_Item) {
    if player == null return;
    if item == null return;
    if !#alive(item) return;
    price := get_brainrot_item_sell_price(item);
    deposit_cash(player, price);
    Items.destroy_item_instance(item);
}

sell_all_brainrots :: proc(player: Player) {
    if player == null return;
    inv := player.default_inventory;
    if inv == null return;
    total: float = 0;
    for i: 0..inv.capacity - 1 {
        item := inv.get_item(i);
        if item == null continue;
        if !#alive(item) continue;
        if item.#type != Brainrot_Item continue;
        br := item.(Brainrot_Item);
        total += get_brainrot_item_sell_price(br);
        Items.destroy_item_instance(br);
    }
    if total > 0 deposit_cash(player, total);
}

// Sweep pending gold off every unlocked base pedestal and deposit the total in
// one go (single cash popup) + jump the brainrots. Shared by the PRIME
// auto-collect tick. Returns the total collected.
collect_all_pedestal_gold :: proc(player: Player) -> float {
    if player == null return 0;
    room := player.my_room;
    if room == null return 0;
    total: float = 0;
    for i: 0..room.pedestals.count - 1 {
        if i >= player.pedestals_unlocked break;
        p := room.pedestals[i];
        if p == null continue;
        if p.accumulated_gold <= 0 continue;
        total += p.accumulated_gold;
        p.accumulated_gold = 0;
        p.gps_tick_timer = 0;
        if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) {
            p.placed_brainrot.start_jump();
        }
    }
    if total > 0 collect_pedestal_gold(player, total);
    return total;
}

// ===== Auto-equip best =====
//
// Walks every pedestal in the player's room and, if the player owns a
// higher-GPS brainrot in inventory, swaps it onto the pedestal (sending
// the displaced brainrot back into inventory). Cashes out all pedestal
// gold first so swapping doesn't drop pending earnings.

EQUIP_BEST_COOLDOWN :: 10.0;

auto_equip_best :: proc(player: Player) {
    if player == null return;

    now := get_time();
    if now < player.equip_best_next_at {
        remaining := player.equip_best_next_at - now;
        show_notification(player, "Equip Best on cooldown (%s)", {format_float(remaining, decimals=1)});
        return;
    }

    room := player.my_room;
    if room == null {
        show_notification(player, "No base claimed.");
        return;
    }
    inv := player.default_inventory;
    if inv == null return;

    player.equip_best_next_at = now + EQUIP_BEST_COOLDOWN;

    // Phase 1: collect any pending gold from every unlocked pedestal.
    cashed_out: float = 0;
    for i: 0..room.pedestals.count - 1 {
        if i >= player.pedestals_unlocked break;
        p := room.pedestals[i];
        if p == null continue;
        if p.accumulated_gold > 0 {
            cashed_out += p.accumulated_gold;
            collect_pedestal_gold(player, p.accumulated_gold);
            p.accumulated_gold = 0;
            p.gps_tick_timer = 0;
            if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) {
                p.placed_brainrot.start_jump();
            }
        }
    }
    if cashed_out > 0 {
        collect_sfx := get_asset(SFX_Asset, "SFX/Collect_Money.wav");
        if collect_sfx != null {
            desc := SFX.default_sfx_desc();
            desc.entity_to_follow = player.entity.id;
            desc.volume = 0.6;
            desc.speed_perturb = 0.08;
            SFX.play(collect_sfx, desc);
        }
    }

    // Phase 2: greedy swap — for each unlocked pedestal, if the best inventory
    // brainrot beats what's placed (or the pedestal is empty), swap.
    swaps: s64 = 0;
    for pi: 0..room.pedestals.count - 1 {
        if pi >= player.pedestals_unlocked break;
        p := room.pedestals[pi];
        if p == null continue;

        cur_gps: float = -1.0;
        if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) {
            cur_gps = p.placed_brainrot.get_gps();
        }

        best_idx: s64 = -1;
        best_gps: float = cur_gps;
        for i: 0..inv.capacity - 1 {
            it := inv.get_item(i);
            if it == null continue;
            if !#alive(it) continue;
            if it.#type != Brainrot_Item continue;
            br := it.(Brainrot_Item);
            g := get_brainrot_item_gps(br);
            if g > best_gps {
                best_gps = g;
                best_idx = i;
            }
        }

        if best_idx < 0 continue;

        // Move current placed back to inventory before placing the new one.
        // Net inventory size doesn't change (–1 from place_from_item, +1 from this).
        if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) {
            ok := add_brainrot_to_inventory(player, p.placed_brainrot);
            if !ok continue; // inventory full — give up on this pedestal
        }

        item := inv.get_item(best_idx);
        if item == null continue;
        if !#alive(item) continue;
        if item.#type != Brainrot_Item continue;
        br_item := item.(Brainrot_Item);

        if !place_brainrot_from_item(p, player, br_item) continue;
        swaps += 1;
    }

    // Phase 3: reorder the placed brainrots so the highest GPS sits on the
    // first pedestals (selection sort by current GPS, empties sink to the end).
    // Gold was cashed out in phase 1, so swapping stands only moves brainrots.
    reordered := false;
    n := room.pedestals.count;
    if player.pedestals_unlocked < n n = player.pedestals_unlocked;
    for i: 0..n - 1 {
        best_j := i;
        best_g := pedestal_gps(room.pedestals[i]);
        for j: i + 1..n - 1 {
            g := pedestal_gps(room.pedestals[j]);
            if g > best_g {
                best_g = g;
                best_j = j;
            }
        }
        if best_j != i {
            swap_placed_brainrots(room.pedestals[i], room.pedestals[best_j]);
            reordered = true;
        }
    }

    if swaps > 0 || reordered {
        save_room_brainrots(player, room);
        show_notification(player, "Equipped best (% swap%0)", {swaps, ""});
    } else if cashed_out > 0 {
        show_notification(player, "Collected %", {format_cash(cashed_out)});
    } else {
        show_notification(player, "Already at best!");
    }
}

equip_best_cmd :: proc(player: Player) {
    auto_equip_best(player);
} @chat_command

// ===== Navigation topbar =====

// Shader materials for the topbar buttons — same box_panel.aosl look as the
// rebirth / shop UIs. One material per button so each gets its own rect_px.
NAV_MAT_BUY:    Material;
NAV_MAT_BASE:   Material;
NAV_MAT_SELL:   Material;
NAV_MATS_READY: bool;

nav_ensure_materials :: proc() -> bool {
    if NAV_MATS_READY return true;

    // Dots take their color from band_color and are drawn at dot_alpha. The
    // presets often use a band hue close to the body (so dots vanish, e.g. red),
    // so give each a darker contrasting dot color and crank the intensity.
    green_box := shop2_box_green();
    green_box.band_color = v4{0.10, 0.26, 0.03, 1};
    green_box.dot_alpha  = 0.80;
    green_box.dot_min_radius = 0.05;
    green_box.dot_max_radius = 0.24;

    // Blue "Base" preset (no shop2 blue exists) — cool azure body, navy band.
    blue_box := shop2_box_dark();
    blue_box.top        = v4{0.26, 0.55, 0.98, 1};
    blue_box.bottom     = v4{0.12, 0.32, 0.78, 1};
    blue_box.band_color = v4{0.04, 0.10, 0.32, 1};
    blue_box.dot_alpha  = 0.80;
    blue_box.dot_min_radius = 0.05;
    blue_box.dot_max_radius = 0.24;

    red_box := shop2_box_red();
    red_box.band_color = v4{0.42, 0.03, 0.03, 1};
    red_box.dot_alpha  = 0.80;
    red_box.dot_min_radius = 0.05;
    red_box.dot_max_radius = 0.24;

    NAV_MAT_BUY  = rebirth_make_box_material(green_box);
    NAV_MAT_BASE = rebirth_make_box_material(blue_box);
    NAV_MAT_SELL = rebirth_make_box_material(red_box);
    if NAV_MAT_BUY == null return false; // shader still loading

    NAV_MATS_READY = true;
    return true;
}

NAV_BTN_W :: 240.0;
NAV_BTN_H :: 96.0;

// Box_panel shader button sized for the topbar, with press darkening fed from
// active_t_eased (mirrors rebirth_shader_button).
nav_shader_button :: proc(id: string, label: string, mat: Material) -> Interact_Result {
    btn := UIK.layout_row();
    btn.width                       = UIK.pixels(NAV_BTN_W);
    btn.height                      = UIK.pixels(NAV_BTN_H);
    btn.main_align                  = .CENTER;
    btn.cross_align                 = .CENTER;
    btn.show_background              = true;
    btn.tint                        = v4{1, 1, 1, 1};
    btn.background_sprite_override   = core_globals.white_sprite;
    btn.background_material_override = mat;
    h := UIK.panel_begin_interactive(id, btn);
    if mat != null {
        mat.set_float4("rect_px", v4{h.rect.min.x, h.rect.min.y, h.rect.max.x, h.rect.max.y});
        mat.set_float("press", h.active_t_eased);
    }
    bd := UIK.text_button();
    bd.set_size_mult(1.2);
    UIK.text(label, bd);
    UIK.panel_end();
    return h;
}

draw_navigation_topbar :: proc(player: Player) {
    if player == null return;
    if !#alive(player.entity) return;
    if !nav_ensure_materials() return;

    UIK.begin(UIK.window(UIK.rect_topbar()));

    bar := UIK.layout_row();
    bar.width = UIK.flex(1);
    bar.height = UIK.flex(1);
    bar.padding = v4{8, 16, 8, 16};
    bar.gap = 56;
    bar.main_align = .CENTER;
    bar.cross_align = .CENTER;
    UIK.panel_begin(bar);

    buy_h  := nav_shader_button("nav_buy",  "Buy",  NAV_MAT_BUY);
    base_h := nav_shader_button("nav_base", "Base", NAV_MAT_BASE);
    sell_h := nav_shader_button("nav_sell", "Sell", NAV_MAT_SELL);

    UIK.panel_end();
    UIK.end();

    // Stash the Base/Buy button rects for the tutorial arrow (this frame).
    player.nav_base_rect       = base_h.rect;
    player.nav_base_rect_frame = get_frame_number();
    player.nav_buy_rect        = buy_h.rect;
    player.nav_buy_rect_frame  = get_frame_number();

    if UIK.clicked(buy_h) {
        player.teleport({-17.24, 3.850});
        tutorial_advance(player, TUT_SPEED_BUTTON); // headed to the shop
    }
    if UIK.clicked(base_h) {
        room := player.my_room;
        if room != null && #alive(room.entity) {
            player.teleport(room.entity.world_position);
            player.current_floor = 0;
        }
    }
    if UIK.clicked(sell_h) {
        player.show_sell_modal = !player.show_sell_modal;
    }
}

// ===== Sell modal =====

SELL_COLS_PER_ROW :: 3;
SELL_CARD_HEIGHT  :: 260.0;

// box_panel shader materials for the sell modal — red shell + gold "Sell All"
// button (fixed), plus a growable pool of card materials (one per visible card,
// since UIK batches its draws at end() and a shared material would race rect_px).
SELL_MAT_SHELL:      Material;
SELL_MAT_ALL:        Material;
SELL_MAT_CANCEL:     Material;
SELL_MAT_CONFIRM_BG: Material;
SELL_CARD_MATS:      [..]Material;
SELL_BTN_MATS:       [..]Material;
SELL_MATS_READY:     bool;

sell_btn_box :: proc() -> Shop2_Box {
    // Green "money" button so it pops against the red shell instead of
    // blending in like a red-on-red button would.
    b := shop2_box_green();
    b.band_color    = v4{0.10, 0.26, 0.03, 1};
    b.band_h        = 8.0;
    b.corner_radius = 12.0;
    b.outline_px    = 4.0;
    b.dot_alpha     = 0.0;
    return b;
}

// Per-card sell button material pool (one per visible card, same rect_px
// reasoning as the card pool).
sell_button_material :: proc(idx: s64) -> Material {
    while SELL_BTN_MATS.count <= idx {
        append(ref SELL_BTN_MATS, rebirth_make_box_material(sell_btn_box()));
    }
    return SELL_BTN_MATS[idx];
}

// Box_panel shader sell button (110x56) with press darkening.
sell_shader_button :: proc(id: string, label: string, mat: Material) -> Interact_Result {
    btn := UIK.layout_row();
    btn.width                       = UIK.pixels(110);
    btn.height                      = UIK.pixels(56);
    btn.main_align                  = .CENTER;
    btn.cross_align                 = .CENTER;
    btn.show_background              = true;
    btn.tint                        = v4{1, 1, 1, 1};
    btn.background_sprite_override   = core_globals.white_sprite;
    btn.background_material_override = mat;
    h := UIK.panel_begin_interactive(id, btn);
    if mat != null {
        mat.set_float4("rect_px", v4{h.rect.min.x, h.rect.min.y, h.rect.max.x, h.rect.max.y});
        mat.set_float("press", h.active_t_eased);
    }
    bd := UIK.text_button();
    bd.set_size_mult(1.2);
    UIK.text(label, bd);
    UIK.panel_end();
    return h;
}

sell_card_box :: proc() -> Shop2_Box {
    b := shop2_box_dark();
    b.top           = v4{0.48, 0.16, 0.20, 1};
    b.bottom        = v4{0.28, 0.08, 0.12, 1};
    b.band_color    = v4{0.70, 0.14, 0.16, 1};
    b.band_h        = 12.0;
    b.corner_radius = 14.0;
    b.outline_px    = 4.0;
    b.dot_alpha     = 0.10;
    b.dot_min_radius = 0.05;
    b.dot_max_radius = 0.24;
    return b;
}

sell_ensure_materials :: proc() -> bool {
    if SELL_MATS_READY return true;

    shell_box := shop2_box_red();
    shell_box.top           = v4{0.62, 0.13, 0.15, 1};
    shell_box.bottom        = v4{0.32, 0.05, 0.07, 1};
    shell_box.band_h        = 0.0;
    shell_box.corner_radius = 22.0;
    shell_box.outline_px    = 4.0;
    shell_box.dot_alpha     = 0.10;
    shell_box.dot_min_radius = 0.05;
    shell_box.dot_max_radius = 0.22;

    // Confirm dialog background — deep indigo so the gold confirm + red cancel
    // buttons pop against it (instead of red-on-red with the sell shell).
    confirm_box := shop2_box_dark();
    confirm_box.top           = v4{0.16, 0.14, 0.28, 1};
    confirm_box.bottom        = v4{0.07, 0.06, 0.14, 1};
    confirm_box.band_h        = 0.0;
    confirm_box.corner_radius = 22.0;
    confirm_box.outline_px    = 4.0;
    confirm_box.dot_alpha     = 0.08;
    confirm_box.dot_min_radius = 0.05;
    confirm_box.dot_max_radius = 0.22;

    SELL_MAT_SHELL      = rebirth_make_box_material(shell_box);
    SELL_MAT_ALL        = rebirth_make_box_material(shop2_box_gold());
    SELL_MAT_CANCEL     = rebirth_make_box_material(shop2_box_red());
    SELL_MAT_CONFIRM_BG = rebirth_make_box_material(confirm_box);
    if SELL_MAT_SHELL == null return false; // shader still loading

    // Gold "Sell All" gets the diagonal shine sweep so it stands out.
    SELL_MAT_ALL.set_float("shine_strength", 1.0);
    SELL_MAT_ALL.set_float("shine_speed",    1.2);

    SELL_MATS_READY = true;
    return true;
}

// Lazily grow the per-card material pool so each visible card has a unique
// material (and therefore a unique rect_px) when UIK flushes at end().
sell_card_material :: proc(idx: s64) -> Material {
    while SELL_CARD_MATS.count <= idx {
        append(ref SELL_CARD_MATS, rebirth_make_box_material(sell_card_box()));
    }
    return SELL_CARD_MATS[idx];
}

draw_sell_modal :: proc(player: Player) {
    if player == null return;
    if !player.show_sell_modal return;
    if !sell_ensure_materials() return; // shaders still loading
    inv := player.default_inventory;
    if inv == null return;

    sell_indices: [..]s64;
    total_value: float = 0;
    for i: 0..inv.capacity - 1 {
        item := inv.get_item(i);
        if item == null continue;
        if !#alive(item) continue;
        if item.#type != Brainrot_Item continue;
        br := item.(Brainrot_Item);
        append(ref sell_indices, i);
        total_value += get_brainrot_item_sell_price(br);
    }

    UIK.begin(UIK.modal(UIK.rect_window(), 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap                        = 0;
    shell.show_background              = true;
    shell.tint                       = v4{1, 1, 1, 1};
    shell.background_sprite_override   = core_globals.white_sprite;
    shell.background_material_override = SELL_MAT_SHELL;
    shell_h := UIK.panel_begin_interactive("sell_shell", shell);
    SELL_MAT_SHELL.set_float4("rect_px", v4{shell_h.rect.min.x, shell_h.rect.min.y, shell_h.rect.max.x, shell_h.rect.max.y});

    title_d := UIK.title_area_desc("SELL BRAINROTS");
    exit_h := UIK.title_area(title_d);

    body := UIK.layout_column();
    body.width = UIK.flex(1);
    body.height = UIK.flex(1);
    body.padding = v4{12, 16, 12, 16};
    body.gap = 8;
    UIK.panel_begin(body);

    sell_handles: [..]Interact_Result;
    sell_handle_indices: [..]s64;

    list_panel := UIK.layout_column();
    list_panel.width  = UIK.flex(1);
    list_panel.height = UIK.flex(1);
    list_panel.gap = 8;
    UIK.list_begin("sell_scroll", list_panel);

    n := sell_indices.count;
    i: s64 = 0;
    while i < n {
        row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
        UIK.panel_begin(row);

        c: s64 = 0;
        while c < SELL_COLS_PER_ROW {
            if i >= n {
                UIK.spacer(UIK.flex(1), UIK.pixels(1));
                c += 1;
                continue;
            }

            slot_idx := sell_indices[i];
            item := inv.get_item(slot_idx);
            if item == null || !#alive(item) || item.#type != Brainrot_Item {
                i += 1;
                continue;
            }
            br := item.(Brainrot_Item);
            defn := br.get_definition();
            if defn == null {
                i += 1;
                continue;
            }

            card_mat := sell_card_material(i);
            card := UIK.layout_column();
            card.width                       = UIK.flex(1);
            card.height                      = UIK.pixels(SELL_CARD_HEIGHT);
            card.gap                         = 4;
            card.padding                     = v4{10, 10, 10, 10};
            card.cross_align                 = .CENTER;
            card.show_background              = true;
            card.tint                        = v4{1, 1, 1, 1};
            card.background_sprite_override   = core_globals.white_sprite;
            card.background_material_override = card_mat;
            card_h := UIK.panel_begin_interactive(format_string("sell_card_%", {slot_idx}), card);
            if card_mat != null {
                card_mat.set_float4("rect_px", v4{card_h.rect.min.x, card_h.rect.min.y, card_h.rect.max.x, card_h.rect.max.y});
            }

            name_desc := UIK.text_button();
            UIK.text_set_word_wrap(&name_desc, false);
            UIK.text(defn.name, name_desc);

            icon := defn.get_icon();
            media := UIK.layout_centered(UIK.flex(1), UIK.flex(1));
            UIK.panel_begin(media);
            if icon != null UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
            UIK.panel_end();

            foot_row := UIK.layout_row();
            foot_row.width  = UIK.flex(1);
            foot_row.height = UIK.pixels(56);
            foot_row.cross_align = .CENTER;
            foot_row.gap = 6;
            UIK.panel_begin(foot_row);

            btn_mat := sell_button_material(i);
            h := sell_shader_button(format_string("sell_one_%", {slot_idx}), "$", btn_mat);
            append(ref sell_handles, h);
            append(ref sell_handle_indices, slot_idx);

            UIK.spacer(UIK.flex(1), UIK.pixels(1));

            info := UIK.layout_column();
            info.width  = UIK.fit();
            info.height = UIK.fit();
            info.cross_align = .END;
            info.gap = 2;
            UIK.panel_begin(info);

            mut_label := get_mutation_name(br.mutation);
            if mut_label.count == 0 mut_label = "Normal";
            mut_text := UIK.text_body();
            mut_text.color = get_mutation_color(br.mutation);
            mut_text.set_outline(true, 2.5, v4{0, 0, 0, 1});
            UIK.text_set_word_wrap(&mut_text, false);
            UIK.text(mut_label, mut_text);

            price_desc := UIK.text_body();
            price_desc.color = v4{0.55, 1.0, 0.45, 1};
            price_desc.set_outline(true, 2.5, v4{0, 0, 0, 1});
            UIK.text_set_word_wrap(&price_desc, false);
            UIK.text(format_cash(get_brainrot_item_sell_price(br)), price_desc);

            UIK.panel_end(); // info
            UIK.panel_end(); // foot_row

            UIK.panel_end(); // card
            i += 1;
            c += 1;
        }

        UIK.panel_end(); // row
    }

    UIK.list_end();

    footer := UIK.layout_row();
    footer.width = UIK.flex(1);
    footer.height = UIK.pixels(80);
    footer.cross_align = .CENTER;
    footer.gap = 16;
    UIK.panel_begin(footer);

    sell_all_h := rebirth_shader_button("sell_all_brainrots", "Sell All", SELL_MAT_ALL, sell_indices.count == 0);

    UIK.spacer(UIK.flex(1), UIK.pixels(1));

    summary := format_string("Total Brainrots: %\nTotal Value: %", {sell_indices.count, format_cash(total_value)});
    summary_desc := UIK.text_body();
    summary_desc.color = v4{1, 1, 1, 1};
    summary_desc.set_outline(true, 2.5, v4{0, 0, 0, 1});
    UIK.text(summary, summary_desc);

    UIK.panel_end(); // footer
    UIK.panel_end(); // body
    UIK.panel_end(); // shell
    UIK.end();

    if UIK.clicked(exit_h) {
        player.show_sell_modal = false;
        return;
    }
    if UIK.clicked(sell_all_h) {
        // Confirm first — selling everything is easy to misclick.
        player.show_sell_all_confirm = true;
        return;
    }
    for k: 0..sell_handles.count - 1 {
        if UIK.clicked(sell_handles[k]) {
            i := sell_handle_indices[k];
            it := inv.get_item(i);
            if it == null continue;
            if !#alive(it) continue;
            if it.#type != Brainrot_Item continue;
            sell_brainrot_item(player, it.(Brainrot_Item));
            return;
        }
    }

    draw_sell_all_confirm(player, sell_indices.count, total_value);
}

// Confirmation prompt shown before selling the entire inventory.
draw_sell_all_confirm :: proc(player: Player, count: s64, total_value: float) {
    if !player.show_sell_all_confirm return;

    UIK.begin(UIK.modal(UIK.rect_window_small(), 25));

    shell := UIK.panel_modal(.BLACK);
    shell.gap                        = 0;
    shell.show_background              = true;
    shell.tint                       = v4{1, 1, 1, 1};
    shell.background_sprite_override   = core_globals.white_sprite;
    shell.background_material_override = SELL_MAT_CONFIRM_BG;
    shell_h := UIK.panel_begin_interactive("sell_all_confirm_shell", shell);
    SELL_MAT_CONFIRM_BG.set_float4("rect_px", v4{shell_h.rect.min.x, shell_h.rect.min.y, shell_h.rect.max.x, shell_h.rect.max.y});

    exit_h := UIK.title_area(UIK.title_area_desc("SELL ALL?"));

    body := UIK.layout_column();
    body.width  = UIK.flex(1);
    body.height = UIK.flex(1);
    body.padding = v4{18, 20, 18, 20};
    body.gap = 12;
    body.cross_align = .CENTER;
    UIK.panel_begin(body);

    UIK.spacer(UIK.pixels(1), UIK.flex(1));

    prompt := UIK.text_body();
    prompt.set_color({1, 1, 1, 1});
    prompt.set_outline(true, 2.5, v4{0, 0, 0, 1});
    UIK.text(format_string("Sell all % brainrots for %?", {count, format_cash(total_value)}), prompt);

    UIK.spacer(UIK.pixels(1), UIK.flex(1));

    btn_row := UIK.layout_row();
    btn_row.width  = UIK.flex(1);
    btn_row.height = UIK.pixels(72);
    btn_row.gap = 20;
    btn_row.main_align = .CENTER;
    UIK.panel_begin(btn_row);

    cancel_h  := rebirth_shader_button("sell_all_cancel",  "Cancel",   SELL_MAT_CANCEL);
    confirm_h := rebirth_shader_button("sell_all_confirm", "Sell All", SELL_MAT_ALL);

    UIK.panel_end(); // btn_row
    UIK.panel_end(); // body
    UIK.panel_end(); // shell
    UIK.end();

    if UIK.clicked(exit_h) || UIK.clicked(cancel_h) {
        player.show_sell_all_confirm = false;
        return;
    }
    if UIK.clicked(confirm_h) {
        sell_all_brainrots(player);
        player.show_sell_all_confirm = false;
        return;
    }
}
