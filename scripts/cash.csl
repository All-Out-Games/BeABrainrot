CASH_1K  :: 1000.0;
CASH_1M  :: 1000000.0;
CASH_1B  :: 1000000000.0;
CASH_1T  :: 1000000000000.0;
CASH_1Q  :: 1000000000000000.0;
CASH_1QN :: 1000000000000000000.0;
CASH_1SX :: 1000000000000000000000.0;
CASH_1SP :: 1000000000000000000000000.0;
CASH_1OC :: 1000000000000000000000000000.0;
CASH_1NO :: 1000000000000000000000000000000.0;
CASH_1DC :: 1000000000000000000000000000000000.0;

// Compact "5", "5.2", or "5.25" depending on whether the value has a fractional
// part. Used by format_cash so "2" doesn't print as "2.00".
format_compact :: proc(v: float) -> string {
    i := v.(s64);
    if i.(float) == v return format_string("%", {i});
    return format_string("%", {format_float(v, decimals=1)});
}

// Compact number with a magnitude suffix (K/M/B/...) and NO currency prefix.
// Used by the leaderboard so large GPS values stay readable while small values
// (e.g. the Speed stat) still print plainly. Mirrors format_cash's thresholds.
format_score_suffix :: proc(amount: f64) -> string {
    a := amount.(float);
    if a < CASH_1K  return format_compact(a);
    if a < CASH_1M  return format_string("% K",  {format_compact(a / CASH_1K)});
    if a < CASH_1B  return format_string("% M",  {format_compact(a / CASH_1M)});
    if a < CASH_1T  return format_string("% B",  {format_compact(a / CASH_1B)});
    if a < CASH_1Q  return format_string("% T",  {format_compact(a / CASH_1T)});
    if a < CASH_1QN return format_string("% Q",  {format_compact(a / CASH_1Q)});
    if a < CASH_1SX return format_string("% Qn", {format_compact(a / CASH_1QN)});
    if a < CASH_1SP return format_string("% S",  {format_compact(a / CASH_1SX)});
    if a < CASH_1OC return format_string("% Sp", {format_compact(a / CASH_1SP)});
    if a < CASH_1NO return format_string("% Oc", {format_compact(a / CASH_1OC)});
    if a < CASH_1DC return format_string("% No", {format_compact(a / CASH_1NO)});
    return format_string("% Dc", {format_compact(a / CASH_1DC)});
}

// amount is f64 (cash can exceed f32 precision). The divided value handed to
// format_compact is always < 1000, so narrowing it to f32 for display is lossless.
format_cash :: proc(amount: f64) -> string {
    // A space separates the number from the suffix so e.g. "120.1Oc" doesn't
    // read as "120.10c" (the O running into the digit).
    if amount < CASH_1K  return format_string("$%",    {format_compact(amount.(f32))});
    if amount < CASH_1M  return format_string("$% K",  {format_compact((amount / CASH_1K).(f32))});
    if amount < CASH_1B  return format_string("$% M",  {format_compact((amount / CASH_1M).(f32))});
    if amount < CASH_1T  return format_string("$% B",  {format_compact((amount / CASH_1B).(f32))});
    if amount < CASH_1Q  return format_string("$% T",  {format_compact((amount / CASH_1T).(f32))});
    if amount < CASH_1QN return format_string("$% Q",  {format_compact((amount / CASH_1Q).(f32))});
    if amount < CASH_1SX return format_string("$% Qn", {format_compact((amount / CASH_1QN).(f32))});
    if amount < CASH_1SP return format_string("$% S",  {format_compact((amount / CASH_1SX).(f32))});
    if amount < CASH_1OC return format_string("$% Sp", {format_compact((amount / CASH_1SP).(f32))});
    if amount < CASH_1NO return format_string("$% Oc", {format_compact((amount / CASH_1OC).(f32))});
    if amount < CASH_1DC return format_string("$% No", {format_compact((amount / CASH_1NO).(f32))});
    return format_string("$% Dc", {format_compact((amount / CASH_1DC).(f32))});
}

