// Locks the player in an auto-walk up the Y axis. Used when crossing the NPC
// line — the player is teleported above and then carried further up by this
// effect at their current upgrade speed. Camera zooms out on start and resets
// on end. Infinite duration for now.

// Engine integrates `velocities += inputs * dt * movement_speed` and drains
// velocity via friction (≈ 60/s), so steady-state world-units/sec = speed / 60.
MOVING_TOWARD_FRICTION_DIVISOR :: 60.0;
// Final scale applied to the computed speed. 1.0 = matches normal movement's
// steady-state rate (speed / 60); lower to slow the auto-walk down.
MOVING_TOWARD_SPEED_SCALE      :: 1.0;

Moving_Toward_Effect :: class : Effect_Base {
    saved_default_camera_size: float;

    effect_start :: method() {
        if player == null return;
        player.add_freeze_reason("moving_toward");
        saved_default_camera_size = player.default_camera_size;
        player.camera.size = ZOOMED_OUT_CAMERA_SIZE;
    }

    effect_update :: method(dt: float) {
        if player == null return;
        if !#alive(player.entity) return;

        // Player pressing any direction → use their upgrade speed.
        // No input → fall back to base speed (BASE_SPEED → 300 agent units).
        input := player.input_this_frame;
        stat_speed: s64 = BASE_SPEED;
        if input.x != 0 || input.y != 0 {
            stat_speed = player.speed;
        }
        units_per_sec := compute_agent_movement_speed(stat_speed) / MOVING_TOWARD_FRICTION_DIVISOR * MOVING_TOWARD_SPEED_SCALE;

        pos := player.entity.local_position;
        pos.y += units_per_sec * dt;

        // Hard ceiling: never auto-walk past the last NPC room's bounds Y.
        ceiling, has_ceiling := get_last_npc_room_ceiling_y();
        if has_ceiling && pos.y > ceiling pos.y = ceiling;

        player.entity.set_local_position(pos);
    }

    effect_end :: method(interrupt: bool) {
        if player == null return;
        player.remove_freeze_reason("moving_toward");
        if saved_default_camera_size > 0 {
            player.camera.size = saved_default_camera_size;
        }
    }
}
