// ============================================================================
// Component-based event, authored as an Event_Base subclass with @ao_serialize
// fields you wire in the editor. This is the direct equivalent of a C# EventBase
// subclass: it lives in the scene, carries serialized fields, and overrides the
// lifecycle methods.
//
// Because Event_Base IS a Component, the serialized fields live right on the
// event itself and the overrides read them directly via `this` — no userdata
// bridge needed at the authoring layer (the generic register_event handles the
// type-erasure plumbing under the hood).
//
// Behaviour: enables `target` while the event is active, disables it otherwise.
//
// To use: add Event_Entity_Toggle to any scene entity (via the modify_scene MCP
// tool), set event_id / event_name, and point `target` at the entity to toggle.
// Then start it from the admin panel like any other event.
// ============================================================================

Event_Entity_Toggle :: class : Event_Base {
    event_id:   string @ao_serialize; // unique id, e.g. "boss_portal"
    event_name: string @ao_serialize; // display name for HUD / admin panel
    target:     Entity @ao_serialize; // enabled on event start, disabled on end

    ao_start :: method() {
        // Start hidden; the event turns it on.
        if target != null && #alive(target) target.set_local_enabled(false);
        register_event(this);
    }

    get_event_id :: method() -> string {
        if event_id.count == 0 return "entity_toggle"; // fallback so it still registers
        return event_id;
    }
    get_event_name :: method() -> string { return event_name; }
    get_event_desc :: method() -> string { return "Shows a scene entity while active (component-based event)."; }
    get_admin_extras_height :: method() -> float { return 26; } // reserve a row for custom UI

    on_event_start :: method(mgr: Event_Manager, is_drop_in: bool) {
        if target != null && #alive(target) target.set_local_enabled(true);
    }
    on_event_end :: method(mgr: Event_Manager) {
        if target != null && #alive(target) target.set_local_enabled(false);
    }

    // Custom admin-panel UI (C#'s DrawAdminPanelExtras). Draws the live target
    // name + visibility in the reserved rect.
    draw_admin_extras :: method(mgr: Event_Manager, rect: Rect) {
        label := "target: (none)";
        if target != null && #alive(target) {
            shown := "hidden";
            if target.get_local_enabled() shown = "shown";
            label = format_string("target: % (%)", {target.get_name(), shown});
        }
        UI.text(rect, admin_left_ts(13, v4{0.75, 0.85, 1.0, 1}), label);
    }
}
