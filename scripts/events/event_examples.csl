// ============================================================================
// Example multiplier events, authored as Event_Base subclasses (the readapted
// EventBase-override style). Each overrides the metadata getters + lifecycle
// methods it cares about and self-registers with `register_event(this)` from
// its OWN ao_start (so `this` is the concrete type and the generic captures the
// right overrides). Gameplay reads the value through the event_* accessors in
// event_manager.csl, which return 1.0 while the event is inactive.
//
// Each must be placed on a scene entity to exist (added to GameManager here).
// ============================================================================

// --- 2X Money --------------------------------------------------------------

Event_Double_Money :: class : Event_Base {
    ao_start :: method() { register_event(this); }

    get_event_id   :: method() -> string { return "double_money"; }
    get_event_name :: method() -> string { return "2X Money"; }
    get_event_desc :: method() -> string { return "Multiplies cash earned while active. Drives money_multiplier."; }
    get_config_key :: method() -> string { return "moneymult"; }

    on_event_start :: method(mgr: Event_Manager, is_drop_in: bool) {
        log_info("[Events] 2X Money started (%x)", {mgr.money_multiplier});
    }
    on_event_end :: method(mgr: Event_Manager) {
        log_info("[Events] 2X Money ended");
    }
}

// --- Lucky Spawn -----------------------------------------------------------

Event_Lucky_Spawn :: class : Event_Base {
    ao_start :: method() { register_event(this); }

    get_event_id   :: method() -> string { return "lucky_spawn"; }
    get_event_name :: method() -> string { return "Lucky Spawn"; }
    get_event_desc :: method() -> string { return "Boosts mutation luck on newly bought/spawned brainrots."; }
    get_config_key :: method() -> string { return "luckmult"; }

    on_event_start :: method(mgr: Event_Manager, is_drop_in: bool) {
        log_info("[Events] Lucky Spawn started (luck %x)", {mgr.mutation_luck});
    }
    on_event_end :: method(mgr: Event_Manager) {
        log_info("[Events] Lucky Spawn ended");
    }
}

// --- Speed Frenzy ----------------------------------------------------------

Event_Speed_Frenzy :: class : Event_Base {
    ao_start :: method() { register_event(this); }

    get_event_id   :: method() -> string { return "speed_frenzy"; }
    get_event_name :: method() -> string { return "Speed Frenzy"; }
    get_event_desc :: method() -> string { return "Increases everyone's movement speed while active."; }
    get_config_key :: method() -> string { return "speedmult"; }

    on_event_start :: method(mgr: Event_Manager, is_drop_in: bool) {
        log_info("[Events] Speed Frenzy started (%x)", {mgr.speed_multiplier});
    }
    on_event_end :: method(mgr: Event_Manager) {
        log_info("[Events] Speed Frenzy ended");
    }
}
