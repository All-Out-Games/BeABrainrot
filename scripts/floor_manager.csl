// Single-instance manager that fades all Floor_Renderer components in the scene
// according to the local player's current_floor.
//
// Place one Floor_Manager component anywhere in the scene (e.g. on the root
// or a "FloorManagers" entity). It re-applies visibility every state sync so
// that any server overwrite of color values gets corrected back to per-client
// floor visibility.
//
// Floor_Manager doesn't track Floor_Renderers manually — it walks
// component_iterator(Floor_Renderer) on demand.

Floor_Manager :: class : Component {

    ao_on_state_sync :: method() {
        local, has_local := Game.get_local_player();
        if !has_local return;
        apply_visibility(local);
    }

    ao_late_update :: method(dt: float) {
        // Belt-and-suspenders: re-apply each frame in case any state push
        // resets sprite.color between syncs.
        local, has_local := Game.get_local_player();
        if !has_local return;
        apply_visibility(local);
    }

    apply_visibility :: method(viewer: Player) {
        if viewer == null return;
        viewer_floor := viewer.current_floor;

        cam_pos  := viewer.camera.position;
        cam_size := viewer.camera.size;

        // Camera not ready (size 0) — fall back to the full walk so nothing is
        // left un-applied on the first frames.
        if cam_size <= 0.0 {
            for r: component_iterator(Floor_Renderer) {
                if r == null continue;
                r.apply_for_viewer_floor(viewer_floor);
            }
            apply_other_player_visibility(viewer);
            return;
        }

        // Spatial-grid query: only visit renderers in the cells the camera
        // overlaps, then cull within. Drops a few-hundred-renderer walk to ~the
        // handful actually near the player.
        radius  := cam_size * FLOOR_CULL_RADIUS_MULT;
        cull_sq := radius * radius;
        min_cx  := floor_grid_cell(cam_pos.x - radius);
        max_cx  := floor_grid_cell(cam_pos.x + radius);
        min_cy  := floor_grid_cell(cam_pos.y - radius);
        max_cy  := floor_grid_cell(cam_pos.y + radius);

        for cx: min_cx..max_cx {
            for cy: min_cy..max_cy {
                b := floor_grid_bucket(cx, cy);
                for i: 0..g_floor_grid[b].count - 1 {
                    r := g_floor_grid[b][i];
                    if r == null continue;
                    // Exact-cell filter (buckets can mix cells via hash collisions).
                    if r.grid_cx != cx || r.grid_cy != cy continue;
                    if !#alive(r.entity) continue;
                    if length_squared(r.entity.world_position - cam_pos) > cull_sq continue;
                    r.apply_for_viewer_floor(viewer_floor);
                }
            }
        }
        apply_other_player_visibility(viewer);
    }
}

// Generous multiple of the camera's orthographic size — wide enough that the
// visible diagonal (and a margin) is always inside it, so we never skip a
// renderer that's actually on screen.
FLOOR_CULL_RADIUS_MULT :: 2.5;

FLOOR_INVIS_REASON :: "different_floor";

// Caller must pass the local player (Floor_Manager only invokes this from
// hooks where Game.get_local_player() returned a local). Invisibility reasons
// are server-authoritative, so this MUST NOT run on dedicated server contexts.
apply_other_player_visibility :: proc(viewer: Player) {
    if viewer == null return;
    viewer_floor := viewer.current_floor;
    for p: component_iterator(Player) {
        if p == null continue;
        if p == viewer continue;
        if p.current_floor <= viewer_floor {
            p.remove_invisibility_reason(FLOOR_INVIS_REASON);
            p.remove_name_invisibility_reason(FLOOR_INVIS_REASON);
        } else {
            p.add_invisibility_reason(FLOOR_INVIS_REASON);
            p.add_name_invisibility_reason(FLOOR_INVIS_REASON);
        }
    }
}

get_floor_manager :: proc() -> Floor_Manager {
    for fm: component_iterator(Floor_Manager) {
        return fm;
    }
    return null;
}

// Mirrors C# RenderBlackOverlay: draws a big black quad below the local player
// at layer = current_floor - 1, dimming whatever's on the floor underneath.
FLOOR_SHADOW_GROW  :: 80.0;
FLOOR_SHADOW_ALPHA :: 0.85;

draw_floor_shadow :: proc(player: Player) {
    if player == null return;
    if !#alive(player.entity) return;
    if player.current_floor <= 0 return;

    pos := player.entity.world_position;
    rect := Rect{pos, pos}.grow(FLOOR_SHADOW_GROW, FLOOR_SHADOW_GROW, FLOOR_SHADOW_GROW, FLOOR_SHADOW_GROW);

    UI.push_world_draw_context();
    defer UI.pop_draw_context();
    UI.push_z(-1000000.0);
    defer UI.pop_z();
    UI.push_layer(player.current_floor - 1);
    defer UI.pop_layer();

    UI.quad(rect, core_globals.white_sprite, v4{0, 0, 0, FLOOR_SHADOW_ALPHA});
}
