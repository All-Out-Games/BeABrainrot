import "core:ao"
import "effects"
import "tutorial"
import "events"

ao_before_scene_load :: proc() {
    Scene.set_auto_save_player_inventory(true);
    register_brainrot_definitions();
    register_default_rebirth_levels();
}

CASH_SAVE_KEY  :: "cash";
SPEED_SAVE_KEY           :: "speed";
PURCHASED_SPEED_SAVE_KEY :: "purchased_speed";
INITIALIZED_SAVE_KEY     :: "initialized"; // set once on first join so we only grant starting cash once
STARTING_CASH            :: 1000.0;          // granted on first join and on /reset
AUTO_COLLECT_SAVE_KEY    :: "auto_collect";  // PRIME auto-collect toggle (persisted)
AUTO_COLLECT_INTERVAL    :: 1.0;             // seconds between auto-collects
SLOW_MODE_SAVE_KEY       :: "slow_mode";     // "Slow" movement toggle (persisted)

CASH_POPUP_DURATION :: 1.4;
CASH_POPUP_RISE     :: 70.0;
CASH_COUNTER_RATE   :: 9.0;

Cash_Popup :: struct {
    amount: float;
    base_amount: float; // pre-double amount; doubled popups count up from this
    age: float;
    is_loss: bool;
    doubled: bool; // 2X Money collect — counts up to amount and lerps green->gold
}

push_cash_popup :: proc(player: Player, amount: float, is_loss: bool, doubled: bool = false, base_amount: float = -1.0) {
    if amount <= 0 return;
    p: Cash_Popup;
    p.amount = amount;
    p.base_amount = base_amount;
    if p.base_amount < 0 p.base_amount = amount;
    p.age = 0;
    p.is_loss = is_loss;
    p.doubled = doubled;
    append(ref player.cash_popups, p);
}

deposit_cash :: proc(player: Player, amount: float) {
    if amount <= 0 return;
    player.cash += amount;
    Save.set_f64(player, CASH_SAVE_KEY, player.cash.(f64));
    push_cash_popup(player, amount, false);
}

// Collect pedestal income. With the 2X Money gamepass the amount is doubled at
// collection (not at the gps tick), and the popup gets the flashy doubled style.
collect_pedestal_gold :: proc(player: Player, amount: float) -> float {
    if player == null return 0;
    if amount <= 0 return 0;
    total := amount;
    doubled := has_2x_money(player);
    if doubled total = amount * 2.0;
    player.cash += total;
    Save.set_f64(player, CASH_SAVE_KEY, player.cash.(f64));
    push_cash_popup(player, total, false, doubled, amount); // base = pre-double
    return total;
}

// Round-up to the nearest integer (CSL has no built-in ceil for float).
ceil_float :: proc(x: float) -> float {
    // Guard the s64 cast: values beyond the s64 range overflow it and wrap to
    // a huge NEGATIVE number (this silently broke offline earnings — a big
    // gps*afk product became -2^63, so the popup never armed). Such magnitudes
    // have no fractional part at float precision anyway, so return them as-is.
    if x >= 9000000000000000000.0 return x;
    if x <= -9000000000000000000.0 return x;
    i := x.(s64).(float);
    if i < x return i + 1.0;
    return i;
}

withdraw_cash :: proc(player: Player, amount: float) -> bool {
    if player.cash < amount return false;
    player.cash -= amount;
    Save.set_f64(player, CASH_SAVE_KEY, player.cash.(f64));
    push_cash_popup(player, amount, true);
    return true;
}

set_speed :: proc(player: Player, value: s64) {
    clamped := value;
    if clamped < BASE_SPEED clamped = BASE_SPEED;
    player.speed = clamped;
    Save.set_int(player, SPEED_SAVE_KEY, clamped);
}

add_speed :: proc(player: Player, amount: s64) {
    set_speed(player, player.speed + amount);
}

tick_cash_animations :: proc(player: Player, dt: float) {
    diff := player.cash - player.displayed_cash;
    step := dt * CASH_COUNTER_RATE;
    if step > 1.0 step = 1.0;
    if abs(diff) > 0.01 {
        player.displayed_cash += diff * step;
    } else {
        player.displayed_cash = player.cash;
    }

    i := player.cash_popups.count - 1;
    while i >= 0 {
        player.cash_popups[i].age += dt;
        if player.cash_popups[i].age >= CASH_POPUP_DURATION {
            unordered_remove_by_index(ref player.cash_popups, i);
        }
        i -= 1;
    }
}

ao_start :: proc() {
    sparks_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/coin/coin_icon_b.png");
    Economy.register_currency(SPARKS_CURRENCY, sparks_icon);
    register_mutation_materials();
    register_shop_materials();
    register_default_shop_items();
}

give_cash :: proc(player: Player, amount: float = 1000) {
    deposit_cash(player, amount);
    show_notification(player, "+% cash", {format_cash(amount)});
} @chat_command

remove_cash :: proc(player: Player, amount: float = 1000) {
    take := amount;
    if take > player.cash take = player.cash;
    player.cash -= take;
    Save.set_f64(player, CASH_SAVE_KEY, player.cash.(f64));
    push_cash_popup(player, take, true);
    show_notification(player, "-% cash", {format_cash(take)});
} @chat_command

set_speed_cmd :: proc(player: Player, value: s64 = 18) {
    set_speed(player, value);
    show_notification(player, "Speed set to %", {player.speed});
} @chat_command

set_permanent_speed :: proc(player: Player, value: s64 = 0) {
    player.set_permanent_speed(value);
    show_notification(player, "Permanent speed set to +%", {player.purchased_speed});
} @chat_command

set_floor_cmd :: proc(player: Player, floor: s64 = 0) {
    if floor < 0 floor = 0;
    player.current_floor = floor;
    fm := get_floor_manager();
    if fm != null fm.apply_visibility(player);
    show_notification(player, "Current floor: %", {floor});
} @chat_command

// Full progress wipe: speed, sparks-bought speed, cash, rebirths (+ rebirth-
// granted pedestal slots), the base's placed brainrots, and the inventory.
reset :: proc(player: Player) {
    if player == null return;

    // Speed + permanent (sparks-bought) speed back to baseline.
    player.set_permanent_speed(0);
    set_speed(player, BASE_SPEED);

    // Cash — back to the starting amount.
    player.cash = STARTING_CASH;
    player.displayed_cash = STARTING_CASH;
    Save.set_f64(player, CASH_SAVE_KEY, STARTING_CASH);

    // Rebirths + the pedestal slots they grant.
    player.rebirth_level = 0;
    Save.set_int(player, REBIRTH_SAVE_KEY, 0);
    player.pedestals_unlocked = DEFAULT_PEDESTALS_UNLOCKED;
    Save.set_int(player, PEDESTALS_SAVE_KEY, DEFAULT_PEDESTALS_UNLOCKED);

    // Base: destroy every placed brainrot, persist the empty base, relock slots.
    room := player.my_room;
    if room != null {
        for i: 0..room.pedestals.count - 1 {
            p := room.pedestals[i];
            if p == null continue;
            if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) {
                p.placed_brainrot.entity.destroy();
            }
            p.placed_brainrot  = null;
            p.accumulated_gold = 0;
        }
        room.refresh_pedestal_unlocks();
        save_room_brainrots(player, room);
    }

    // Inventory: drop everything.
    inv := player.default_inventory;
    if inv != null {
        for i: 0..inv.capacity - 1 {
            item := inv.get_item(i);
            if item == null continue;
            if !#alive(item) continue;
            Items.destroy_item_instance(item);
        }
    }

    show_notification(player, "Reset complete!");
} @chat_command

srb :: proc(player: Player) {
    // rng_root_seed() is constant per game instance, so it returns the same
    // brainrot every call. Seed from wall-clock time instead.
    rng: u64 = rng_seed(Time.nanoseconds_since_epoch());
    configs := get_brainrot_configs();
    if configs.count <= 0 {
        show_notification(player, "No brainrot configs registered.");
        return;
    }

    idx := rng_range_int(ref rng, 0, configs.count - 1);
    config := configs[idx];

    mut: Mutation = Mutation.NONE;
    mut_idx := rng_range_int(ref rng, 0, 4);
    if mut_idx == 1 mut = Mutation.GOLD;
    if mut_idx == 2 mut = Mutation.DIAMOND;
    if mut_idx == 3 mut = Mutation.RAINBOW;
    if mut_idx == 4 mut = Mutation.CANDY;

    pos := player.entity.world_position;
    le := spawn_brainrot(config.id, pos);
    if le == null {
        show_notification(player, "Spawn failed (check Brainrot.prefab).");
        return;
    }
    le.mutation = mut;
    le.level = rng_range_int(ref rng, 1, 19);
    le.update_visuals();

    if mut == Mutation.NONE {
        show_notification(player, "Spawned % (Lv %)", {config.display_name, le.level});
    } else {
        show_notification(player, "Spawned % % (Lv %)", {get_mutation_name(mut), config.display_name, le.level});
    }
} @chat_command

drop_carry :: proc(player: Player) {
    if player == null return;
    if !#alive(player.entity) return;
    remove_effect(player.entity, Carry_Brainrot_Effect_2, true);
} @chat_command

dbg_le :: proc(player: Player) {
    if player == null return;
    player.debug_show_le = !player.debug_show_le;
} @chat_command

shop2 :: proc(player: Player) {
    if player == null return;
    player.show_shop_v2 = !player.show_shop_v2;
} @chat_command

shop3 :: proc(player: Player) {
    if player == null return;
    player.show_shop_v3 = !player.show_shop_v3;
} @chat_command

// Registers an "Emote/Jump_Regular" state on the player's existing state
// machine (added on top of the engine-built default). Triggered by setting
// the "emote_jump_regular" trigger variable on player.animator.state_machine.
register_player_jump_emote :: proc(player: Player) {
    if player == null return;
    if player.animator == null return;
    sm := player.animator.state_machine;
    if sm == null return;
    layer := sm.try_get_layer("main");
    if layer == null return;

    jump_trigger := sm.create_variable("emote_jump_regular", .TRIGGER);
    jump_state   := layer.create_state("Emote/Jump_Regular", false);

    to_jump := layer.create_global_transition(jump_state, true);
    to_jump.create_trigger_condition(jump_trigger);

    idle := layer.try_get_state("Idle");
    if idle != null {
        layer.create_transition(jump_state, idle, true);
    }

    // Knockback flinch — triggered by Hit_Knockback_Effect on first NPC catch.
    flinch_trigger := sm.create_variable("flinch_big", .TRIGGER);
    flinch_state   := layer.create_state("Flinch_Big", false);
    to_flinch := layer.create_global_transition(flinch_state, true);
    to_flinch.create_trigger_condition(flinch_trigger);
    if idle != null {
        layer.create_transition(flinch_state, idle, true);
    }
}

// Adds the "carry" animation states to the player rig. Idle_Hold / Walk_Holding
// mirror the base Idle / Run_Fast states but with the held-brainrot pose.
// Driven by two bools on player.animator.state_machine:
//   "carryingMoving" — true while holding a brainrot (swaps to the carry pose)
//   "moving"         — existing engine bool (carry idle <-> carry walk)
register_player_carry_anims :: proc(player: Player) {
    if player == null return;
    if player.animator == null return;
    sm := player.animator.state_machine;
    if sm == null return;
    layer := sm.try_get_layer("main");
    if layer == null return;

    idle := layer.try_get_state("Idle");
    run  := layer.try_get_state("Run_Fast");
    if idle == null || run == null return;

    // Empty / clear-track state, reusable.
    empty_state := layer.try_get_state("__CLEAR_TRACK__");
    if empty_state == null empty_state = layer.create_state("__CLEAR_TRACK__", true);
    empty_trigger := sm.create_variable("empty", .TRIGGER);
    layer.create_global_transition(empty_state, true).create_trigger_condition(empty_trigger);

    // Carry pose states + the moving bool that flips between them.
    idle_carry := layer.create_state("021MBR/Idle_Hold", true);
    run_carry  := layer.create_state("021MBR/Walk_Holding", true);
    moving := sm.try_get_variable("moving");
    layer.create_transition(idle_carry, run_carry, false).create_bool_condition(moving, true);
    layer.create_transition(run_carry, idle_carry, false).create_bool_condition(moving, false);

    // carryingMoving swaps base <-> carry pose in both idle and run.
    carrying := sm.create_variable("carryingMoving", .BOOL);
    layer.create_transition(idle, idle_carry, false).create_bool_condition(carrying, true);
    layer.create_transition(run, run_carry, false).create_bool_condition(carrying, true);
    layer.create_transition(idle_carry, idle, false).create_bool_condition(carrying, false);
    layer.create_transition(run_carry, run, false).create_bool_condition(carrying, false);
}

emote_jump :: proc(player: Player) {
    if player == null return;
    if player.animator == null return;
    if player.animator.state_machine == null return;
    player.animator.state_machine.set_trigger("emote_jump_regular");
} @chat_command

srbm :: proc(player: Player) {
    rng: u64 = rng_seed(Time.nanoseconds_since_epoch());
    configs := get_brainrot_configs();
    if configs.count <= 0 {
        show_notification(player, "No brainrot configs registered.");
        return;
    }

    idx := rng_range_int(ref rng, 0, configs.count - 1);
    config := configs[idx];

    // Always roll a real mutation (no NONE).
    mut: Mutation = Mutation.GOLD;
    mut_idx := rng_range_int(ref rng, 1, 4);
    if mut_idx == 1 mut = Mutation.GOLD;
    if mut_idx == 2 mut = Mutation.DIAMOND;
    if mut_idx == 3 mut = Mutation.RAINBOW;
    if mut_idx == 4 mut = Mutation.CANDY;

    pos := player.entity.world_position;
    le := spawn_brainrot(config.id, pos);
    if le == null {
        show_notification(player, "Spawn failed (check Brainrot.prefab).");
        return;
    }
    le.mutation = mut;
    le.level = rng_range_int(ref rng, 1, 19);
    le.update_visuals();

    show_notification(player, "Spawned % % (Lv %)", {get_mutation_name(mut), config.display_name, le.level});
} @chat_command

ao_update :: proc(dt: float) {
    // Called once per frame
}

draw_player_hud :: proc(player: Player) {
    UIK.begin(UIK.window(UIK.rect_stats()));

    col := UIK.layout_column();
    col.width = UIK.flex(1);
    col.height = UIK.flex(1);
    col.padding = v4{12, 12, 12, 12};
    col.main_align = .END;
    col.cross_align = .START;
    col.gap = 4;
    UIK.panel_begin(col);

    // Active gamepass badges sit on top of the Speed/cash lines.
    if has_2x_money(player) {
        d := UIK.text_body();
        d.set_halign(.LEFT);
        d.set_color({0.35, 1.0, 0.45, 1});
        d.set_outline(true, 3.0, {0, 0, 0, 1});
        UIK.text("2X Money", d);
    }
    if has_2x_speed(player) {
        d := UIK.text_body();
        d.set_halign(.LEFT);
        d.set_color({0.4, 0.8, 1.0, 1});
        d.set_outline(true, 3.0, {0, 0, 0, 1});
        UIK.text("2X Speed", d);
    }

    speed_desc := UIK.text_title();
    UIK.text_set_halign(&speed_desc, .LEFT);
    UIK.text(format_string("Speed: %", {player.speed}), speed_desc);

    if player.purchased_speed > 0 {
        perm_desc := UIK.text_body();
        perm_desc.set_halign(.LEFT);
        perm_desc.set_color({0.55, 0.80, 1.0, 1});
        perm_desc.set_outline(true, 3.0, {0, 0, 0, 1});
        UIK.text(format_string("Permanent speed: +%", {player.purchased_speed}), perm_desc);
    }

    cash_desc := UIK.text_title();
    UIK.text_set_halign(&cash_desc, .LEFT);
    UIK.text_set_color(&cash_desc, {0.2, 0.9, 0.2, 1});
    UIK.text(format_cash(player.displayed_cash), cash_desc);

    for i: 0..player.cash_popups.count - 1 {
        p := player.cash_popups[i];
        t := p.age / CASH_POPUP_DURATION;
        if t > 1.0 t = 1.0;
        alpha := 1.0 - t;
        offset_y := t * CASH_POPUP_RISE;

        UIK.overlay_begin(.BOTTOM_LEFT, {20, 70 + offset_y});
        pop_desc := UIK.text_title();
        if p.is_loss {
            pop_desc.set_color({1.0, 0.3, 0.3, alpha});
            UIK.text(format_string("-%", {format_cash(p.amount)}), pop_desc);
        } else if p.doubled {
            // 2X Money collect — same rise/fade as normal, but the number races
            // from the base up to the doubled amount while the color lerps
            // green -> gold over the first fraction of the popup's life.
            cu := t / 0.3;
            if cu > 1.0 cu = 1.0;
            ce := 1.0 - (1.0 - cu) * (1.0 - cu); // ease-out
            displayed := lerp(p.base_amount, p.amount, ce);
            r  := lerp(0.3,  1.0,  ce);
            gc := lerp(1.0,  0.85, ce);
            b  := lerp(0.3,  0.1,  ce);
            pop_desc.set_color({r, gc, b, alpha});
            UIK.text(format_string("+%", {format_cash(displayed)}), pop_desc);
        } else {
            pop_desc.set_color({0.3, 1.0, 0.3, alpha});
            UIK.text(format_string("+%", {format_cash(p.amount)}), pop_desc);
        }
        UIK.overlay_end();
    }

    UIK.panel_end();
    UIK.end();
}

ao_late_update :: proc(dt: float) {
    // Called once per frame after physics has been resolved
}


g_players: [..]Player;


Player :: class : Player_Base {
    speed: s64;
    purchased_speed: s64; // cumulative sparks-bought speed, persists through rebirths
    show_speed_upgrades: bool;
    cash: float;
    displayed_cash: float;
    cash_popups: [..]Cash_Popup;
    notifications: [..]Custom_Note;
    auto_collect_enabled: bool;  // PRIME perk: auto-collect base income each second
    auto_collect_timer: float;
    leaderboard_write_timer: float; // publishes gps/speed to the world leaderboards
    slow_mode_enabled: bool;     // caps movement to base speed (for navigating the base)
    upgrade_combo: s64;          // consecutive brainrot upgrades, for SFX intensity
    upgrade_combo_time: float;
    unclaimed_brainrots: [..]Unclaimed_Brainrot; // mailbox for items that didn't fit
    show_unclaimed_modal: bool;
    selected_brainrot_item: Brainrot_Item;
    // The brainrot just bought with sparks, awaiting an optional modifier
    // purchase from the "ADD A MODIFIER" popup. Cleared once applied/dismissed.
    pending_modifier_item: Brainrot_Item;
    show_modifier_popup: bool;        // the "ADD A MODIFIER" choice popup
    show_modifier_skip_confirm: bool; // "are you sure" when closing without buying
    show_sell_modal: bool;
    show_sell_all_confirm: bool;
    rebirth_level: s64;
    show_rebirth_modal: bool;
    equip_best_next_at: float;
    show_shop_modal: bool;
    current_floor: s64;
    is_in_current_room: Room;
    my_room: Room;
    // The one NPC room this player is currently allowed to be in / steal from
    // (set to the last room entered while auto-walking). null = none, which
    // means every room's roof blocks them. Cleared on steal / line-cross / hit.
    active_steal_room: Room_Npc;
    // One-shot: force the hotbar selection to slot 0 on the next draw (set when a
    // stolen brainrot lands at the front).
    select_slot_0_request: bool;
    // Current tutorial step (persisted); TUT_DONE = finished. See tutorial/.
    tutorial_step: s64;
    // Base nav-button screen rect, captured each frame it's drawn (for the
    // tutorial arrow). nav_base_rect_frame stamps the frame so a stale rect
    // isn't used when the nav bar isn't showing.
    nav_base_rect: Rect;
    nav_base_rect_frame: u64;
    nav_buy_rect: Rect;
    nav_buy_rect_frame: u64;
    upgrade_btn_rect: Rect;
    upgrade_btn_rect_frame: u64;
    speed_upgrade_rect: Rect;
    speed_upgrade_rect_frame: u64;
    // Brainrot index (collection dex).
    discovered_brainrots: [..]Discovered_Brainrot;
    show_index_modal: bool;
    index_category: s64;      // active mutation filter = a Mutation int
    index_rarity_filter: s64; // -1 = all rarities, else a Rarity int
    index_only_unlocked: bool;
    pedestals_unlocked: s64;
    debug_show_le: bool;
    show_shop_v2: bool;
    show_shop_v3: bool;
    shop3_popup_text: string; // non-empty while the card-click test popup is open
    default_camera_size: float;
    show_skin_shop: bool;
    equipped_skin_id: string;
    unlocked_skins: [..]string; // skin config_ids the player has paid robux to unlock (in addition to rebirth-unlocked ones)

    // Admin event + cheat panel (see scripts/events/). Per-admin window state,
    // synced so the server also draws the panel and registers the action button
    // clicks. The panel's *selection* state (scope/cash/speed/brainrot) lives on
    // Event_Manager instead, since it's shared and doesn't belong on Player.
    admin_panel_open: bool;
    admin_panel_tab: s64; // 0 = events, 1 = cheats

    // "Welcome Back" offline-earnings popup (see offline_earnings.csl). pending
    // gates both the popup display AND whether ao_end advances the last-seen
    // clock; amount is the base (1x) reward, frozen at join.
    offline_earnings_pending: bool;
    offline_earnings_amount:  float;
    // Arming is deferred to ao_update because the base's GPS isn't reliably
    // known at ao_start (room pedestals / brainrot save JSON load a beat later).
    // afk_seconds is the capped window frozen at join; arm_waiting/arm_elapsed
    // drive the short retry in tick_offline_earnings.
    offline_afk_seconds:      float;
    offline_arm_waiting:      bool;
    offline_arm_elapsed:      float;
    // True when the saved base has at least one brainrot, i.e. income is OWED
    // and GPS will become > 0 once the room finishes claiming (claim can defer
    // to the ao_update retry). Lets tick keep waiting past the short grace
    // instead of dropping the window when GPS is merely slow to appear.
    offline_base_has_income:  bool;
    // Heartbeat accumulator: re-stamps offline_last_seen every
    // OFFLINE_HEARTBEAT_SECONDS once the join popup is settled, so a crash loses
    // at most that much offline-time accuracy. armed gates it OFF until the
    // join-time window is resolved, so it can never overwrite an unclaimed one.
    offline_heartbeat_elapsed: float;
    offline_heartbeat_armed:   bool;

    // Sets the player's permanent (sparks-bought) speed bonus and persists it.
    // Single source of truth for any caller that needs to mutate this field.
    set_permanent_speed :: method(value: s64) {
        if value < 0 value = 0;
        purchased_speed = value;
        Save.set_int(this, PURCHASED_SPEED_SAVE_KEY, value);
    }

    // The player's real movement speed (agent units), including the 2x Speed
    // gamepass. Single source of truth — used for agent.movement_speed and by
    // the NPC chaser when deciding whether it can keep up.
    get_actual_speed :: method() -> float {
        ms := compute_agent_movement_speed(speed);
        if has_2x_speed(this) ms *= 2.0;
        return ms;
    }

    // Move the player to a world position and skip render interpolation across
    // the jump (sim runs at 32hz; without this the render lerps from the old
    // spot and the player visibly slides to the destination).
    teleport :: method(pos: v2) {
        if !#alive(entity) return;
        entity.set_world_position(pos);
        entity.mark_teleported();
    }

    ao_start :: method() {
        append(ref g_players, this);

        purchased_speed = Save.get_int(this, PURCHASED_SPEED_SAVE_KEY, 0);
        speed = Save.get_int(this, SPEED_SAVE_KEY, BASE_SPEED);
        if speed < BASE_SPEED speed = BASE_SPEED;
        cash = Save.get_f64(this, CASH_SAVE_KEY, 0).(float);
        // First time joining → grant starting cash (flag persisted so it's
        // only ever granted once).
        if Save.get_int(this, INITIALIZED_SAVE_KEY, 0) == 0 {
            cash = STARTING_CASH;
            Save.set_f64(this, CASH_SAVE_KEY, cash.(f64));
            Save.set_int(this, INITIALIZED_SAVE_KEY, 1);
        }
        displayed_cash = cash;
        rebirth_level = Save.get_int(this, REBIRTH_SAVE_KEY, 0);
        pedestals_unlocked = Save.get_int(this, PEDESTALS_SAVE_KEY, DEFAULT_PEDESTALS_UNLOCKED);
        auto_collect_enabled = Save.get_int(this, AUTO_COLLECT_SAVE_KEY, 0) != 0;
        slow_mode_enabled = Save.get_int(this, SLOW_MODE_SAVE_KEY, 0) != 0;
        load_unclaimed_brainrots(this);
        load_brainrot_index(this);
        load_tutorial(this);

        default_camera_size = camera.size;

        room := find_free_room();
        if room != null room.claim_room(this);

        // Offline earnings — compute AFTER the room is claimed so the base's
        // brainrots are loaded and player_total_gps is accurate.
        compute_offline_earnings(this);

        snap_player_to_navmesh(this);
        register_player_jump_emote(this);
        register_player_carry_anims(this);

        // Always-on background music (normal loop; chase effect swaps tracks).
        entity.add_passive_effect(new(Background_Music_Effect));
    }

    ao_update :: method(dt: float) {
        if agent != null {
            // Slow toggle caps movement to base speed (stat 18) so players can
            // navigate their base without overshooting; otherwise real speed.
            if slow_mode_enabled {
                agent.movement_speed = compute_agent_movement_speed(BASE_SPEED);
            } else {
                agent.movement_speed = get_actual_speed();
            }
        }
        if animator != null {
            animator.layer = current_floor.(s32);
        }
        tick_cash_animations(this, dt);
        tick_notifications(this, dt);
        tick_offline_earnings(this, dt);

        // PRIME auto-collect: sweep all base pedestal income once per second.
        if auto_collect_enabled && has_prime(this) {
            auto_collect_timer += dt;
            if auto_collect_timer >= AUTO_COLLECT_INTERVAL {
                auto_collect_timer = 0;
                collect_all_pedestal_gold(this);
            }
        }

        // Publish this player's current gps/speed to the world leaderboards.
        // Absolute (idempotent) ordered-save writes, so running on both client
        // and server is harmless.
        leaderboard_write_timer += dt;
        if leaderboard_write_timer >= LEADERBOARD_WRITE_INTERVAL {
            leaderboard_write_timer = 0;
            leaderboard_publish_scores(this);
        }

        // While being chased, zoom IN the closer the NPC gets — ramps the
        // pressure as it closes in. Skip while Moving_Toward is auto-walking —
        // it owns the camera and zooms out on its own.
        _, auto_walking := get_effect(entity, Moving_Toward_Effect);
        if !auto_walking {
            bc, being_chased := get_effect(entity, Being_Chased_Effect);
            target_size := default_camera_size;
            if being_chased {
                d := chaser_distance(this, bc.chaser);
                prox := 1.0 - (d - CHASE_ZOOM_NEAR_DIST) / (CHASE_ZOOM_FAR_DIST - CHASE_ZOOM_NEAR_DIST);
                if prox < 0.0 prox = 0.0;
                if prox > 1.0 prox = 1.0;
                target_size = lerp(CHASE_CAMERA_SIZE, CHASE_CAMERA_CLOSE, prox);
            }
            camera.size = lerp(camera.size, target_size, clamp(dt * 6.0, 0, 1));
        }


        // If we don't own a room (joined when full, or our previous room got
        // wiped), keep retrying — a room may free up later as players leave.
        if my_room == null {
            free_room := find_free_room();
            if free_room != null free_room.claim_room(this);
        }

        // On upper floors, walls of the current room become solid — unless the
        // player is mid-jump (then Jump_Effect drops them to floor 0 instead).
        if current_floor > 0 && is_in_current_room != null && #alive(is_in_current_room.entity) {
            _, jumping := get_effect(entity, Jump_Effect);
            if !jumping
                is_in_current_room.clamp_player_inside(this);
        }

        // NPC-room roof barrier: a roofed room blocks entry. The only room
        // NOT roofed for this player is their active_steal_room. While
        // auto-walking we let them pass freely (roofs are visual only there);
        // once stopped, push them out of every other room's bounds.
        if !auto_walking {
            for r: g_npc_rooms {
                if r == null continue;
                if r == active_steal_room continue;
                r.clamp_player_outside(this);
            }
        }
    }

    ao_late_update :: method(dt: float) {
        if is_local_or_server() {
            // World-space leaderboard boards drawn from the player update
            // context so they have the live camera/interaction state. Culled to
            // on-screen boards only -- the 50-row scroll view is expensive, so
            // skip it when the board isn't visible (apron covers its extent).
            for lb: component_iterator(Leaderboard) {
                if lb == null continue;
                if !#alive(lb.entity) continue;
                if !Camera.is_visible(lb.entity.world_position, 3.5) continue;
                lb.draw();
            }

            draw_player_hud(this);
            draw_side_buttons(this);
            draw_left_buttons(this);
            draw_speed_upgrade_ui(this);
            draw_upgrade_hud(this);

            options := Inventory_Draw_Options.default();
            options.hotbar_item_count = 6;
            options.enable_selection = true;
            options.scroll_item_selection = true;
            options.enable_use_from_hotbar = true;
            // Just stole a brainrot → force-select the front slot once.
            if select_slot_0_request {
                options.force_select_hotbar_index = 0;
                select_slot_0_request = false;
            }
            result := Items.draw_hotbar(this, default_inventory, options);

            prev_selected := selected_brainrot_item;
            selected_brainrot_item = null;

            slot := default_inventory.get_item(result.selected_item_index);
            if #alive(slot) && slot.#type == Brainrot_Item {
                selected_brainrot_item = slot.(Brainrot_Item);
            }

            if selected_brainrot_item != prev_selected {
                if selected_brainrot_item == null {
                    log_info("Hand: <empty> (slot index=%)", {result.selected_item_index});
                } else {
                    defn := selected_brainrot_item.get_definition();
                    name := "?";
                    if defn != null name = defn.get_name();
                    log_info("Hand: % (Lv %, slot=%)", {name, selected_brainrot_item.level, result.selected_item_index});
                }
            }

            draw_ability_button(this, Jump_Ability, 0);

            // World-space hand preview for EVERY player, not just local — the
            // local client renders each player's carried icon in the world so
            // remote players' icons are visible too. selected_brainrot_item is
            // server-synced, so the iteration sees up-to-date values.
            for p: g_players {
                if p == null continue;
                if !#alive(p) continue;
                if !#alive(p.entity) continue;
                draw_selected_brainrot_above_player(p);
            }
            above_npc_line := false;
            gm := get_game_manager();
            if gm != null && gm.npc_line != null && #alive(gm.npc_line) {
                above_npc_line = entity.world_position.y > gm.npc_line.world_position.y;
            }
            if above_npc_line {
                draw_npc_area_topbar(this);
            } else {
                draw_navigation_topbar(this);
            }
            draw_sell_modal(this);
            draw_rebirth_modal(this);
            draw_shop_modal(this);
            draw_shop_v2(this);
            draw_shop_v3(this);
            draw_modifier_popup(this);
            draw_skin_shop(this);
            draw_debug_living_entity(this);
            draw_unclaimed_modal(this);
            draw_offline_earnings(this);
            draw_index_modal(this);
            draw_tutorial(this);
            draw_notifications(this);
            draw_event_hud(this);

            // World-space "next event" countdown labels — iterate the static
            // self-registered list (see event_display.csl), culled to on-screen.
            for i: 0..g_event_displays.count - 1 {
                ed := g_event_displays[i];
                if ed == null continue;
                if !#alive(ed) continue;
                if !#alive(ed.entity) continue;
                if !Camera.is_visible(ed.entity.world_position, 3.0) continue;
                ed.draw();
            }

            update_admin_panel(this);
        }
        if is_local() {
            draw_floor_shadow(this);
        }
    }

    ao_end :: method() {
        // Stamp the disconnect time so next join's offline window starts here —
        // but only if there's no unresolved Welcome Back popup (else keep the
        // old last-seen so the unclaimed window survives the disconnect).
        stamp_offline_disconnect(this);

        for i: 0..g_players.count - 1 {
            if g_players[i] == this {
                unordered_remove_by_index(ref g_players, i);
                break;
            }
        }
        if my_room != null my_room.release_room();
        release_chasers_for_player(this);
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        // Called to determine if the player is allowed to use the given ability
        return true;
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        // Called to determine if the player is allowed to use the given interactable
        return true;
    }

    ao_on_interactable_used :: method(interactable: Interactable) {
        // Called when the player uses the given interactable
    }

    ao_on_holding_interactable :: method(interactable: Interactable) {
        // Called once per frame while the player is holding on the interactable
    }

    ao_on_state_sync :: method() {
        // Called on the client after applying a state sync from the server
        // Use this to override things for the local player only like name colors or lighting for example
    }
}
