Npc_Chaser_State :: enum {
    IDLE;
    CHASING;
    ESCORTING;
}

// Global registry of every Npc_Chaser in the scene. Maintained by ao_start /
// ao_end so we don't pay component_iterator on every reset / release.
g_npc_chasers: [..]Npc_Chaser;

NPC_CATCH_RADIUS_SQ        :: 0.25;   // 0.5 wu
NPC_ARRIVED_RADIUS_SQ      :: 0.04;   // 0.2 wu
NPC_HOME_RADIUS_SQ         :: 0.0025; // 0.05 wu
NPC_CHASE_WINDUP_SPEED     :: 0.5;    // wu/s during the wind-up after a re-trigger
NPC_CHASE_WINDUP_DURATION  :: 1;    // seconds of wind-up before sprint kicks in
NPC_CHASE_SPRINT_MULT      :: 3.5;    // multiplier applied to NPC chase speed when its stat > player's (guarantees the slower player is caught regardless of starting gap — must comfortably exceed the player's auto-walk speed so they can't pass through a room before the catch)
NPC_ESCORT_FREEZE_REASON   :: "escort_to_jail";

Npc_Chaser :: class : Component {
    // Player-equivalent speed stat. The NPC moves at exactly the wu/s a player
    // at this stat would when actively pressing the joystick:
    //   - player speed_stat HIGHER + moving → player outruns
    //   - player speed_stat HIGHER but idle (no input) → player is caught
    //   - player speed_stat LOWER → always caught
    speed_stat: s64 @ao_serialize;

    home_room:              Room_Npc; // set by Room_Npc.init_npc_room via collect_chasers_recursive
    assigned_player:        Player;
    home_position:          v2;
    state:                  Npc_Chaser_State;
    chase_windup_remaining: float; // > 0 while a re-chase is in its slow wind-up phase
    is_re_chase:            bool;  // set on jailbreak / re-steal: NPC matches player speed instead of sprinting, so the player can outrun by holding the joystick
    spine:                  Spine_Animator; // first-child spine, if present — drives Idle/Run anims and replaces the sprite
    current_anim:           string;         // last animation pushed to the spine, to avoid restarting it every frame
    current_anim_speed:     float;          // last animation speed pushed to the spine
    last_world_pos:         v2;             // world position last frame — used to detect actual movement for the anim picker

    ao_start :: method() {
        home_position = entity.world_position;
        last_world_pos = home_position;
        if speed_stat <= 0 speed_stat = 30;
        append(ref g_npc_chasers, this);

        // Opt-in spine: if the first child of this entity has a Spine_Animator,
        // switch the chaser to spine-driven Idle/Run animation and disable the
        // entity's own Sprite_Renderer so we don't double-draw.
        first_child := entity.get_first_child();
        if first_child != null && #alive(first_child) {
            s := first_child.get_component(Spine_Animator);
            if s != null {
                spine = s;
                sr := entity.get_component(Sprite_Renderer);
                if sr != null sr.set_enabled(false);
            }
        }
    }

    ao_end :: method() {
        for i: 0..g_npc_chasers.count - 1 {
            if g_npc_chasers[i] == this {
                unordered_remove_by_index(ref g_npc_chasers, i);
                break;
            }
        }
    }

    ao_update :: method(dt: float) {
        if state == Npc_Chaser_State.IDLE {
            tick_chaser_idle(this, dt);
        } else if state == Npc_Chaser_State.CHASING {
            tick_chaser_chasing(this, dt);
        } else if state == Npc_Chaser_State.ESCORTING {
            tick_chaser_escorting(this, dt);
        }
    }

    ao_late_update :: method(dt: float) {
        // Each client only sees its own chaser per room — hide the rest by
        // zeroing renderer tint alpha (chase logic still runs). Visual-only,
        // so it's fine to derive from the client-local player.
        set_chaser_subtree_visible(entity, chaser_is_displayed_for_local(this));

        update_chaser_spine_anim(this, dt);
    }

    on_catch :: method() {
        if assigned_player == null return;
        if !#alive(assigned_player.entity) return;

        // Caught — no longer "being chased", drop the chase camera marker.
        remove_effect(assigned_player.entity, Being_Chased_Effect, false);

        _, has_in_room := get_effect(assigned_player.entity, In_Npc_Room_Effect);
        if has_in_room {
            // Re-catch while jailed (jailbreak or steal-while-jailed) →
            // 1s knockback first, THEN punish (return brainrot + teleport
            // home). Knockback only fires on the re-catch path.
            _, has_kb := get_effect(assigned_player.entity, Hit_Knockback_Effect);
            if has_kb return;

            // Clear the alarm — knockback takes over as the punish feedback.
            remove_effect(assigned_player.entity, Re_Chase_Alarm_Effect, false);
            // Snap the stolen brainrot back to its pedestal as instant feedback;
            // the punish at the end of the knockback won't double-return it.
            return_stolen_brainrot_to_pedestal(assigned_player);

            kb := new(Hit_Knockback_Effect);
            kb.chaser = this;
            diff := assigned_player.entity.world_position - entity.world_position;
            if length_squared(diff) > 0 {
                kb.knockback_dir = normalize(diff);
            } else {
                kb.knockback_dir = v2{1, 0};
            }
            assigned_player.entity.set_active_effect(kb);
            return;
        }

        // First catch → tag, remove Moving_Toward, start escort to first pedestal.
        eff := new(Catched_By_Npc_Effect);
        assigned_player.entity.add_passive_effect(eff);
        remove_effect(assigned_player.entity, Moving_Toward_Effect, true);
        assigned_player.add_freeze_reason(NPC_ESCORT_FREEZE_REASON);
        state = Npc_Chaser_State.ESCORTING;
    }
}

// Transform a direction/delta vector (no translation) by a Matrix4's linear
// part — column-major, same indexing convention as transform_point_2d.
transform_delta_2d :: proc(m: Matrix4, d: v2) -> v2 {
    rx := d.x * m.elements[0][0] + d.y * m.elements[1][0];
    ry := d.x * m.elements[0][1] + d.y * m.elements[1][1];
    return v2{rx, ry};
}

// Flip the entity along X so it faces the world direction it's moving. There's
// no set_world_scale, so the facing is still done via local_scale — convert the
// world dx into the parent's local space so a mirrored parent (scale.x = -1)
// doesn't reverse the facing.
face_along_x :: proc(e: Entity, world_dx: float) {
    if abs(world_dx) < 0.001 return;
    local_dx := world_dx;
    parent := e.get_parent();
    if parent != null && #alive(parent) {
        local_dx = transform_delta_2d(parent.inverse_model_matrix, v2{world_dx, 0}).x;
    }
    if abs(local_dx) < 0.0001 return;
    s := e.local_scale;
    abs_x := abs(s.x);
    target_x := abs_x;
    if local_dx < 0 target_x = -abs_x;
    if s.x == target_x return;
    e.set_local_scale(v2{target_x, s.y});
}

// Push the right Idle/Run animation to the chaser's spine based on whether
// the entity actually moved between frames — robust to state weirdness.
// The Run anim's playback speed scales with the chaser's actual world-units
// per second so a sprinting chaser visibly runs faster than a windup walk.

NPC_MOVING_EPSILON_SQ :: 0.000004; // ~0.002 wu/frame
NPC_ANIM_REF_WUPS     :: 5.0;      // wu/s at which run plays at 1.0× (≈ base player speed)
NPC_ANIM_SPEED_MIN    :: 1.0;
NPC_ANIM_SPEED_MAX    :: 4.0;

// Single transition into CHASING. Both the initial chase (player crossing
// into the chase trigger) and re-chases (jailbreak / steal-while-jailed)
// route through here so the state setup lives in one place.
//   is_re_chase = false → first catch, windup skipped, sprint-when-faster
//   is_re_chase = true  → jailbreak / steal-while-jailed, slow windup, no
//                         sprint (matches player speed, capped at NPC stat)
start_chase :: proc(c: Npc_Chaser, is_re_chase: bool) {
    if c == null return;
    if c.state == Npc_Chaser_State.ESCORTING return;
    // Already chasing → ignore re-triggers (e.g. re-entering the room's trigger
    // volume mid-chase). Restarting would reset is_re_chase to false, flipping a
    // matched re-chase into a first-chase sprint and making the NPC speed up.
    // Chases only (re)start from IDLE.
    if c.state == Npc_Chaser_State.CHASING return;
    if c.assigned_player != null && #alive(c.assigned_player.entity) {
        // "Being chased" marker — drives the chase camera zoom + chase music.
        // Skipped during the auto-walk conveyor ride (the first catch happens
        // then anyway); only present while actually fleeing. Dedupe so two
        // chasers targeting the same player don't stack it.
        _, auto_walking := get_effect(c.assigned_player.entity, Moving_Toward_Effect);
        bc, has_chased := get_effect(c.assigned_player.entity, Being_Chased_Effect);
        if !auto_walking && !has_chased {
            bc = new(Being_Chased_Effect);
            bc.chaser = c;
            c.assigned_player.entity.add_passive_effect(bc);
        } else if bc != null {
            bc.chaser = c;
        }
        // "You've been spotted" alarm (camera shake + red flash) on re-chase only.
        if is_re_chase {
            _, has_alarm := get_effect(c.assigned_player.entity, Re_Chase_Alarm_Effect);
            if !has_alarm {
                c.assigned_player.entity.add_passive_effect(new(Re_Chase_Alarm_Effect));
            }
        }
    }
    c.state                  = Npc_Chaser_State.CHASING;
    c.is_re_chase            = is_re_chase;
    c.chase_windup_remaining = 0;
    if is_re_chase c.chase_windup_remaining = NPC_CHASE_WINDUP_DURATION;
}

update_chaser_spine_anim :: proc(c: Npc_Chaser, dt: float) {
    if c.spine == null return;
    pos := c.entity.world_position;
    delta := pos - c.last_world_pos;
    c.last_world_pos = pos;

    moving := length_squared(delta) >= NPC_MOVING_EPSILON_SQ;

    target_anim: string = "idle";
    target_speed: float = 1.0;
    if moving {
        target_anim = "run";
        if dt > 0 {
            wups := length(delta) / dt;
            target_speed = wups / NPC_ANIM_REF_WUPS;
        }
        if target_speed < NPC_ANIM_SPEED_MIN target_speed = NPC_ANIM_SPEED_MIN;
        if target_speed > NPC_ANIM_SPEED_MAX target_speed = NPC_ANIM_SPEED_MAX;
    }

    sm := c.spine.state_machine;
    if sm != null sm.set_bool("moving", moving);

    // Restart the track only when the animation changes or the speed shifts
    // noticeably — otherwise the loop would keep restarting from frame 0.
    if c.current_anim == target_anim && abs(c.current_anim_speed - target_speed) < 0.1 return;
    c.spine.set_animation(target_anim, true, 0, target_speed);
    c.current_anim = target_anim;
    c.current_anim_speed = target_speed;
}

// wu/s for a chaser at the given player-equivalent speed stat. Uses the
// UNCAPPED curve so high-stat chasers keep getting faster past the player's
// movement cap — otherwise a stat-339 chaser and a stat-309 player both clamp
// to MAX_AGENT_SPEED and move identically (chaser can never catch). Dividing
// by 60 converts the agent-speed value to a per-second rate for set_world_position.
chaser_speed_wu_per_sec :: proc(stat: s64) -> float {
    return compute_agent_movement_speed_uncapped(stat) / 60.0;
}

// Distance from the player to a specific chaser. Large value if none / stale
// (not alive or no longer chasing). Drives the proximity chase-camera zoom + sway.
chaser_distance :: proc(player: Player, c: Npc_Chaser) -> float {
    if player == null return 999999.0;
    if !#alive(player.entity) return 999999.0;
    if c == null return 999999.0;
    if !#alive(c.entity) return 999999.0;
    if c.state != Npc_Chaser_State.CHASING return 999999.0;
    return length(c.entity.world_position - player.entity.world_position);
}

tick_chaser_idle :: proc(c: Npc_Chaser, dt: float) {
    my_world := c.entity.world_position;
    diff := c.home_position - my_world;
    if length_squared(diff) < NPC_HOME_RADIUS_SQ return;
    step := chaser_speed_wu_per_sec(c.speed_stat) * dt;
    face_along_x(c.entity, diff.x);
    if length_squared(diff) <= step * step {
        c.entity.set_world_position(c.home_position);
        return;
    }
    n := normalize(diff);
    c.entity.set_world_position(my_world + n * step);
}

tick_chaser_chasing :: proc(c: Npc_Chaser, dt: float) {
    if c.assigned_player == null { c.state = Npc_Chaser_State.IDLE; return; }
    if !#alive(c.assigned_player.entity) { c.state = Npc_Chaser_State.IDLE; return; }
    // Keep the Being_Chased effect's chaser reference fresh so the camera reads
    // its chaser directly without scanning all chasers.
    bc, has_bc := get_effect(c.assigned_player.entity, Being_Chased_Effect);
    if has_bc && bc != null bc.chaser = c;
    // Pause the chase while the player is on an upper floor (mid-jump or in an
    // upper room). Stays in CHASING so it picks back up when they're on 0.
    if c.assigned_player.current_floor != 0 return;
    // Also pause while a knockback is in flight — the player is mid-punish
    // animation and the NPC standing still reads better than continuing to
    // close on a spinning, flying player.
    _, has_kb := get_effect(c.assigned_player.entity, Hit_Knockback_Effect);
    if has_kb return;

    chaser_max := chaser_speed_wu_per_sec(c.speed_stat);

    // The player's REAL movement speed in wu/s, including the 2x Speed gamepass
    // (Player.get_actual_speed uses the capped curve; below SPEED_STAT_AT_MAX it
    // matches the chaser's uncapped curve, so the comparison is apples-to-apples).
    player_real := c.assigned_player.get_actual_speed() / 60.0;

    effective_speed := chaser_max;
    if c.is_re_chase {
        // Re-chase (jailbreak / re-steal): match the player's real speed, but
        // never exceed the NPC's own max — so a genuinely faster player keeps
        // their head start instead of letting the NPC keep up indefinitely.
        effective_speed = player_real;
        if effective_speed > chaser_max effective_speed = chaser_max;
    } else if player_real < chaser_max {
        // First chase, NPC genuinely faster than the player → sprint to
        // guarantee the catch. If the player is actually faster (e.g. a 30-speed
        // player with 2x = 60 vs a 39 NPC), the NPC does NOT get the sprint.
        effective_speed = chaser_max * NPC_CHASE_SPRINT_MULT;
    }
    if c.chase_windup_remaining > 0 {
        effective_speed = NPC_CHASE_WINDUP_SPEED;
        c.chase_windup_remaining -= dt;
    }

    player_pos := c.assigned_player.entity.world_position;
    my_world := c.entity.world_position;
    diff := player_pos - my_world;
    step := effective_speed * dt;

    // "In range" = within the catch radius OR this frame's step would reach/
    // overshoot the player. The overshoot test matters because a sprinting NPC
    // moves several wu per frame — far more than the 0.5wu catch radius — so it
    // would otherwise tunnel straight past an idle player and never catch them.
    if length_squared(diff) < NPC_CATCH_RADIUS_SQ || length_squared(diff) <= step * step {
        // "moving" — actively progressing. On the auto-walk ride that's the
        // effect's has_input (forced false at the ceiling so holding the stick
        // against the top still gets you caught); in free roam it's raw input.
        moving := false;
        mt, auto_walking := get_effect(c.assigned_player.entity, Moving_Toward_Effect);
        if auto_walking && mt != null {
            moving = mt.has_input;
        } else {
            input := c.assigned_player.input_this_frame;
            moving = input.x != 0 || input.y != 0;
        }

        // The "keep moving = safe" escape ONLY applies to a player whose speed
        // STAT is at least the chaser's. Real speed is capped at SPEED_STAT_AT_MAX,
        // so a stat-450 player and a stat-369 chaser move identically — the stat
        // is what decides if they could legitimately outrun it. A genuinely
        // slower player (lower stat, e.g. 300 vs 369) is caught regardless of
        // movement, since the NPC really is faster.
        fast_enough := c.assigned_player.speed >= c.speed_stat;
        if !moving || !fast_enough {
            c.on_catch();
        }
        return; // in range: hold here, don't overrun/tunnel past the player
    }
    face_along_x(c.entity, diff.x);
    n := normalize(diff);
    c.entity.set_world_position(my_world + n * step);
}

tick_chaser_escorting :: proc(c: Npc_Chaser, dt: float) {
    if c.assigned_player == null { c.state = Npc_Chaser_State.IDLE; return; }
    if !#alive(c.assigned_player.entity) { c.state = Npc_Chaser_State.IDLE; return; }
    if c.home_room == null { c.state = Npc_Chaser_State.IDLE; return; }
    if c.home_room.pedestals.count <= 0 { c.state = Npc_Chaser_State.IDLE; return; }

    p0 := c.home_room.pedestals[0];
    if p0 == null || p0.brainrot_pedestal == null { c.state = Npc_Chaser_State.IDLE; return; }
    target := p0.brainrot_pedestal.world_position;

    my_world := c.entity.world_position;
    diff := target - my_world;
    step := chaser_speed_wu_per_sec(c.speed_stat) * dt;

    // Arrived (already close OR this frame's step would reach/overshoot the
    // target). The overshoot check matters now that per-frame step can exceed
    // the small arrival radius at high speed — without it the NPC oscillates
    // past the pedestal and never places the player.
    dist_sq := length_squared(diff);
    if dist_sq < NPC_ARRIVED_RADIUS_SQ || dist_sq <= step * step {
        c.assigned_player.entity.set_world_position(target);
        remove_effect(c.assigned_player.entity, Catched_By_Npc_Effect, false);
        eff := new(In_Npc_Room_Effect);
        eff.jailer_room = c.home_room;
        c.assigned_player.entity.add_passive_effect(eff);
        c.assigned_player.remove_freeze_reason(NPC_ESCORT_FREEZE_REASON);
        c.state = Npc_Chaser_State.IDLE;
        return;
    }

    face_along_x(c.entity, diff.x);
    n := normalize(diff);
    world_step := n * step;
    c.entity.set_world_position(my_world + world_step);
    c.assigned_player.entity.set_world_position(c.assigned_player.entity.world_position + world_step);
}

collect_chasers_recursive :: proc(r: Room_Npc, e: Entity) {
    current := e.get_first_child();
    while current != null {
        c := current.get_component(Npc_Chaser);
        if c != null {
            append(ref r.chasers, c);
            c.home_room = r;
        }
        collect_chasers_recursive(r, current);
        current = current.get_next_sibling();
    }
}

// Hide/show every renderer in an entity subtree by setting tint alpha. Chase
// logic keeps running on a hidden chaser — only the visual is suppressed.
set_chaser_subtree_visible :: proc(e: Entity, visible: bool) {
    a: float = 0.0;
    if visible a = 1.0;

    sr := e.get_component(Sprite_Renderer);
    if sr != null {
        col := sr.color;
        col.w = a;
        sr.color = col;
    }
    sa := e.get_component(Spine_Animator);
    if sa != null {
        t := sa.get_tint();
        t.w = a;
        sa.set_tint(t);
    }

    current := e.get_first_child();
    while current != null {
        set_chaser_subtree_visible(current, visible);
        current = current.get_next_sibling();
    }
}

// True if this chaser is the one the local client should see for its room:
// the local player's claimed chaser, or slot 0 if they haven't claimed one.
chaser_is_displayed_for_local :: proc(c: Npc_Chaser) -> bool {
    local, has_local := Game.get_local_player();
    if !has_local return false;
    if c.home_room == null return false;
    mine := get_player_chaser_in_room(c.home_room, local);
    if mine != null return mine == c;
    if c.home_room.chasers.count > 0 return c.home_room.chasers[0] == c;
    return false;
}

get_player_chaser_in_room :: proc(r: Room_Npc, player: Player) -> Npc_Chaser {
    if r == null return null;
    if player == null return null;
    for c: r.chasers {
        if c == null continue;
        if c.assigned_player == player return c;
    }
    return null;
}

// Returns the chaser already assigned to player, or grabs the first unassigned
// slot in this room and binds it. Called lazily when a player first enters a
// chase trigger.
claim_or_get_chaser_in_room :: proc(r: Room_Npc, player: Player) -> Npc_Chaser {
    existing := get_player_chaser_in_room(r, player);
    if existing != null return existing;
    if r == null return null;
    for c: r.chasers {
        if c == null continue;
        if c.assigned_player != null continue;
        c.assigned_player = player;
        return c;
    }
    return null;
}

release_chasers_for_player :: proc(player: Player) {
    if player == null return;
    for c: g_npc_chasers {
        if c == null continue;
        if c.assigned_player != player continue;
        c.assigned_player = null;
        c.state = Npc_Chaser_State.IDLE;
    }
}

reset_chasers_for_player :: proc(player: Player) {
    if player == null return;
    for c: g_npc_chasers {
        if c == null continue;
        if c.assigned_player != player continue;
        c.state = Npc_Chaser_State.IDLE;
        if #alive(c.entity) {
            // Snap back home — line crossing should instantly reset, not slow-lerp.
            c.entity.set_world_position(c.home_position);
        }
    }
}

// While a player is jailed (In_Npc_Room_Effect), only the base that jailed
// them is allowed to chase. Before being jailed, any base may chase.
npc_room_may_chase :: proc(player: Player, r: Room_Npc) -> bool {
    e, jailed := get_effect(player.entity, In_Npc_Room_Effect);
    if !jailed return true;
    if e == null return true;
    if e.jailer_room == null return true;
    return e.jailer_room == r;
}



room_npc_on_chase_enter :: proc(listener: Component, player: Player) {
    if listener == null return;
    if player == null return;
    r := listener.(Room_Npc);
    if r == null return;

    // While auto-walking, the last room entered becomes the player's active
    // steal room — the only room they may stay in / steal from. Roof hide is
    // handled client-side in Room_Npc.ao_late_update off this field.
    _, auto_walking := get_effect(player.entity, Moving_Toward_Effect);
    if auto_walking player.active_steal_room = r;

    if !npc_room_may_chase(player, r) return;
    c := claim_or_get_chaser_in_room(r, player);
    start_chase(c, false);
}

room_npc_on_chase_exit :: proc(listener: Component, player: Player) {
    if listener == null return;
    if player == null return;
    r := listener.(Room_Npc);
    if r == null return;

    c := get_player_chaser_in_room(r, player);
    if c == null return;
    if c.state == Npc_Chaser_State.ESCORTING return;

    _, has_catched := get_effect(player.entity, Catched_By_Npc_Effect);
    _, has_in_room := get_effect(player.entity, In_Npc_Room_Effect);
    if !has_catched && !has_in_room {
        c.state = Npc_Chaser_State.IDLE;
    }
    // else: player is a parolee — keep chasing across the border.
}

room_npc_on_jail_exit :: proc(listener: Component, player: Player) {
    if listener == null return;
    if player == null return;
    r := listener.(Room_Npc);
    if r == null return;

    _, has_in_room := get_effect(player.entity, In_Npc_Room_Effect);
    if !has_in_room return;
    if !npc_room_may_chase(player, r) return;

    // Jailbreak — InNpcRoom stays on the player; chaser resumes at the slower
    // re-chase speed. start_chase guards against re-entry mid-chase.
    start_chase(get_player_chaser_in_room(r, player), true);
}

// Return the player's currently-stolen brainrot back to its origin pedestal
// and clear the carry effect. No-op if the player isn't carrying anything.
// Safe to call multiple times — the second call sees no Carry effect and
// short-circuits. Used both when the player gets hit (snap brainrot back as
// instant feedback) and at the end of the punish flow.
return_stolen_brainrot_to_pedestal :: proc(player: Player) {
    if player == null return;
    if !#alive(player.entity) return;
    e, has_steal := get_effect(player.entity, Carry_Brainrot_Stealing_Npc_Effect);
    if !has_steal return;
    if e == null return;

    saved_id: string;
    saved_level: s64 = 1;
    saved_mutation := Mutation.NONE;
    if e.carried != null && #alive(e.carried.entity) {
        saved_id       = e.carried.config_id;
        saved_level    = e.carried.level;
        saved_mutation = e.carried.mutation;
    }

    if e.origin_room != null && #alive(e.origin_room.entity) {
        idx := e.origin_pedestal_index;
        if idx >= 0 && idx < e.origin_room.pedestals.count {
            p := e.origin_room.pedestals[idx];
            if p != null && saved_id.count > 0 {
                configs := get_brainrot_configs();
                for cfg: configs {
                    if cfg.id != saved_id continue;
                    new_le := spawn_npc_brainrot_on_pedestal(p, cfg);
                    if new_le != null {
                        new_le.level    = saved_level;
                        new_le.mutation = saved_mutation;
                        new_le.update_visuals();
                    }
                    break;
                }
            }
            if idx < e.origin_room.pedestal_locked.count {
                e.origin_room.pedestal_locked[idx] = false;
            }
            if idx < e.origin_room.pedestal_timers.count {
                e.origin_room.pedestal_timers[idx] = NPC_SPAWN_INTERVAL;
            }
        }
    }

    if e.carried != null && #alive(e.carried.entity) e.carried.entity.destroy();
    remove_effect(player.entity, Carry_Brainrot_Stealing_Npc_Effect, true);
}

npc_punish_player :: proc(c: Npc_Chaser) {
    if c == null return;
    if c.assigned_player == null return;
    if !#alive(c.assigned_player.entity) return;

    c.assigned_player.active_steal_room = null; // hit re-roofs every room

    // Idempotent — if the hit already returned the brainrot, this is a no-op.
    return_stolen_brainrot_to_pedestal(c.assigned_player);

    // Teleport player back to their own base.
    if c.assigned_player.my_room != null && #alive(c.assigned_player.my_room.entity) {
        c.assigned_player.entity.set_world_position(c.assigned_player.my_room.entity.world_position);
    }

    // Clear effects and unfreeze.
    target_player := c.assigned_player;
    remove_effect(target_player.entity, In_Npc_Room_Effect, false);
    remove_effect(target_player.entity, Catched_By_Npc_Effect, false);
    target_player.remove_freeze_reason(NPC_ESCORT_FREEZE_REASON);

    // Snap all this player's chasers back home — player is teleported away, no
    // one should keep pursuing the empty spot.
    reset_chasers_for_player(target_player);
}
