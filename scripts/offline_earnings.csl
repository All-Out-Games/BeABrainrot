// "Welcome Back!" offline-earnings popup.
//
// While a player is away we accrue cash based on their base's gold-per-second.
// On connect we read the saved last-seen UTC time, compute the AFK window
// (capped at OFFLINE_EARNINGS_CAP_HOURS), and show the popup. The reward is
// only PAID OUT — and the last-seen timestamp only advanced — when the player
// resolves the popup (Claim!, Claim X10, or close). So if they disconnect with
// the popup still open, their last-seen time is preserved and the window simply
// carries into the next session.
//
// NOTE: the 2X Money gamepass intentionally does NOT apply here (we deposit via
// deposit_cash, never collect_pedestal_gold), so offline earnings are never
// doubled by it.

// How far back offline earnings accrue. Tune freely.
OFFLINE_EARNINGS_CAP_HOURS :: 2.0;

// Per-player save key: UTC seconds-since-epoch of the player's last known
// presence. Re-stamped on a heartbeat while the player is active with no
// unresolved popup (see tick_offline_earnings) and on clean disconnect, so a
// server crash mis-accounts at most OFFLINE_HEARTBEAT_SECONDS of offline time.
OFFLINE_LAST_SEEN_KEY :: "offline_last_seen";

// How often, in seconds, we re-stamp the presence clock while a player is
// active. This is the worst-case error a crash can introduce; tiny next to the
// hour-scale earnings window, so 10s is plenty without hammering saves.
OFFLINE_HEARTBEAT_SECONDS :: 10.0;

// Current UTC wall-clock time in seconds since the Unix epoch.
utc_now_seconds :: proc() -> f64 {
    ns := get_nanoseconds_since_epoch();
    return ns.(f64) / 1000000000.0;
}

// How long (seconds) tick_offline_earnings keeps waiting for the base's GPS to
// become known before giving up on this session's popup. Covers the frames
// where the room's pedestals haven't been collected yet (Room.ao_start vs
// Player.ao_start init order) or the brainrot save JSON hasn't replicated.
OFFLINE_ARM_GRACE_SECONDS :: 5.0;

// Hard safety cap on the arm wait when the base HAS saved income but GPS never
// shows up (pathological — claim is normally guaranteed by the ao_update
// retry). Releases the wait so the player isn't stuck; last_seen stays frozen
// so the window carries to the next session.
OFFLINE_ARM_MAX_SECONDS :: 60.0;

// Called once from Player.ao_start. Reads the saved last-seen time and records
// the capped AFK window, but does NOT arm the popup here: player_total_gps is
// frequently still 0 this frame because the room's pedestals/brainrots load a
// beat later. Arming is deferred to tick_offline_earnings, which retries until
// the base's income is actually known. Does NOT advance the saved timestamp —
// that only happens on settle.
compute_offline_earnings :: proc(player: Player) {
    if player == null return;

    // Start every join from a clean slate. The popup is re-derived from the
    // saved last_seen below, so nothing here should depend on leftover in-memory
    // state. Without this, a stale pending flag (from a prior unclaimed session,
    // the test_offline command, or field reuse) would resurface the popup for a
    // player who has no actual offline window.
    player.offline_earnings_pending  = false;
    player.offline_earnings_amount   = 0;
    player.offline_arm_waiting       = false;
    player.offline_arm_elapsed       = 0;
    player.offline_heartbeat_elapsed = 0;
    player.offline_heartbeat_armed   = false;
    player.offline_base_has_income   = false;

    now := utc_now_seconds();
    last := Save.get_f64(player, OFFLINE_LAST_SEEN_KEY, 0);
    log_info("[offline] compute READ: now=% last=% raw_afk=%s", {now, last, now - last});

    // First time we've ever seen this player — initialize the clock and bail.
    // No window to protect, so the heartbeat may run immediately.
    if last <= 0 {
        Save.set_f64(player, OFFLINE_LAST_SEEN_KEY, now);
        player.offline_heartbeat_armed = true;
        log_info("[offline] compute: FIRST-TIME, stamped last_seen=%", {now});
        return;
    }

    afk := (now - last).(float);
    // Rejoined with no real gap — nothing pending, heartbeat may run.
    if afk <= 0 {
        player.offline_heartbeat_armed = true;
        log_info("[offline] compute: NO GAP (afk=%s <= 0), no popup", {afk});
        return;
    }

    cap := OFFLINE_EARNINGS_CAP_HOURS * 3600.0;
    if afk > cap afk = cap;
    log_info("[offline] compute: WINDOW afk=%s (capped=%s) has_income=%", {(now - last).(float), afk, offline_base_has_saved_brainrots(player)});

    // There IS an unclaimed window. Stash it and wait for the base to load, and
    // keep the heartbeat DISARMED so it can't overwrite last_seen until we've
    // resolved the window (armed the popup, or confirmed no income).
    player.offline_afk_seconds     = afk;
    player.offline_arm_elapsed     = 0;
    player.offline_arm_waiting     = true;
    player.offline_heartbeat_armed = false;
    // Read the persisted base directly so we KNOW whether income is owed,
    // independent of whether the room has finished claiming this frame. If the
    // save has brainrots, tick keeps waiting for GPS instead of giving up at
    // the short grace (claim can defer to the ao_update retry on a cold join).
    player.offline_base_has_income = offline_base_has_saved_brainrots(player);
}

// True if the player's persisted base has at least one placed brainrot. Read
// straight from the save (BRAINROTS_SAVE_KEY) so it's valid even before the
// room is claimed and the live pedestals are populated.
offline_base_has_saved_brainrots :: proc(player: Player) -> bool {
    payload: Saved_Brainrots;
    if !Save.try_get_json(player, BRAINROTS_SAVE_KEY, ref payload) return false;
    if payload == null return false;
    return payload.items.count > 0;
}

// Called every frame from Player.ao_update. While we owe an arming attempt,
// poll the base's GPS; the first frame it reads > 0 we arm the popup with the
// final payout. If the base never reports income within the grace window the
// player simply had nothing earning (a zero-income base owes nothing), so we
// stop waiting WITHOUT advancing the last-seen clock.
tick_offline_earnings :: proc(player: Player, dt: float) {
    if player == null return;

    // Phase 1: still resolving the join popup. Poll until the base's GPS is
    // known; the first frame it reads > 0 we arm the popup with the final
    // payout. Give up after the grace window (zero-income base owes nothing).
    if player.offline_arm_waiting {
        gps := player_total_gps(player);
        if gps > 0 {
            // Base confirmed loaded: the window is now resolved (either we arm a
            // popup, or income is too small to bother). Either way it's safe to
            // let the heartbeat run from here.
            player.offline_heartbeat_armed = true;
            earnings := ceil_float(gps * player.offline_afk_seconds);
            log_info("[offline] ARM: gps=% * afk=%s = earnings=%", {gps, player.offline_afk_seconds, earnings});
            if earnings >= 1 {
                player.offline_earnings_amount  = earnings;
                player.offline_earnings_pending = true;
            }
            player.offline_arm_waiting = false;
            return;
        }
        player.offline_arm_elapsed += dt;
        // When the saved base HAS brainrots we know income is owed, so GPS will
        // appear once the room finishes claiming (claim can defer to the
        // ao_update retry, which on a cold join routinely lands after the short
        // grace). Keep waiting until then rather than dropping the window — the
        // bug where long-AFK rejoins showed no popup. A generous hard cap still
        // releases the wait if something is genuinely wrong, leaving last_seen
        // frozen so the window survives to the next session.
        give_up := player.offline_arm_elapsed >= OFFLINE_ARM_MAX_SECONDS;
        if !player.offline_base_has_income {
            give_up = give_up || player.offline_arm_elapsed >= OFFLINE_ARM_GRACE_SECONDS;
        }
        if give_up {
            // Leave the heartbeat DISARMED and last_seen frozen so a window from
            // a base that just loaded slowly survives to the next session
            // instead of being lost.
            player.offline_arm_waiting = false;
        }
        return;
    }

    // While a popup is still unclaimed, keep the presence clock FROZEN so an
    // unclaimed window carries over if the player disconnects.
    if player.offline_earnings_pending return;

    // Only heartbeat once we've positively confirmed there's nothing pending to
    // lose (base loaded, or no window this join). Protects the slow-load case.
    if !player.offline_heartbeat_armed return;

    // Phase 2: settled (claimed/closed) or never had a popup. Heartbeat the
    // presence clock so a crash loses at most OFFLINE_HEARTBEAT_SECONDS of
    // accuracy — no sentinel needed, the next session reads the real last-seen.
    player.offline_heartbeat_elapsed += dt;
    if player.offline_heartbeat_elapsed >= OFFLINE_HEARTBEAT_SECONDS {
        player.offline_heartbeat_elapsed = 0;
        hb := utc_now_seconds();
        Save.set_f64(player, OFFLINE_LAST_SEEN_KEY, hb);
        log_info("[offline] HEARTBEAT WRITE last_seen=%", {hb});
    }
}

// Pay out the offline reward (base amount * multiplier), advance the last-seen
// timestamp, and dismiss the popup. multiplier is 1.0 for Claim!/close, 10.0
// for the Claim X10 purchase. Returns true if a reward was actually settled,
// false if nothing was pending (so the X10 purchase handler can report an
// un-fulfilled grant to the engine and avoid charging sparks for a no-op).
settle_offline_earnings :: proc(player: Player, multiplier: float) -> bool {
    if player == null return false;
    if !player.offline_earnings_pending return false;

    // Advance the presence clock BEFORE paying out. cash (deposit_cash) and
    // last-seen go through the same Save.set_f64 batch so they normally flush
    // together, but writing the timestamp first means any partial-persistence
    // failure (e.g. a server crash mid-flush) errs toward the SAFE direction: at
    // worst the player misses this payout, never the unsafe direction of
    // re-earning the same window on rejoin. The heartbeat keeps it fresh after.
    settle_now := utc_now_seconds();
    Save.set_f64(player, OFFLINE_LAST_SEEN_KEY, settle_now);
    log_info("[offline] SETTLE WRITE last_seen=% (paid %x%)", {settle_now, player.offline_earnings_amount, multiplier});

    amount := player.offline_earnings_amount * multiplier;
    if amount > 0 {
        deposit_cash(player, amount);
        play_offline_claim_sfx(player);
    }

    player.offline_earnings_pending = false;
    player.offline_earnings_amount  = 0;
    return true;
}

// Called from Player.ao_end. Stamp the disconnect time ONLY when there's no
// unresolved popup; otherwise keep the old last-seen so the unclaimed window
// survives the disconnect.
stamp_offline_disconnect :: proc(player: Player) {
    if player == null return;
    if player.offline_earnings_pending {
        log_info("[offline] DISCONNECT: popup pending, last_seen FROZEN");
        return;
    }
    dc := utc_now_seconds();
    Save.set_f64(player, OFFLINE_LAST_SEEN_KEY, dc);
    log_info("[offline] DISCONNECT WRITE last_seen=%", {dc});
}

play_offline_claim_sfx :: proc(player: Player) {
    sfx := get_asset(SFX_Asset, "SFX/Collect_Money.wav");
    if sfx == null return;
    desc := SFX.default_sfx_desc();
    desc.specific_to_player = player;
    desc.positional = false;
    desc.volume = 0.7;
    desc.speed_perturb = 0.05;
    SFX.play(sfx, desc);
}

// Debug: arm the Welcome Back popup with a test amount so the UI can be
// eyeballed without actually going offline.
test_offline :: proc(player: Player) {
    if player == null return;
    player.offline_earnings_amount  = 95100000000000.0; // ~95.1T for layout testing
    player.offline_earnings_pending = true;
} @chat_command

// Debug: rewind the saved last-seen by 3 hours and re-run the join-time offline
// computation, so the REAL compute -> arm -> popup path fires without having to
// actually disconnect for hours. If the popup shows after this, the offline
// logic is fine and the problem is that your disconnect isn't registering (the
// clock never froze). If it does NOT show, the bug is in compute/tick/draw.
// unit: "h" hours (default), "m" minutes, "s" seconds. e.g. /sim_offline 90 m
sim_offline :: proc(player: Player, amount: float = 3.0, unit: string = "h") {
    if player == null return;
    factor: float = 3600.0;
    if unit == "m" {
        factor = 60.0;
    } else if unit == "s" {
        factor = 1.0;
    }
    target := utc_now_seconds() - (amount * factor).(f64);
    Save.set_f64(player, OFFLINE_LAST_SEEN_KEY, target);
    log_info("[offline] SIM WRITE last_seen=% (%0%s back)", {target, amount * factor});
    compute_offline_earnings(player);
} @chat_command @owner_or_editor

// Debug: dump the live offline-earnings clock to the log so we can see the real
// numbers (now, last_seen, computed afk, whether the base/room are loaded).
offline_status :: proc(player: Player) {
    if player == null return;
    now  := utc_now_seconds();
    last := Save.get_f64(player, OFFLINE_LAST_SEEN_KEY, 0);
    has_income: s64 = offline_base_has_saved_brainrots(player) ? 1 : 0;
    room_null:  s64 = (player.my_room == null) ? 1 : 0;
    pending:    s64 = player.offline_earnings_pending ? 1 : 0;
    waiting:    s64 = player.offline_arm_waiting ? 1 : 0;
    log_info("[offline] now=% last=% afk_now=%s frozen_afk=%s gps=% amount=% has_income=% room_null=% pending=% waiting=% arm_elapsed=%",
        {now, last, now - last, player.offline_afk_seconds, player_total_gps(player), player.offline_earnings_amount, has_income, room_null, pending, waiting, player.offline_arm_elapsed});
} @chat_command @owner_or_editor

// ===== UI =====

OFFLINE_MAT_SHELL: Material;
OFFLINE_MAT_CLAIM: Material; // green "Claim!"
OFFLINE_MAT_X10:   Material; // magenta "Claim X10"
OFFLINE_MATS_READY: bool;

offline_ensure_materials :: proc() -> bool {
    if OFFLINE_MATS_READY return true;

    // Semi-transparent black shell with a thick opaque black outline (the game
    // world shows faintly through the fill; the border reads crisp against it).
    shell_box := shop2_box_dark();
    shell_box.top           = v4{0.0, 0.0, 0.0, 0.95};
    shell_box.bottom        = v4{0.0, 0.0, 0.0, 0.95};
    shell_box.band_h        = 0.0;
    shell_box.band_color    = v4{0, 0, 0, 0};
    shell_box.dot_alpha     = 0.0;
    shell_box.corner_radius = 24.0;
    shell_box.outline_px    = 8.0;
    shell_box.outline_color = v4{0, 0, 0, 1};

    OFFLINE_MAT_SHELL = shop3_make_box_material(shell_box);
    OFFLINE_MAT_CLAIM = shop3_make_box_material(shop2_box_green());
    OFFLINE_MAT_X10   = shop3_make_box_material(shop2_box_purple());

    if OFFLINE_MAT_SHELL == null return false; // shader still loading

    OFFLINE_MATS_READY = true;
    return true;
}

// A big bottom-row button: label, the exact cash payout, and an optional
// spark-price badge (used for the X10 button). The whole panel is the click
// target.
offline_button :: proc(id: string, mat: Material, label: string, amount_text: string, price: s64) -> Interact_Result {
    btn := UIK.layout_column();
    btn.width                        = UIK.flex(1);
    btn.height                       = UIK.flex(1);
    btn.gap                          = 1;
    btn.main_align                   = .CENTER;
    btn.cross_align                  = .CENTER;
    btn.padding                      = v4{6, 10, 6, 10};
    btn.show_background              = true;
    btn.tint                         = v4{1, 1, 1, 1};
    btn.background_sprite_override    = core_globals.white_sprite;
    btn.background_material_override  = mat;
    h := UIK.panel_begin_interactive(id, btn);
    shop3_feed_rect(mat, h.rect);
    mat.set_float("press", h.active_t_eased);

    // Line 1: label, plus the spark price inline to its right (X10 only).
    top := UIK.layout_row();
    top.width       = UIK.fit();
    top.height      = UIK.fit();
    top.gap         = 8;
    top.cross_align = .CENTER;
    top.main_align  = .CENTER;
    UIK.panel_begin(top);
    lt := UIK.text_title();
    lt.set_size_mult(0.95);
    lt.set_word_wrap(false);
    lt.set_outline(true, 3.5, v4{0, 0, 0, 1});
    UIK.text(label, lt);
    if price > 0 {
        spark := get_asset(Texture_Asset, "$AO/new/icons/sparks/spark_icon.png");
        if spark != null {
            sh := UIK.layout_centered(UIK.pixels(28), UIK.pixels(28));
            UIK.panel_begin(sh);
            UIK.image_fitted(spark, UIK.image_desc(.CONTAIN));
            UIK.panel_end();
        }
        pt := UIK.text_title();
        pt.set_size_mult(0.8);
        pt.set_outline(true, 3.0, v4{0, 0, 0, 1});
        UIK.text(format_string("%", {price}), pt);
    }
    UIK.panel_end(); // top

    // Line 2: the exact cash payout.
    if amount_text.count > 0 {
        at := UIK.text_title();
        at.set_size_mult(0.72);
        at.set_color({1, 1, 1, 1});
        at.set_word_wrap(false);
        at.set_outline(true, 3.0, v4{0, 0, 0, 1});
        UIK.text(amount_text, at);
    }

    UIK.panel_end();
    return h;
}

draw_offline_earnings :: proc(player: Player) {
    if player == null return;
    if !player.offline_earnings_pending return;
    if !offline_ensure_materials() return; // shaders still loading

    modal_rect := UI.get_safe_screen_rect().center_rect().grow(330, 490, 330, 490);
    UIK.begin(UIK.modal(modal_rect, 35));

    shell := UIK.panel_modal(.BLACK);
    shell.gap                        = 0;
    shell.show_background             = true;
    shell.tint                       = v4{1, 1, 1, 1};
    shell.background_sprite_override   = core_globals.white_sprite;
    shell.background_material_override = OFFLINE_MAT_SHELL;
    shell_h := UIK.panel_begin_interactive("offline_shell", shell);
    shop3_feed_rect(OFFLINE_MAT_SHELL, shell_h.rect);

    title_desc := UIK.title_area_desc("Welcome Back!");
    title_desc.tint = v4{0.26, 0.66, 1.0, 1}; // bright blue banner (recolors the grey)
    title_desc.icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/clock/clock_icon.png");
    exit_h := UIK.title_area(title_desc);

    body := UIK.layout_column();
    body.width       = UIK.flex(1);
    body.height      = UIK.flex(1);
    body.padding     = v4{18, 22, 26, 22};
    body.gap         = 8;
    body.cross_align = .CENTER;
    UIK.panel_begin(body);

    // Heading.
    head := UIK.text_title();
    head.set_size_mult(1.15);
    head.set_word_wrap(false);
    head.set_outline(true, 4.0, v4{0, 0, 0, 1});
    UIK.text("OFFLINE EARNINGS:", head);

    // Hero reward icon.
    hero := get_asset(Texture_Asset, "Textures/UI/gold_coin_stacks_c55048.png");
    hero_holder := UIK.layout_centered(UIK.flex(1), UIK.pixels(190));
    UIK.panel_begin(hero_holder);
    if hero != null UIK.image_fitted(hero, UIK.image_desc(.CONTAIN));
    UIK.panel_end();

    // Amount line: big orange figure, centered across the body width.
    amount_row := UIK.layout_row();
    amount_row.width       = UIK.flex(1);
    amount_row.height      = UIK.pixels(70);
    amount_row.gap         = 10;
    amount_row.cross_align = .CENTER;
    amount_row.main_align  = .CENTER;
    UIK.panel_begin(amount_row);

    amt := UIK.text_title();
    amt.set_size_mult(1.2);
    amt.set_color({1.0, 0.78, 0.16, 1});
    amt.set_word_wrap(false);
    amt.set_outline(true, 4.0, v4{0.25, 0.12, 0.0, 1});
    UIK.text(format_cash(player.offline_earnings_amount), amt);
    UIK.panel_end(); // amount_row

    UIK.spacer(UIK.pixels(1), UIK.flex(1));

    // Buttons: Claim X10 (magenta, 79 sparks) + Claim! (green).
    btn_row := UIK.layout_row();
    btn_row.width      = UIK.flex(1);
    btn_row.height     = UIK.pixels(118);
    btn_row.gap        = 18;
    btn_row.main_align = .CENTER;
    UIK.panel_begin(btn_row);
    base := player.offline_earnings_amount;
    x10_price := Purchasing.get_product(OFFLINE_EARNINGS_X10_PRODUCT_ID).price;
    x10_h   := offline_button("offline_x10",   OFFLINE_MAT_X10,   "Claim X10", format_cash(base * 10.0), x10_price);
    claim_h := offline_button("offline_claim", OFFLINE_MAT_CLAIM, "Claim!",    format_cash(base),        0);
    UIK.panel_end(); // btn_row

    UIK.panel_end(); // body
    UIK.panel_end(); // shell
    UIK.end();

    // Resolve. Claim!/X pay out the base reward and settle. Claim X10 only
    // PROMPTS the purchase — the popup stays open until the purchase completes
    // (handled in ao_purchase_handler), so a cancelled buy still lets them claim.
    if UIK.clicked(exit_h) || UIK.clicked(claim_h) {
        settle_offline_earnings(player, 1.0);
        return;
    }
    if UIK.clicked(x10_h) {
        Purchasing.prompt_purchase(player, OFFLINE_EARNINGS_X10_PRODUCT_ID);
    }
}
