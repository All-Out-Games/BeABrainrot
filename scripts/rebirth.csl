// Generic rebirth system.
//
// Each Rebirth_Level holds:
//   - required_cash:   the cost (in cash) the player must hit to perform the rebirth
//   - rewards:         a list of typed rewards
//
// Rebirth_Reward is intentionally generic:
//   - stat_id + mult_add  -> contributes to the player's cumulative multiplier for that stat
//                            (e.g. stat_id="money" adds money earnings; stat_id="strength"
//                            would just work the same way once you query it)
//   - grant_cash          -> one-time cash bonus given on rebirth completion
//   - label / icon_path   -> UI display
//
// Querying multipliers from gameplay:
//   mult := get_rebirth_multiplier(player, "money");
//   final := raw_amount * mult;

Rebirth_Reward :: class {
    stat_id:        string; // empty if this reward is not a multiplier
    mult_add:       float;  // additive contribution to that stat's multiplier
    grant_cash:     float;  // one-time cash grant
    grant_pedestals: s64;   // permanent pedestal-slot unlock count
    label:          string;
    icon_path:      string;
}

Rebirth_Level :: class {
    level:          s64;
    required_speed: s64;
    required_cash:  float;
    rewards:        [..]Rebirth_Reward;
}

ALL_REBIRTH_LEVELS: [..]Rebirth_Level;

register_rebirth_level :: proc(level: s64, required_speed: s64, required_cash: float = 0) -> Rebirth_Level {
    lvl := new(Rebirth_Level);
    lvl.level          = level;
    lvl.required_speed = required_speed;
    lvl.required_cash  = required_cash;
    append(ref ALL_REBIRTH_LEVELS, lvl);
    return lvl;
}

add_rebirth_multiplier :: proc(lvl: Rebirth_Level, stat_id: string, mult_add: float, label: string, icon_path: string = "") {
    r := new(Rebirth_Reward);
    r.stat_id   = stat_id;
    r.mult_add  = mult_add;
    r.label     = label;
    r.icon_path = icon_path;
    append(ref lvl.rewards, r);
}

add_rebirth_cash_grant :: proc(lvl: Rebirth_Level, amount: float, label: string, icon_path: string = "") {
    r := new(Rebirth_Reward);
    r.grant_cash = amount;
    r.label      = label;
    r.icon_path  = icon_path;
    append(ref lvl.rewards, r);
}

add_rebirth_pedestal_grant :: proc(lvl: Rebirth_Level, amount: s64, label: string, icon_path: string = "") {
    r := new(Rebirth_Reward);
    r.grant_pedestals = amount;
    r.label           = label;
    r.icon_path       = icon_path;
    append(ref lvl.rewards, r);
}

get_rebirth_level :: proc(level: s64) -> Rebirth_Level {
    for l: ALL_REBIRTH_LEVELS {
        if l.level == level return l;
    }
    return null;
}

get_max_rebirth_level :: proc() -> s64 {
    if ALL_REBIRTH_LEVELS.count == 0 return 0;
    return ALL_REBIRTH_LEVELS[ALL_REBIRTH_LEVELS.count - 1].level;
}

// Cumulative multiplier from all completed rebirths (0..player.rebirth_level - 1).
get_rebirth_multiplier :: proc(player: Player, stat_id: string) -> float {
    total: float = 0;
    i: s64 = 0;
    while i < player.rebirth_level {
        lvl := get_rebirth_level(i);
        if lvl != null {
            for r: lvl.rewards {
                if r.stat_id == stat_id total += r.mult_add;
            }
        }
        i += 1;
    }
    return 1.0 + total;
}

// Multiplier you would have AFTER performing the next rebirth.
get_rebirth_multiplier_after_next :: proc(player: Player, stat_id: string) -> float {
    cur := get_rebirth_multiplier(player, stat_id);
    nxt := get_rebirth_level(player.rebirth_level);
    if nxt == null return cur;
    for r: nxt.rewards {
        if r.stat_id == stat_id cur += r.mult_add;
    }
    return cur;
}

REBIRTH_SAVE_KEY :: "rebirth_level";

can_rebirth :: proc(player: Player) -> bool {
    nxt := get_rebirth_level(player.rebirth_level);
    if nxt == null return false;
    if player.speed < nxt.required_speed return false;
    if player.cash < nxt.required_cash return false;
    return true;
}

do_rebirth :: proc(player: Player, force: bool = false) -> bool {
    nxt := get_rebirth_level(player.rebirth_level);
    if nxt == null return false;
    if !force && player.speed < nxt.required_speed return false;
    if !force && player.cash < nxt.required_cash return false;

    grant_total: float = 0;
    pedestal_total: s64 = 0;
    for r: nxt.rewards {
        if r.grant_cash > 0 grant_total += r.grant_cash;
        if r.grant_pedestals > 0 pedestal_total += r.grant_pedestals;
    }

    // Reset stats — only on the free rebirth. The paid skip keeps both
    // cash and speed so the player isn't double-punished after spending sparks.
    // Speed resets to BASE_SPEED + purchased_speed so any sparks-bought speed
    // sticks across rebirths.
    if !force {
        player.cash = 0;
        player.displayed_cash = 0;
        Save.set_f64(player, CASH_SAVE_KEY, 0);
        set_speed(player, BASE_SPEED + player.purchased_speed);
    }

    // Advance level
    player.rebirth_level += 1;
    Save.set_int(player, REBIRTH_SAVE_KEY, player.rebirth_level);

    // Grant cash directly (bypass deposit_cash so it's not multiplied again)
    if grant_total > 0 {
        player.cash += grant_total;
        Save.set_f64(player, CASH_SAVE_KEY, player.cash.(f64));
        push_cash_popup(player, grant_total, false);
    }

    // Permanent pedestal-slot unlocks.
    if pedestal_total > 0 {
        player.pedestals_unlocked += pedestal_total;
        Save.set_int(player, PEDESTALS_SAVE_KEY, player.pedestals_unlocked);
        if player.my_room != null player.my_room.refresh_pedestal_unlocks();
    }

    Notifier.notify(player, "Rebirth %!", {player.rebirth_level});
    return true;
}

// ----- Default progression. Tune freely; the system doesn't care about specific stat ids. -----

register_default_rebirth_levels :: proc() {
    // Each level requires the player to upgrade their speed stat past a
    // threshold AND hold enough cash. +0.5x money multiplier per level,
    // +1 pedestal slot. Cash gate grows geometrically so each rebirth is a
    // real commitment, not just a free upgrade once you reach the speed.
    i: s64 = 0;
    while i < 25 {
        required_speed: s64 = BASE_SPEED + (i + 1) * 2;
        required_cash: float = 5000.0 * pow(2.4, (i + 1).(float));
        lvl := register_rebirth_level(i, required_speed, required_cash);
        add_rebirth_multiplier(lvl, "money", 0.5, "+0.5x money");
        add_rebirth_pedestal_grant(lvl, 1, "+1 Pedestal");
        i += 1;
    }
}

// ----- UI -----

// Custom-shader materials for the two preview cards — same box_panel.aosl
// pattern shop_v3 uses. Each interactive panel needs its own material so the
// rect_px uniform doesn't get clobbered between draws.
REBIRTH_MAT_SHELL:      Material;
REBIRTH_MAT_GREEN:      Material;
REBIRTH_MAT_YELLOW:     Material;
REBIRTH_MAT_BTN_RED:    Material;
REBIRTH_MAT_BTN_PURPLE: Material;
REBIRTH_MATS_READY:     bool;

rebirth_make_box_material :: proc(box: Shop2_Box) -> Material {
    shader := get_asset(Shader_Asset, "shaders/box_panel.aosl");
    if shader == null return null;
    mat := Material.create(shader);
    mat.set_float4("top_color",         box.top);
    mat.set_float4("bottom_color",      box.bottom);
    mat.set_float ("dot_cell_px",       box.dot_cell);
    mat.set_float ("dot_min_radius",    box.dot_min_radius);
    mat.set_float ("dot_max_radius",    box.dot_max_radius);
    mat.set_float ("dot_alpha",         box.dot_alpha);
    mat.set_float ("bottom_band_h",     box.band_h);
    mat.set_float4("bottom_band_color", box.band_color);
    mat.set_float ("outline_px",        box.outline_px);
    mat.set_float4("outline_color",     box.outline_color);
    mat.set_float ("corner_radius_px",  box.corner_radius);
    mat.set_float ("rainbow_strength",  box.rainbow);
    mat.set_float ("rainbow_speed",     box.rainbow_speed);
    mat.set_float ("rainbow_hue_span",  box.rainbow_hue_span);
    mat.set_float ("shine_strength",    0.0);
    mat.set_float ("shine_speed",       1.0);
    return mat;
}

rebirth_ensure_materials :: proc() -> bool {
    if REBIRTH_MATS_READY return true;

    // Red button: default band color is also red/pink, so it disappears against
    // the red body. Give it a dark maroon band so it actually reads.
    red_box := shop2_box_red();
    red_box.band_color = v4{0.30, 0.04, 0.04, 1};

    // Shell: deep indigo gradient with a subtle halftone, themed for the
    // "premium / magic" feel of rebirth without competing with the cards.
    shell_box := shop2_box_dark();
    shell_box.top            = v4{0.14, 0.12, 0.26, 1};
    shell_box.bottom         = v4{0.06, 0.05, 0.12, 1};
    shell_box.dot_cell       = 28.0;
    shell_box.dot_min_radius = 0.0;
    shell_box.dot_max_radius = 0.22;
    shell_box.dot_alpha      = 0.08;
    shell_box.band_color     = v4{0.55, 0.45, 0.95, 1};
    shell_box.band_h         = 0.0;
    shell_box.corner_radius  = 24.0;
    shell_box.outline_px     = 4.0;

    REBIRTH_MAT_SHELL      = rebirth_make_box_material(shell_box);
    REBIRTH_MAT_GREEN      = rebirth_make_box_material(shop2_box_green());
    REBIRTH_MAT_YELLOW     = rebirth_make_box_material(shop2_box_yellow());
    REBIRTH_MAT_BTN_RED    = rebirth_make_box_material(red_box);
    REBIRTH_MAT_BTN_PURPLE = rebirth_make_box_material(shop2_box_purple());
    if REBIRTH_MAT_GREEN == null return false; // shader still loading

    // Skip Rebirth is the paid-conversion button — enable the diagonal shine
    // sweep to make it stand out and pull the eye away from the free option.
    REBIRTH_MAT_BTN_PURPLE.set_float("shine_strength", 1.0);
    REBIRTH_MAT_BTN_PURPLE.set_float("shine_speed",    1.2);

    REBIRTH_MATS_READY = true;
    return true;
}

rebirth_feed_rect :: proc(mat: Material, r: Rect) {
    if mat == null return;
    mat.set_float4("rect_px", v4{r.min.x, r.min.y, r.max.x, r.max.y});
}

// Shader-backed button — matches the preview card look (box_panel.aosl gradient
// + dots + outline + bottom band) with built-in press darkening via the
// `press` uniform fed from active_t_eased. Renders as `pre_label [icon] label`
// (any of those three are optional) so the Skip button can read "Skip ⚡ 95".
rebirth_shader_button :: proc(id: string, label: string, mat: Material, disabled: bool = false, icon: Texture_Asset = null, pre_label: string = "") -> Interact_Result {
    btn := UIK.layout_row();
    btn.width                       = UIK.pixels(220);
    btn.height                      = UIK.flex(1);
    btn.gap                         = 6;
    btn.main_align                  = .CENTER;
    btn.cross_align                 = .CENTER;
    btn.show_background              = true;
    btn.tint                        = v4{1, 1, 1, 1};
    btn.background_sprite_override   = core_globals.white_sprite;
    btn.background_material_override = mat;
    h := UIK.panel_begin_interactive(id, btn, disabled);
    rebirth_feed_rect(mat, h.rect);
    mat.set_float("press", h.active_t_eased);
    if pre_label.count > 0 UIK.text(pre_label, UIK.text_button());
    if icon != null {
        icon_holder := UIK.layout_centered(UIK.pixels(28), UIK.pixels(28));
        UIK.panel_begin(icon_holder);
        UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
        UIK.panel_end();
    }
    if label.count > 0 UIK.text(label, UIK.text_button());
    UIK.panel_end();
    return h;
}

draw_rebirth_modal :: proc(player: Player) {
    if !player.show_rebirth_modal return;
    if !rebirth_ensure_materials() return;

    // Compact, content-sized modal (the old rect_window() was 880x1300).
    // grow args are (top, right, bottom, left) — so this is ~920 wide x 580 tall.
    modal_rect := UI.get_safe_screen_rect().center_rect().grow(290, 460, 290, 460);
    UIK.begin(UIK.modal(modal_rect, 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap                        = 0;
    shell.show_background              = true;
    shell.tint                       = v4{1, 1, 1, 1};
    shell.background_sprite_override   = core_globals.white_sprite;
    shell.background_material_override = REBIRTH_MAT_SHELL;
    shell_h := UIK.panel_begin_interactive("rebirth_shell", shell);
    rebirth_feed_rect(REBIRTH_MAT_SHELL, shell_h.rect);

    exit_h := UIK.title_area(UIK.title_area_desc("REBIRTH"));

    body := UIK.layout_column();
    body.width  = UIK.flex(1);
    body.height = UIK.flex(1);
    body.padding = v4{18, 16, 18, 16};
    body.gap = 14;
    body.cross_align = .CENTER;
    UIK.panel_begin(body);

    warning := UIK.text_body();
    warning.set_color({1.0, 0.65, 0.65, 1});
    warning.set_word_wrap(false);
    UIK.text("[Warning] Rebirth resets your speed & cash!", warning);

    // Spacer above the middle group — keeps the warning anchored near the top.
    UIK.spacer(UIK.pixels(1), UIK.flex(1));

    // ----- Current vs next preview row with arrow -----
    cur_mult  := get_rebirth_multiplier(player, "money");
    next_mult := get_rebirth_multiplier_after_next(player, "money");

    preview := UIK.layout_row();
    preview.width  = UIK.flex(1);
    preview.height = UIK.pixels(120);
    preview.gap = 10;
    preview.cross_align = .CENTER;
    preview.main_align = .CENTER;
    UIK.panel_begin(preview);

    money_icon := get_asset(Texture_Asset, "money_stack_1_f9a568.png");
    arrow_icon := get_asset(Texture_Asset, "arrow_right_e47b99.png");

    draw_rebirth_preview_card(format_string("Rebirth %", {player.rebirth_level}),     format_string("%0x Money", {format_float(cur_mult,  decimals=1)}), REBIRTH_MAT_GREEN, "rebirth_card_cur", money_icon);

    arrow_holder := UIK.layout_centered(UIK.pixels(50), UIK.flex(1));
    UIK.panel_begin(arrow_holder);
    if arrow_icon != null {
        UIK.image_fitted(arrow_icon, UIK.image_desc(.CONTAIN));
    } else {
        arrow_desc := UIK.text_title();
        UIK.text(">", arrow_desc);
    }
    UIK.panel_end();

    draw_rebirth_preview_card(format_string("Rebirth %", {player.rebirth_level + 1}), format_string("%0x Money", {format_float(next_mult, decimals=1)}), REBIRTH_MAT_YELLOW, "rebirth_card_next", money_icon);

    UIK.panel_end(); // preview

    // ----- Progress bars: speed / required and cash / required -----
    nxt := get_rebirth_level(player.rebirth_level);
    if nxt != null {
        speed_progress := player.speed.(float) / nxt.required_speed.(float);
        if speed_progress > 1.0 speed_progress = 1.0;
        if speed_progress < 0.0 speed_progress = 0.0;
        speed_bar_color := v4{0.25, 0.65, 1.0, 1};
        if speed_progress >= 1.0 speed_bar_color = v4{0.2, 0.85, 0.35, 1};
        draw_rebirth_bar(speed_progress, speed_bar_color,
            format_string("Speed: %0 / %", {player.speed, nxt.required_speed}));

        cash_progress: float = 1.0;
        if nxt.required_cash > 0 {
            cash_progress = player.cash / nxt.required_cash;
            if cash_progress > 1.0 cash_progress = 1.0;
            if cash_progress < 0.0 cash_progress = 0.0;
        }
        cash_bar_color := v4{1.0, 0.78, 0.20, 1};
        if cash_progress >= 1.0 cash_bar_color = v4{0.2, 0.85, 0.35, 1};
        draw_rebirth_bar(cash_progress, cash_bar_color,
            format_string("Cash: % / %", {format_cash(player.cash), format_cash(nxt.required_cash)}));
    }

    // Spacer below the bar — pushes the buttons to the bottom of the modal.
    UIK.spacer(UIK.pixels(1), UIK.flex(1));

    // ----- Buttons row -----
    btn_row := UIK.layout_row();
    btn_row.width  = UIK.flex(1);
    btn_row.height = UIK.pixels(64);
    btn_row.gap = 24;
    btn_row.main_align = .CENTER;
    UIK.panel_begin(btn_row);

    rebirth_h := rebirth_shader_button("rebirth_confirm", "Rebirth", REBIRTH_MAT_BTN_RED, !can_rebirth(player));

    // Skip button — paid alternative. Shows the spark price for the upcoming
    // rebirth tier and triggers Purchasing.prompt_purchase on click.
    skip_target_level := player.rebirth_level + 1;
    skip_product_id   := skip_rebirth_product_id_for_level(skip_target_level);
    skip_price: s64   = 0;
    if skip_product_id.count > 0 skip_price = Purchasing.get_product(skip_product_id).price;
    spark_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/sparks/spark_medium.png");
    skip_h    := rebirth_shader_button("rebirth_skip", format_string("%", {skip_price}), REBIRTH_MAT_BTN_PURPLE, skip_product_id.count == 0, spark_tex, "Skip");

    UIK.panel_end(); // btn_row
    UIK.panel_end(); // body
    UIK.panel_end(); // shell
    UIK.end();

    if UIK.clicked(exit_h) {
        player.show_rebirth_modal = false;
        return;
    }
    if UIK.clicked(rebirth_h) {
        if !do_rebirth(player) {
            Notifier.notify(player, "Not enough speed for rebirth!");
        }
    }
    if UIK.clicked(skip_h) {
        if skip_product_id.count > 0 Purchasing.prompt_purchase(player, skip_product_id);
    }
}

REBIRTH_BAR_HEIGHT   :: 46.0;
REBIRTH_BAR_OUTLINE  :: 4.0;

// Manual progress bar — black outline border (outer panel + padding), a dark
// inner track, and a flex-weighted colored fill with a subtle lighter top edge.
// More reliable than UIK.progress_bar against the shader-backed modal shell
// (the widget's track/fill sprites weren't rendering there).
draw_rebirth_bar :: proc(progress: float, fill_color: v4, label: string) {
    p := progress;
    if p < 0.0 p = 0.0;
    if p > 1.0 p = 1.0;

    // Outer black border — its padding becomes the outline thickness.
    outer := UIK.layout_row();
    outer.width                       = UIK.flex(1);
    outer.height                      = UIK.pixels(REBIRTH_BAR_HEIGHT);
    outer.padding                     = v4{REBIRTH_BAR_OUTLINE, REBIRTH_BAR_OUTLINE, REBIRTH_BAR_OUTLINE, REBIRTH_BAR_OUTLINE};
    outer.show_background              = true;
    outer.tint                        = v4{0, 0, 0, 1};
    outer.background_sprite_override   = core_globals.white_sprite;
    UIK.panel_begin(outer);

    // Inner dark track.
    inner := UIK.layout_row();
    inner.width                       = UIK.flex(1);
    inner.height                      = UIK.flex(1);
    inner.show_background              = true;
    inner.tint                        = v4{0.08, 0.08, 0.13, 1};
    inner.background_sprite_override   = core_globals.white_sprite;
    UIK.panel_begin(inner);

    // Filled portion (flex weight = p), then the empty remainder (flex 1-p).
    if p > 0.001 {
        fill := UIK.layout_column();
        fill.width                       = UIK.flex(p);
        fill.height                      = UIK.flex(1);
        fill.show_background              = true;
        fill.tint                        = fill_color;
        fill.background_sprite_override   = core_globals.white_sprite;
        UIK.panel_begin(fill);
        // Lighter highlight strip along the top of the fill for a glossy look.
        hi := UIK.layout_row();
        hi.width                       = UIK.flex(1);
        hi.height                      = UIK.pixels(8);
        hi.show_background              = true;
        hi.tint                        = v4{1, 1, 1, 0.28};
        hi.background_sprite_override   = core_globals.white_sprite;
        UIK.panel_begin(hi);
        UIK.panel_end();
        UIK.panel_end(); // fill
    }
    if p < 0.999 {
        UIK.spacer(UIK.flex(1.0 - p), UIK.flex(1));
    }

    UIK.panel_end(); // inner

    UIK.overlay_begin(.CENTER, {0, 0});
    lbl := UIK.text_body();
    lbl.set_word_wrap(false);
    lbl.set_outline(true, 3.0, {0, 0, 0, 1});
    UIK.text(label, lbl);
    UIK.overlay_end();

    UIK.panel_end(); // outer
}

draw_rebirth_preview_card :: proc(title: string, body_label: string, bg_mat: Material, panel_id: string, icon: Texture_Asset = null) {
    col := UIK.layout_column();
    col.width  = UIK.flex(1);
    col.height = UIK.flex(1);
    col.gap = 6;
    col.cross_align = .CENTER;
    UIK.panel_begin(col);

    UIK.text(title, UIK.text_button());

    card := UIK.layout_row();
    card.width  = UIK.flex(1);
    card.height = UIK.flex(1);
    card.padding = v4{6, 10, 6, 10};
    card.gap = 6;
    card.main_align = .CENTER;
    card.cross_align = .CENTER;
    card.show_background              = true;
    card.tint                         = v4{1, 1, 1, 1};
    card.background_sprite_override   = core_globals.white_sprite;
    card.background_material_override = bg_mat;
    h := UIK.panel_begin_interactive(panel_id, card);
    rebirth_feed_rect(bg_mat, h.rect);

    if icon != null {
        icon_holder := UIK.layout_centered(UIK.pixels(32), UIK.pixels(32));
        UIK.panel_begin(icon_holder);
        UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
        UIK.panel_end();
    }

    UIK.text(body_label, UIK.text_button());

    UIK.panel_end();

    UIK.panel_end();
}

// Chat command for testing.
rebirth_cmd :: proc(player: Player) {
    player.show_rebirth_modal = !player.show_rebirth_modal;
} @chat_command

set_rebirth :: proc(player: Player, level: s64 = 0) {
    if player == null return;
    if level < 0 level = 0;
    max := get_max_rebirth_level();
    if level > max + 1 level = max + 1;
    player.rebirth_level = level;
    Save.set_int(player, REBIRTH_SAVE_KEY, level);
    mult := get_rebirth_multiplier(player, "money");
    Notifier.notify(player, "Rebirth set to % (%0x money)", {level, format_float(mult, decimals=1)});
} @chat_command
