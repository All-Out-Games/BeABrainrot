COLLECT_RANGE_SQ        :: 0.64;  // 0.8 world units, squared
UPGRADE_PROMPT_RANGE_SQ :: 6.25;  // 2.5 world units, squared
WORLD_UI_SCALE          :: 0.00926; // 5/540, matches C# reference
CLAIM_COOLDOWN_SECONDS  :: 1.0;

BRAINROT_PREFAB_PATH    :: "Brainrot.prefab";

PEDESTALS_SAVE_KEY         :: "pedestals_unlocked";
DEFAULT_PEDESTALS_UNLOCKED :: 10;

TEMPLATE_FONT: Font_Asset;

get_template_font :: proc() -> Font_Asset {
    if TEMPLATE_FONT == null {
        TEMPLATE_FONT = get_asset(Font_Asset, "$AO/fonts/Barlow-Black.ttf");
    }
    return TEMPLATE_FONT;
}

// Copy the pedestal's floor onto the placed brainrot so the Floor_Manager
// fades them in lockstep.
sync_brainrot_floor_to_pedestal :: proc(le: LivingEntity, pedestal: Pedestal) {
    if le == null || pedestal == null return;
    if le.floor_renderer == null || pedestal.floor_renderer == null return;
    le.floor_renderer.floor = pedestal.floor_renderer.floor;
    le.floor_renderer.apply_layer();
}

Pedestal :: class : Interactable {
    brainrot_pedestal: Entity @ao_serialize;
    money_entity: Entity @ao_serialize;
    floor_renderer: Floor_Renderer @ao_serialize;

    placed_brainrot: LivingEntity;
    accumulated_gold: f64;
    claim_cooldown: float;
    gps_tick_timer: float;
    room: Room;

    ao_start :: method() {
        this.set_listener(this);
        this.set_text("Place");
    }

    can_use :: method(player: Player) -> bool {
        if room == null return false;
        if !#alive(room.owner) return false;
        if room.owner != player return false;
        if floor_renderer != null && player.current_floor != floor_renderer.floor return false;
        if placed_brainrot != null && #alive(placed_brainrot.entity) return false;
        if is_carrying(player) return true;
        if player.selected_brainrot_item != null && #alive(player.selected_brainrot_item) return true;
        return false;
    }

    on_interact :: method(player: Player) {
        log_info("Pedestal.on_interact: carried=% selected=% slot_filled=%", {
            is_carrying(player),
            #alive(player.selected_brainrot_item),
            placed_brainrot != null && #alive(placed_brainrot.entity),
        });
        if placed_brainrot != null && #alive(placed_brainrot.entity) return;
        if room == null || room.owner != player return;

        carried := get_carried_brainrot(player);
        if carried != null {
            br := carried;
            remove_effect(player.entity, Carry_Brainrot_Effect_2, false);
            br.pedestal = this;
            br.owner = player;
            br.state = Brainrot_State.CLAIMED_IN_BASE;
            if brainrot_pedestal != null {
                br.entity.set_local_position(brainrot_pedestal.world_position);
                br.entity.mark_teleported();
            }
            placed_brainrot = br;
            sync_brainrot_floor_to_pedestal(br, this);
            log_info("Placed from carry: %", {br.display_name});
            save_room_brainrots(player, room);
            return;
        }

        if player.selected_brainrot_item != null && #alive(player.selected_brainrot_item) {
            ok := place_brainrot_from_item(this, player, player.selected_brainrot_item);
            log_info("Placed from inventory: ok=%", {ok});
            if ok save_room_brainrots(player, room);
        }
    }

    ao_update :: method(dt: float) {
        if placed_brainrot != null && !#alive(placed_brainrot.entity) {
            placed_brainrot = null;
            accumulated_gold = 0;
            gps_tick_timer = 0;
        }

        // NPC base pedestals are display-only — no income generation.
        is_npc_room := room != null && room.#type == Room_Npc;
        if is_npc_room return;

        if placed_brainrot != null && !is_npc_room {
            gps_tick_timer += dt;
            while gps_tick_timer >= 1.0 {
                base := placed_brainrot.get_gps();
                amount := base;
                if room != null && #alive(room.owner) {
                    amount = ceil_float(base * get_rebirth_multiplier(room.owner, "money").(f64));
                }
                accumulated_gold += amount;
                gps_tick_timer -= 1.0;
            }
        }

        if claim_cooldown > 0 {
            claim_cooldown -= dt;
            if claim_cooldown < 0 claim_cooldown = 0;
        }

        if room == null return;
        if !#alive(room.owner) return;
        if money_entity == null return;
        if accumulated_gold <= 0 return;
        if claim_cooldown > 0 return;
        if !room.owner.is_local_or_server() return;
        if floor_renderer != null && room.owner.current_floor != floor_renderer.floor return;

        diff := room.owner.entity.world_position - money_entity.world_position;
        if length_squared(diff) < COLLECT_RANGE_SQ {
            collect_pedestal_gold(room.owner, accumulated_gold);
            accumulated_gold = 0;
            claim_cooldown = CLAIM_COOLDOWN_SECONDS;
            if placed_brainrot != null && #alive(placed_brainrot.entity) {
                placed_brainrot.start_jump();
            }
            collect_sfx := get_asset(SFX_Asset, "SFX/Collect_Money.wav");
            if collect_sfx != null {
                desc := SFX.default_sfx_desc();
                desc.entity_to_follow = money_entity.id;
                desc.volume = 0.6;
                desc.speed_perturb = 0.08;
                SFX.play(collect_sfx, desc);
            }
        }
    }

    ao_late_update :: method(dt: float) {
        if accumulated_gold <= 0 return;

        local, has_local := Game.get_local_player();
        if !has_local return;

        // Only show money for pedestals in the room the viewer is currently
        // standing in — keeps neighbour bases from polluting our labels.
        if room != null && local.is_in_current_room != room return;

        // Don't draw the money label if the viewer isn't on the same floor.
        if floor_renderer != null && local.current_floor != floor_renderer.floor return;

        pos := entity.world_position + v2{0, -0.7};

        // Camera-rect culling — skip the money label when off-screen.
        if local.camera.size > 0 {
            cam_pos := local.camera.position;
            cull_radius := local.camera.size * 1.5;
            diff := pos - cam_pos;
            if length_squared(diff) > cull_radius * cull_radius return;
        }

        UI.begin_world_space_ui(entity);
        defer UI.end_world_space_ui();
        UI.push_layer(2);

        ts := UI.default_text_settings();
        ts.size = 0.4;
        ts.color = v4{0.25, 1.0, 0.25, 1};
        ts.word_wrap = false;
        ts.overflow_wrap = false;
        ts.do_outline = true;
        ts.outline_thickness = 4.0;
        ts.outline_color = v4{0, 0, 0, 1};

        rect := Rect{pos, pos}.grow(0.3, 1.5, 0.3, 1.5);
        UI.text(rect, ts, format_cash(accumulated_gold));
    }
}

Room :: class : Component {
    // Auto-populated at runtime by walking child entities — never hand-assigned.
    pedestals: [..]Pedestal;

    owner: Player;
    trigger: Trigger_Volume @ao_serialize;

    ao_start :: method() {
        collect_pedestals_recursive(this, entity);
        for p: pedestals {
            if p == null continue;
            p.room = this;
        }

        if trigger != null trigger.set_listener(this, room_on_player_enter, room_on_player_exit);
    }

    // Snap a player back inside the room's trigger AABB. Used to fake walls
    // on upper floors so players can't walk out of their plot.
    clamp_player_inside :: method(player: Player) {
        if player == null return;
        if !#alive(player.entity) return;
        if trigger == null return;
        if !#alive(trigger.corner_a) return;
        if !#alive(trigger.corner_b) return;

        a := trigger.corner_a.world_position;
        b := trigger.corner_b.world_position;
        x_min := min(a.x, b.x);
        x_max := max(a.x, b.x);
        y_min := min(a.y, b.y);
        y_max := max(a.y, b.y);

        pos := player.entity.world_position;
        clamped := v2{clamp(pos.x, x_min, x_max), clamp(pos.y, y_min, y_max)};
        if clamped.x != pos.x || clamped.y != pos.y {
            player.entity.set_local_position(clamped);
        }
    }


    claim_room :: method(player: Player) -> bool {
        if #alive(owner) return false;
        owner = player;
        if player != null {
            player.my_room = this;
            if #alive(player.entity) {
                player.teleport(entity.world_position);
            }
        }
        apply_pedestal_unlocks(this, player);
        load_room_brainrots(player, this);
        return true;
    }

    // Re-apply unlock state on demand (e.g. after rebirth grants more slots).
    refresh_pedestal_unlocks :: method() {
        apply_pedestal_unlocks(this, owner);
    }

    // Wipe ownership and clear out all placed brainrots so the room is free
    // for the next player who joins. Order matters: tear down the brainrots
    // FIRST, then disable the pedestal entities — that way brainrot cleanup
    // doesn't run with an already-disabled pedestal underneath it.
    release_room :: method() {
        for p: pedestals {
            if p == null continue;
            if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) {
                p.placed_brainrot.entity.destroy();
            }
            p.placed_brainrot  = null;
            p.accumulated_gold = 0;
        }
        // Reset to the default unlocked count so the room shows the baseline
        // on the next player join (rebirth-granted slots stay locked until
        // someone with that progression claims the room).
        i: s64 = 0;
        for p: pedestals {
            if p == null continue;
            on := i < DEFAULT_PEDESTALS_UNLOCKED;
            if #alive(p.entity) p.entity.set_local_enabled(on);
            i += 1;
        }
        if owner != null && owner.my_room == this {
            owner.my_room = null;
        }
        owner = null;
    }

    find_empty_pedestal :: method() -> Pedestal {
        for p: pedestals {
            if p == null continue;
            if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) continue;
            return p;
        }
        return null;
    }
}

NPC_SPAWN_INTERVAL       :: 60.0;
NPC_BRAINROT_MAX_LEVEL   :: 10; // NPC-room brainrots spawn at a random level 1..this
BRAINROT_NPC_PREFAB_PATH :: "Brainrot_Npc.prefab";
NPC_ROOM_TICK_INTERVAL   :: 0.25;

// Registry of every Room_Npc, maintained by ao_start / ao_end so callers can
// iterate them without scanning the whole scene each frame.
g_npc_rooms: [..]Room_Npc;

// The "RoomNPCLast" room, cached on its init. Its bounds-trigger top Y is the
// auto-walk ceiling. null until that room initializes.
g_last_npc_room: Room_Npc;

Room_Npc :: class : Room {
    spawnable_brainrot_ids: [..]string         @ao_serialize;
    chase_trigger:          Trigger_Volume     @ao_serialize;
    jail_trigger:           Trigger_Volume     @ao_serialize;
    // The "Roof" child entity (holds 2 sub-children). Cached at init by walking
    // the room's children for the one named "Roof".
    roof:                   Entity;
    // Display name of this room's NPC — drawn big over the room while the roof
    // is shown (anchored at the roof's 2nd child).
    npc_name:               string             @ao_serialize;
    // Single per-room speed override. > 0 propagates to every Npc_Chaser in
    // this room on init so you don't have to edit each chaser individually.
    // 0 = leave each chaser's own speed_stat untouched.
    chaser_speed_stat:      s64                @ao_serialize;
    // Highest level a spawned brainrot can roll in this room. 0 (unset) falls
    // back to NPC_BRAINROT_MAX_LEVEL. Lower it for early rooms (e.g. 3).
    max_spawn_level:        s64                @ao_serialize;

    pedestal_timers: [..]float;
    pedestal_locked: [..]bool;
    chasers:         [..]Npc_Chaser;
    rng:             u64;
    initialized:     bool;
    npc_tick_accum:  float;
    roof_visual_visible:     bool;
    roof_visual_initialized: bool;

    // NB: can't override ao_start (parent Room already implements it →
    // overload_set). Registration into g_npc_rooms happens in init_npc_room.
    ao_end :: method() {
        for i: 0..g_npc_rooms.count - 1 {
            if g_npc_rooms[i] == this {
                unordered_remove_by_index(ref g_npc_rooms, i);
                break;
            }
        }
    }

    ao_update :: method(dt: float) {
        if !initialized {
            init_npc_room(this);
            initialized = true;
        }
        npc_tick_accum += dt;
        if npc_tick_accum < NPC_ROOM_TICK_INTERVAL return;
        elapsed := npc_tick_accum;
        npc_tick_accum = 0;
        tick_npc_room(this, elapsed);
    }

    // Push a player OUT of this room's bounds (the inherited Room `trigger`,
    // i.e. the TriggerVolume child) to the nearest edge. Used by the roof
    // barrier — a roofed room can't be entered.
    clamp_player_outside :: method(player: Player) {
        if player == null return;
        if !#alive(player.entity) return;
        if trigger == null return;
        if !#alive(trigger.corner_a) || !#alive(trigger.corner_b) return;

        a := trigger.corner_a.world_position;
        b := trigger.corner_b.world_position;
        x_min := min(a.x, b.x);
        x_max := max(a.x, b.x);
        y_min := min(a.y, b.y);
        y_max := max(a.y, b.y);

        pos := player.entity.world_position;
        if pos.x <= x_min || pos.x >= x_max return; // already outside on X
        if pos.y <= y_min || pos.y >= y_max return; // already outside on Y

        // Inside — snap to the nearest edge.
        dl := pos.x - x_min;
        dr := x_max - pos.x;
        db := pos.y - y_min;
        dt := y_max - pos.y;
        m := min(min(dl, dr), min(db, dt));
        new_pos := pos;
        if m == dl new_pos.x = x_min;
        else if m == dr new_pos.x = x_max;
        else if m == db new_pos.y = y_min;
        else new_pos.y = y_max;
        player.entity.set_local_position(new_pos);
    }

    ao_late_update :: method(dt: float) {
        room_visible := npc_room_visible_to_local(this);
        local, has_local := Game.get_local_player();
        if room_visible && has_local {
            draw_npc_pedestal_timers(this, local);
        }

        // Roof visibility is LOCAL-ONLY: the roof is hidden for the local
        // player only on their active_steal_room (the one room they may be in).
        // Recomputed each frame from local state — no networked flag, no
        // set_local_enabled (which would sync globally).
        roof_visible := !is_local_active_steal_room(this);
        if roof != null && #alive(roof) {
            apply_room_roof_visibility(this, roof_visible, false);
        }

        // Name only shows while the roof is visible (covering the room).
        if room_visible && roof_visible draw_npc_room_name(this);
    }

    ao_on_state_sync :: method() {
        if roof_visual_initialized {
            apply_room_roof_visibility(this, roof_visual_visible, true);
        }
    }
}

apply_room_roof_visibility :: proc(r: Room_Npc, visible: bool, force: bool) {
    if r == null return;
    if r.roof == null || !#alive(r.roof) return;
    if !force && r.roof_visual_initialized && r.roof_visual_visible == visible return;
    set_chaser_subtree_visible(r.roof, visible);
    r.roof_visual_visible = visible;
    r.roof_visual_initialized = true;
}

npc_room_visible_to_local :: proc(r: Room_Npc) -> bool {
    if r == null return false;
    local, has_local := Game.get_local_player();
    if !has_local return false;
    if local.camera.size <= 0 return true;

    if r.trigger != null && #alive(r.trigger.corner_a) && #alive(r.trigger.corner_b) {
        a := r.trigger.corner_a.world_position;
        b := r.trigger.corner_b.world_position;
        center := v2{(a.x + b.x) * 0.5, (a.y + b.y) * 0.5};
        apron := max(abs(a.x - b.x), abs(a.y - b.y)) * 0.5 + 2.0;
        return Camera.is_visible(center, apron);
    }
    if #alive(r.entity) return Camera.is_visible(r.entity.world_position, 8.0);
    return false;
}

// True if this room is the LOCAL player's active steal room (roof off for them).
is_local_active_steal_room :: proc(r: Room_Npc) -> bool {
    local, has_local := Game.get_local_player();
    if !has_local return false;
    return local.active_steal_room == r;
}

// Auto-walk ceiling = a bit INSIDE the last NPC room's bottom edge, NOT its top.
// Parking the player at the top edge pushes them out of the room's chase trigger
// (trigger-exit idles the chaser) and fights the clamp, stranding them. Stopping
// just inside the bottom keeps them within the chase trigger so the chaser can
// reach and catch them. Returns false until that room has initialized.
LAST_ROOM_CEILING_INSET :: 0.0; // world units above the room's bottom edge

get_last_npc_room_ceiling_y :: proc() -> float, bool {
    r := g_last_npc_room;
    if r == null return 0, false;
    if r.trigger == null return 0, false;
    if !#alive(r.trigger.corner_a) || !#alive(r.trigger.corner_b) return 0, false;
    ay := r.trigger.corner_a.world_position.y;
    by := r.trigger.corner_b.world_position.y;
    return min(ay, by) + LAST_ROOM_CEILING_INSET, true;
}

// Big world-space NPC name, drawn over the room while the roof is shown. The
// label is anchored at the roof's 2nd child (index 1).
NPC_ROOM_NAME_SIZE :: 2.2;

draw_npc_room_name :: proc(r: Room_Npc) {
    if r.npc_name.count <= 0 return;
    if r.roof == null || !#alive(r.roof) return;
    // Roof-visible gating is done by the caller (ao_late_update).

    first := r.roof.get_first_child();
    if first == null return;
    anchor := first.get_next_sibling(); // child index 1
    if anchor == null || !#alive(anchor) return;

    pos := anchor.world_position;

    UI.begin_world_space_ui(anchor);
    defer UI.end_world_space_ui();
    UI.push_layer(50); // above the roof sprites
    defer UI.pop_layer();

    ts := UI.default_text_settings();
    ts.size = NPC_ROOM_NAME_SIZE;
    ts.color = v4{1, 1, 1, 1};
    ts.word_wrap = true;           // wrap long names onto multiple lines
    ts.overflow_wrap = true;
    ts.do_outline = true;
    ts.outline_thickness = 4.0;
    ts.outline_color = v4{0, 0, 0, 1};
    // Narrow rect (grow width < height range) forces wrapping; the box is
    // centered on the anchor so the wrapped lines stack over the room.
    UI.text(Rect{pos, pos}.grow(4.0, 5.0, 4.0, 5.0), ts, r.npc_name);
}

init_npc_room :: proc(r: Room_Npc) {
    append(ref g_npc_rooms, r); // register for g_npc_rooms iteration
    if #alive(r.entity) && r.entity.get_name() == "RoomNPCLast" g_last_npc_room = r;

    seed_input: u64 = Time.nanoseconds_since_epoch();
    if #alive(r.entity) seed_input += r.entity.id.(u64);
    r.rng = rng_seed(seed_input);
    r.npc_tick_accum = rng_range_float(ref r.rng, 0.0, NPC_ROOM_TICK_INTERVAL);

    r.pedestal_timers.clear();
    r.pedestal_locked.clear();
    for p: r.pedestals {
        append(ref r.pedestal_timers, 0.0);
        append(ref r.pedestal_locked, false);
    }
    for i: 0..r.pedestals.count - 1 {
        respawn_npc_on_pedestal(r, i);
        // Stagger the FIRST respawn timer per pedestal so they don't all tick
        // (and visibly refresh) in lockstep. Later respawns use the flat
        // NPC_SPAWN_INTERVAL set inside respawn_npc_on_pedestal.
        if i >= 1 && i < r.pedestal_timers.count {
            r.pedestal_timers[i] = rng_range_float(ref r.rng, NPC_SPAWN_INTERVAL * 0.25, NPC_SPAWN_INTERVAL);
        }
    }

    r.chasers.clear();
    if #alive(r.entity) collect_chasers_recursive(r, r.entity);

    // Detach the chasers from the room so the room entity's transform/parent
    // chain no longer feeds into their movement and spine interpolation. Their
    // room link is the home_room field (set in collect above) and the r.chasers
    // refs, not the parent — so this is safe. MUST run after the collect, since
    // collect_chasers_recursive finds them by walking the room's children.
    // for c: r.chasers {
    //     if c == null continue;
    //     if !#alive(c.entity) continue;
    //     c.entity.set_parent(null, true); // null parent = world root, keep world position
    // }

    // Cache the "Roof" child entity.
    r.roof = null;
    if #alive(r.entity) {
        child := r.entity.get_first_child();
        while child != null {
            if child.get_name() == "Roof" {
                r.roof = child;
                break;
            }
            child = child.get_next_sibling();
        }
    }

    if r.chaser_speed_stat > 0 {
        for c: r.chasers {
            c.speed_stat = r.chaser_speed_stat;
        }
    }

    if r.chase_trigger != null {
        r.chase_trigger.set_listener(r, room_npc_on_chase_enter, room_npc_on_chase_exit);
    }
    if r.jail_trigger != null {
        r.jail_trigger.set_listener(r, null, room_npc_on_jail_exit);
    }
}

tick_npc_room :: proc(r: Room_Npc, dt: float) {
    for i: 0..r.pedestals.count - 1 {
        if i >= r.pedestal_timers.count continue;
        if i < r.pedestal_locked.count && r.pedestal_locked[i] continue;
        p := r.pedestals[i];
        if p == null continue;

        // Picked up or destroyed → respawn early.
        if p.placed_brainrot == null || !#alive(p.placed_brainrot.entity) {
            respawn_npc_on_pedestal(r, i);
            continue;
        }

        r.pedestal_timers[i] -= dt;
        if r.pedestal_timers[i] <= 0 {
            if #alive(p.placed_brainrot.entity) p.placed_brainrot.entity.destroy();
            p.placed_brainrot = null;
            respawn_npc_on_pedestal(r, i);
        }
    }
}

respawn_npc_on_pedestal :: proc(r: Room_Npc, i: s64) {
    if i <= 0 || i >= r.pedestals.count return; // pedestal 0 is reserved as the jail spot — never spawn a brainrot there
    p := r.pedestals[i];
    if p == null return;
    if r.spawnable_brainrot_ids.count <= 0 return;

    idx := rng_range_int(ref r.rng, 0, r.spawnable_brainrot_ids.count - 1);
    id  := r.spawnable_brainrot_ids[idx];

    configs := get_brainrot_configs();
    le: LivingEntity_Npc;
    for c: configs {
        if c.id != id continue;
        le = spawn_npc_brainrot_on_pedestal(p, c);
        break;
    }

    // Roll a random level (1-10) so each spawn varies in GPS, then a mutation.
    // Floor-1 (and above) pedestals are "boosted" — they ALWAYS get a modifier;
    // floor-0 pedestals only have the rare chance.
    if le != null {
        max_lvl := r.max_spawn_level;
        if max_lvl <= 0 max_lvl = NPC_BRAINROT_MAX_LEVEL;
        le.level = rng_range_int(ref r.rng, 1, max_lvl);
        boosted := p.floor_renderer != null && p.floor_renderer.floor >= 1;
        le.mutation = roll_mutation(ref r.rng, boosted);
        le.update_visuals();
    }

    if i < r.pedestal_timers.count {
        r.pedestal_timers[i] = NPC_SPAWN_INTERVAL;
    } else {
        append(ref r.pedestal_timers, NPC_SPAWN_INTERVAL);
    }
    if i < r.pedestal_locked.count {
        r.pedestal_locked[i] = false;
    } else {
        append(ref r.pedestal_locked, false);
    }
}

spawn_npc_brainrot_on_pedestal :: proc(pedestal: Pedestal, config: Brainrot_Config) -> LivingEntity_Npc {
    if pedestal == null return null;
    if pedestal.brainrot_pedestal == null return null;

    prefab := get_asset(Prefab_Asset, BRAINROT_NPC_PREFAB_PATH);
    if prefab == null {
        log_info("spawn_npc_brainrot_on_pedestal: prefab not found at '%'.", {BRAINROT_NPC_PREFAB_PATH});
        return null;
    }
    pos := pedestal.brainrot_pedestal.world_position;
    e := Scene.instantiate(prefab, pos);
    if e == null return null;
    le := e.get_component(LivingEntity_Npc);
    if le == null {
        log_info("spawn_npc_brainrot_on_pedestal: prefab root has no LivingEntity_Npc component.");
        return null;
    }
    le.pedestal = pedestal;
    apply_config_to_living_entity(le, config);
    pedestal.placed_brainrot = le;
    sync_brainrot_floor_to_pedestal(le, pedestal);
    return le;
}

draw_npc_pedestal_timers :: proc(r: Room_Npc, local: Player) {
    if local == null return;
    for i: 0..r.pedestals.count - 1 {
        if i >= r.pedestal_timers.count continue;
        p := r.pedestals[i];
        if p == null continue;
        if p.placed_brainrot == null continue;
        if !#alive(p.placed_brainrot.entity) continue;
        if p.floor_renderer != null && local.current_floor != p.floor_renderer.floor continue;

        time_left := r.pedestal_timers[i];
        if time_left < 0 time_left = 0;

        le := p.placed_brainrot;
        anchor := le.entity;
        if le.sprite != null && #alive(le.sprite.entity) anchor = le.sprite.entity;
        // Anchor BELOW the sprite — the timer sits under the brainrot's feet.
        base_pos := get_sprite_bottom_center(le.sprite, anchor) - v2{0, LABEL_TOP_PADDING};

        if local.camera.size > 0 {
            cam_pos := local.camera.position;
            cull_radius := local.camera.size * 1.5;
            diff := base_pos - cam_pos;
            if length_squared(diff) > cull_radius * cull_radius continue;
        }

        UI.begin_world_space_ui(anchor);
        defer UI.end_world_space_ui();
        UI.push_layer(2);
        defer UI.pop_layer();

        secs := time_left.(s64);
        draw_brainrot_label(base_pos, format_string("%s", {secs}), v4{1, 0.25, 0.25, 1}, 0.5, 0.35, 2.0);
    }
}

collect_pedestals_recursive :: proc(room: Room, e: Entity) {
    current := e.get_first_child();
    while current != null {
        p := current.get_component(Pedestal);
        if p != null {
            append(ref room.pedestals, p);
        }
        collect_pedestals_recursive(room, current);
        current = current.get_next_sibling();
    }
}

get_closest_placed_brainrot :: proc(player: Player) -> LivingEntity {
    room := player.my_room;
    if room == null return null;

    closest: LivingEntity;
    closest_dist_sq: float = 1000000.0;
    for p: room.pedestals {
        if p == null continue;
        if p.placed_brainrot == null continue;
        if !#alive(p.placed_brainrot.entity) continue;
        // Skip pedestals on a different floor than the viewer.
        if p.floor_renderer != null && player.current_floor != p.floor_renderer.floor continue;
        diff := p.placed_brainrot.entity.world_position - player.entity.world_position;
        d := length_squared(diff);
        if d < closest_dist_sq {
            closest_dist_sq = d;
            closest = p.placed_brainrot;
        }
    }
    if closest_dist_sq > UPGRADE_PROMPT_RANGE_SQ return null;
    return closest;
}

// Green box_panel shader material for the brainrot upgrade button (matches the
// Buy nav button's look).
UPGRADE_MAT:       Material;
UPGRADE_MAT_READY: bool;

upgrade_ensure_material :: proc() -> bool {
    if UPGRADE_MAT_READY return true;
    green_box := shop2_box_green();
    green_box.band_color     = v4{0.10, 0.26, 0.03, 1};
    green_box.dot_alpha      = 0.80;
    green_box.dot_min_radius = 0.05;
    green_box.dot_max_radius = 0.24;
    UPGRADE_MAT = rebirth_make_box_material(green_box);
    if UPGRADE_MAT == null return false; // shader still loading
    UPGRADE_MAT_READY = true;
    return true;
}

draw_upgrade_hud :: proc(player: Player) {
    target := get_closest_placed_brainrot(player);
    if target == null return;
    if !upgrade_ensure_material() return;

    UIK.begin(UIK.window(UIK.rect_hotbar().offset(0, 160)));

    row := UIK.layout_row();
    row.width = UIK.flex(1);
    row.height = UIK.flex(1);
    row.padding = v4{8, 16, 8, 16};
    row.main_align = .CENTER;
    row.cross_align = .CENTER;
    UIK.panel_begin(row);

    btn := UIK.layout_row();
    btn.width                       = UIK.pixels(420);
    btn.height                      = UIK.pixels(120);
    btn.main_align                  = .CENTER;
    btn.cross_align                 = .CENTER;
    btn.show_background              = true;
    btn.tint                        = v4{1, 1, 1, 1};
    btn.background_sprite_override   = core_globals.white_sprite;
    btn.background_material_override = UPGRADE_MAT;
    handle := UIK.panel_begin_interactive("upgrade_closest_brainrot", btn);
    UPGRADE_MAT.set_float4("rect_px", v4{handle.rect.min.x, handle.rect.min.y, handle.rect.max.x, handle.rect.max.y});
    UPGRADE_MAT.set_float("press", handle.active_t_eased);

    label := format_string("%   Lv % > %", {format_cash(target.get_upgrade_price()), target.level, target.level + 1});
    bd := UIK.text_button();
    bd.set_size_mult(1.2);
    UIK.text(label, bd);

    UIK.panel_end();

    UIK.panel_end();
    UIK.end();

    // Stash the upgrade button rect for the tutorial arrow (this frame).
    player.upgrade_btn_rect       = handle.rect;
    player.upgrade_btn_rect_frame = get_frame_number();

    if UIK.clicked(handle) {
        if target.try_upgrade(player) {
            tutorial_advance(player, TUT_UPGRADE); // upgraded a brainrot
        }
    }
}

room_on_player_enter :: proc(listener: Component, player: Player) {
    if listener == null return;
    if player == null return;
    room := listener.(Room);
    if room == null return;
    player.is_in_current_room = room;
}

room_on_player_exit :: proc(listener: Component, player: Player) {
    if listener == null return;
    if player == null return;
    room := listener.(Room);
    if room == null return;
    // Only clear if it's still pointing at us — handles the same-frame
    // exit-then-enter race when teleporting between rooms.
    if player.is_in_current_room == room {
        player.is_in_current_room = null;
    }
}

// Enable only the first `player.pedestals_unlocked` pedestals; disable the
// rest so they're hidden until unlocked (e.g. via rebirth).
apply_pedestal_unlocks :: proc(room: Room, player: Player) {
    if room == null return;
    if player == null return;
    unlocked := player.pedestals_unlocked;
    i: s64 = 0;
    for p: room.pedestals {
        if p == null continue;
        on := i < unlocked;
        if #alive(p.entity) p.entity.set_local_enabled(on);
        i += 1;
    }
}

find_free_room :: proc() -> Room {
    for r: component_iterator(Room) {
        if r.#type == Room_Npc continue;
        if r.owner != null && #alive(r.owner) continue;
        return r;
    }
    return null;
}

apply_config_to_living_entity :: proc(le: LivingEntity, config: Brainrot_Config) {
    le.config_id = config.id;
    le.display_name = config.display_name;
    le.rarity = config.rarity;
    le.base_price = config.base_price;
    le.base_gps = config.base_gps;
    if le.base_scale <= 0 le.base_scale = 1.0;
    if config.spine_path.count > 0 {
        setup_spine_brainrot(le, config.spine_path);
    } else if le.sprite != null && config.sprite_path.count > 0 {
        tex := get_asset(Texture_Asset, config.sprite_path);
        if tex != null le.sprite.set_texture(tex);
    }
    le.update_visuals();
}

// Premium brainrots render with a Spine_Animator instead of the prefab's
// Sprite_Renderer. We hide the sprite by zeroing its scale (the floor fade only
// touches alpha, so scale-0 stays hidden) and add the animator on the sprite's
// entity so it inherits the same world position.
SPINE_BRAINROT_SCALE :: 1.0;

setup_spine_brainrot :: proc(le: LivingEntity, spine_path: string) {
    if le == null return;
    le.is_spine = true;

    host := le.entity;
    if le.sprite != null && #alive(le.sprite.entity) {
        host = le.sprite.entity;
        le.sprite.scale = v2{0, 0}; // hide the default sprite
    }

    anim := host.get_component(Spine_Animator);
    if anim == null anim = host.add_component(Spine_Animator);
    le.spine = anim;
    anim.awaken();

    asset := get_asset(Spine_Asset, spine_path);
    if asset != null {
        anim.set_skeleton(asset);
        anim.set_skin("default");
        anim.refresh_skins();
        anim.set_animation("idle", true, 0);
    }
    anim.scale = v2{SPINE_BRAINROT_SCALE, SPINE_BRAINROT_SCALE};

    // Register the spine with the Floor_Renderer (it has a `spines` list beside
    // `sprites`) so it fades and re-layers with the floor exactly like the
    // sprite it replaces — otherwise it stays fully visible across floors.
    if le.floor_renderer != null {
        append(ref le.floor_renderer.spines, anim);
        le.floor_renderer.apply_layer();
    }

    // World height of the spine (bounds ~1.78 at scale 1) for label anchoring.
    le.spine_label_height = 1.85 * SPINE_BRAINROT_SCALE;
}

spawn_brainrot_on_pedestal :: proc(pedestal: Pedestal, config: Brainrot_Config) -> LivingEntity {
    if pedestal == null return null;
    if pedestal.brainrot_pedestal == null return null;

    prefab := get_asset(Prefab_Asset, BRAINROT_PREFAB_PATH);
    if prefab == null {
        log_info("Brainrot prefab not found at %", {BRAINROT_PREFAB_PATH});
        return null;
    }

    pos := pedestal.brainrot_pedestal.world_position;
    e := Scene.instantiate(prefab, pos);
    if e == null return null;

    le := e.get_component(LivingEntity);
    if le == null {
        log_info("Spawned Brainrot prefab is missing a LivingEntity component");
        return null;
    }

    le.pedestal = pedestal;
    apply_config_to_living_entity(le, config);
    pedestal.placed_brainrot = le;
    sync_brainrot_floor_to_pedestal(le, pedestal);
    return le;
}

BRAINROTS_SAVE_KEY :: "base_brainrots";

Saved_Brainrot :: class {
    pedestal_index: s64 @ao_serialize;
    config_id:      string @ao_serialize;
    level:          s64 @ao_serialize;
    mutation:       s64 @ao_serialize;
}

Saved_Brainrots :: class {
    items: [..]Saved_Brainrot @ao_serialize;
}

// The floor a pedestal lives on (0 when it has no floor renderer).
pedestal_floor :: proc(p: Pedestal) -> s64 {
    if p == null return 0;
    if p.floor_renderer == null return 0;
    return p.floor_renderer.floor;
}

// GPS of the brainrot on a pedestal, or -1 if empty (so empties sort last).
pedestal_gps :: proc(p: Pedestal) -> f64 {
    if p == null return -1.0;
    if p.placed_brainrot == null return -1.0;
    if !#alive(p.placed_brainrot.entity) return -1.0;
    return p.placed_brainrot.get_gps();
}

// Swap the placed brainrots between two pedestals — moves each entity onto the
// other's stand and re-points its `pedestal`/floor. Gold isn't moved (callers
// cash out first), so this is purely a visual/ownership reorder.
swap_placed_brainrots :: proc(pa: Pedestal, pb: Pedestal) {
    if pa == null || pb == null || pa == pb return;
    a := pa.placed_brainrot;
    b := pb.placed_brainrot;
    pa.placed_brainrot = b;
    pb.placed_brainrot = a;
    if a != null && #alive(a.entity) {
        a.pedestal = pb;
        if pb.brainrot_pedestal != null {
            a.entity.set_world_position(pb.brainrot_pedestal.world_position);
            a.entity.mark_teleported();
        }
        // Update the jump rest position too — a brainrot mid-jump (e.g. from
        // the equip-best cash-out) would otherwise snap back to its OLD spot,
        // landing on top of whatever was moved here.
        a.jump_rest_pos = a.entity.local_position;
        sync_brainrot_floor_to_pedestal(a, pb);
    }
    if b != null && #alive(b.entity) {
        b.pedestal = pa;
        if pa.brainrot_pedestal != null {
            b.entity.set_world_position(pa.brainrot_pedestal.world_position);
            b.entity.mark_teleported();
        }
        b.jump_rest_pos = b.entity.local_position;
        sync_brainrot_floor_to_pedestal(b, pa);
    }
}

save_room_brainrots :: proc(player: Player, room: Room) {
    if player == null return;
    if room == null return;

    payload := new(Saved_Brainrots);
    for i: 0..room.pedestals.count - 1 {
        p := room.pedestals[i];
        if p == null continue;
        if p.placed_brainrot == null continue;
        if !#alive(p.placed_brainrot.entity) continue;

        item := new(Saved_Brainrot);
        item.pedestal_index = i;
        item.config_id      = p.placed_brainrot.config_id;
        item.level          = p.placed_brainrot.level;
        item.mutation       = p.placed_brainrot.mutation.(s64);
        append(ref payload.items, item);
    }
    Save.set_json(player, BRAINROTS_SAVE_KEY, ref payload);
}

load_room_brainrots :: proc(player: Player, room: Room) {
    if player == null return;
    if room == null return;

    payload: Saved_Brainrots;
    if !Save.try_get_json(player, BRAINROTS_SAVE_KEY, ref payload) return;
    if payload == null return;

    configs := get_brainrot_configs();
    for item: payload.items {
        if item == null continue;
        if item.pedestal_index < 0 || item.pedestal_index >= room.pedestals.count continue;

        pedestal := room.pedestals[item.pedestal_index];
        if pedestal == null continue;
        if pedestal.placed_brainrot != null && #alive(pedestal.placed_brainrot.entity) continue;

        for c: configs {
            if c.id != item.config_id continue;
            le := spawn_brainrot_on_pedestal(pedestal, c);
            if le == null break;
            if item.level > 0 le.level = item.level;
            le.mutation = item.mutation.(Mutation);
            le.owner    = player;
            le.state    = Brainrot_State.CLAIMED_IN_BASE;
            le.update_visuals();
            break;
        }
    }
}

claim_room_cmd :: proc(player: Player) {
    existing := player.my_room;
    if existing != null {
        show_notification(player, "You already own a base.");
        return;
    }
    room := find_free_room();
    if room == null {
        show_notification(player, "No free base available.");
        return;
    }
    room.claim_room(player);
    show_notification(player, "Base claimed!");
} @chat_command

place_brainrot_cmd :: proc(player: Player, id: string = "tralalero") {
    room := player.my_room;
    if room == null {
        show_notification(player, "Claim a base first with /claim_room_cmd");
        return;
    }
    pedestal := room.find_empty_pedestal();
    if pedestal == null {
        show_notification(player, "All pedestals are full.");
        return;
    }
    configs := get_brainrot_configs();
    for c: configs {
        if c.id == id {
            le := spawn_brainrot_on_pedestal(pedestal, c);
            if le == null {
                show_notification(player, "Spawn failed (check prefab + LivingEntity component).");
                return;
            }
            // Placing into your OWN base: claim it so it behaves like a real
            // base brainrot (taps into inventory on pickup, persists on save).
            le.owner = player;
            le.state = Brainrot_State.CLAIMED_IN_BASE;
            le.update_visuals();
            save_room_brainrots(player, room);
            show_notification(player, "Placed %", {c.display_name});
            return;
        }
    }
    show_notification(player, "Unknown brainrot id: %", {id});
} @chat_command

// Test/admin-only load generator used by perf tests. Fills the caller's base
// with varied high-level brainrots and unlocks every pedestal, without showing
// notifications or doing persistent save writes. Normal gameplay never calls it.
perf_spawn_full_load :: proc(player: Player) {
    if player == null return;

    room := player.my_room;
    if room == null {
        room = find_free_room();
        if room != null room.claim_room(player);
    }
    if room == null return;

    player.cash = 1000000000.0;
    player.displayed_cash = player.cash;
    player.pedestals_unlocked = room.pedestals.count;
    apply_pedestal_unlocks(room, player);

    configs := get_brainrot_configs();
    if configs.count <= 0 return;

    for i: 0..room.pedestals.count - 1 {
        p := room.pedestals[i];
        if p == null continue;

        if p.placed_brainrot != null && #alive(p.placed_brainrot.entity) {
            p.placed_brainrot.entity.destroy();
        }
        p.placed_brainrot = null;

        cfg := configs[i % configs.count];
        le := spawn_brainrot_on_pedestal(p, cfg);
        if le == null continue;
        le.owner = player;
        le.state = Brainrot_State.CLAIMED_IN_BASE;
        le.level = 10 + (i % 20);
        mut_idx := i % 4;
        if mut_idx == 1 le.mutation = Mutation.GOLD;
        if mut_idx == 2 le.mutation = Mutation.DIAMOND;
        if mut_idx == 3 le.mutation = Mutation.RAINBOW;
        le.update_visuals();

        p.accumulated_gold = 100000.0 + i.(float) * 2500.0;
        p.gps_tick_timer = 0;
        p.claim_cooldown = 0;
    }

    player.teleport(room.entity.world_position);
    player.current_floor = 0;
} @chat_command
