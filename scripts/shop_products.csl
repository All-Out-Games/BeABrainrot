    "6a11b23fbe0d3bb082563cdb", // SkipRebirth29
    "6a11b2417acb668d56bf4367", // SkipRebirth30
};

// Product id for the SkipRebirth that lands the player on rebirth `level`
// (1..30). Returns "" if out of range.
skip_rebirth_product_id_for_level :: proc(level: s64) -> string {
    if level <= 0 return "";
    i := level - 1;
    if i >= SKIP_REBIRTH_PRODUCT_IDS.count i = SKIP_REBIRTH_PRODUCT_IDS.count - 1;
    return SKIP_REBIRTH_PRODUCT_IDS[i];
}

// ===== Central purchase dispatcher =====
// Engine calls this when ANY purchase completes. Return true to confirm the
// grant (and consume, if consumable). Add new product branches here as the
// shop grows so every paid item is handled in one place.

ao_purchase_handler :: proc(player: Player, id: string) -> bool {
    // SkipRebirthN — consumable. Grant the matching rebirth (bypass the speed
    // gate, keep cash/speed) when the id matches the player's next rebirth.
    for i: 0..SKIP_REBIRTH_PRODUCT_IDS.count - 1 {
        if SKIP_REBIRTH_PRODUCT_IDS[i] == id {
            if i + 1 != player.rebirth_level + 1 return false;
            return do_rebirth(player, true);
        }
    }
    // Anything else (skin unlocks, etc.) — non-consumable, engine just needs a
    // green-light to mark it owned.
    return true;
}
