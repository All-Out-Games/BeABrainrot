    "6a11a4e3be0d3bb0825636cb", // BuySkinRebirth30
};

// Product id for skin slot `index` (1..30). Index 0 is the free starter slot.
skin_product_id_for_index :: proc(index: s64) -> string {
    if index <= 0 return "";
    i := index - 1;
    if i >= SKIN_PRODUCT_IDS.count i = SKIN_PRODUCT_IDS.count - 1;
    return SKIN_PRODUCT_IDS[i];
}

// True if the skin at slot `index` is unlocked for this player — either they
// reached the rebirth requirement OR they bought the product.
is_skin_unlocked :: proc(player: Player, index: s64) -> bool {
    if index <= 0 return true;
    if player == null return false;
    if player.rebirth_level >= index return true;
    id := skin_product_id_for_index(index);
    if id.count > 0 && Purchasing.owns_product(player, id) return true;
    return false;
}

