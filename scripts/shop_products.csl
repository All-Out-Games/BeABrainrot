// Product id for the SkipRebirth that lands the player on rebirth `level`
// (1..30). Returns "" if out of range.
skip_rebirth_product_id_for_level :: proc(level: s64) -> string {
    if level <= 0 return "";
    i := level - 1;
    if i >= SKIP_REBIRTH_PRODUCT_IDS.count i = SKIP_REBIRTH_PRODUCT_IDS.count - 1;
    return SKIP_REBIRTH_PRODUCT_IDS[i];
}

// ===== Speed skip =====
// One consumable per tier. Pressing any sparks button (the +1, +5, or +10 row)
// always prompts the SAME product — the tier's +10 — and always grants the
// player +10 speed. The cash buttons still vary by amount; sparks is a single
// "best deal" purchase regardless of which row's sparks button was pressed.

SPEED_SKIP_TIER_COUNT     :: 9;
SPEED_SKIP_GRANT_AMOUNT   :: 10;

SPEED_SKIP_PRODUCT_IDS: [SPEED_SKIP_TIER_COUNT]string = {
    "6a1450ba03d5c38d5f938b05", // SpeedSkipT1 ( 9)
    "6a1450bc4d8844eee6ae049c", // SpeedSkipT2 (19)
    "6a1450be03d5c38d5f938b06", // SpeedSkipT3 (29)
    "6a1450bfb723fdec2068edb6", // SpeedSkipT4 (49)
    "6a1450c1b723fdec2068edb8", // SpeedSkipT5 (69)
    "6a1450c3ddd9f6199748c232", // SpeedSkipT6 (99)
    "6a1450c44d8844eee6ae049f", // SpeedSkipT7 (139)
    "6a1450c6ddd9f6199748c233", // SpeedSkipT8 (179)
    "6a1450c7ddd9f6199748c234", // SpeedSkipT9 (229)
};

// Returns the 0..8 tier index for a given current speed.
speed_skip_tier_index :: proc(current_speed: s64) -> s64 {
    if current_speed < 33  return 0;
    if current_speed < 53  return 1;
    if current_speed < 73  return 2;
    if current_speed < 93  return 3;
    if current_speed < 113 return 4;
    if current_speed < 133 return 5;
    if current_speed < 153 return 6;
    if current_speed < 173 return 7;
    return 8;
}

speed_skip_product_id :: proc(current_speed: s64) -> string {
    return SPEED_SKIP_PRODUCT_IDS[speed_skip_tier_index(current_speed)];
}

// ===== PRIME pass =====
// Non-consumable VIP pass: unlocks the VIP floor + boosted brainrots and
// auto-collects coins. Ownership of the product IS the grant (no consumable
// state), so has_prime just checks ownership.

PRIME_PASS_PRODUCT_ID :: "6a21489bd533b740baa6d56b";

has_prime :: proc(player: Player) -> bool {
    if player == null return false;
    return Purchasing.owns_product(player, PRIME_PASS_PRODUCT_ID);
}

// ===== Pricing / discount helper =====
// Convention: a product's DESCRIPTION, when it's a plain number string, is the
// pre-discount ("original") price. We have no real discount field, so this is
// how a sale is expressed — e.g. price 399 + description "699" => 699 -> 399.
// (parse_uint_string lives in utils.csl.)

// Returns (price, original, on_sale). `original`/`on_sale` are only meaningful
// when the description is a number greater than the current price.
product_pricing :: proc(id: string) -> s64, s64, bool {
    prod := Purchasing.get_product(id);
    orig, ok := parse_uint_string(prod.description);
    on_sale := ok && orig > prod.price;
    return prod.price, orig, on_sale;
}

// ===== Gamepasses (shop_v3) =====
// Non-consumable. Ownership IS the effect; read via the helpers below.

TWO_X_MONEY_PRODUCT_ID :: "6a22d46c2f7867b14d4af968"; // 149
TWO_X_SPEED_PRODUCT_ID :: "6a22d48354407744c2f8e6ed"; // 299

has_2x_money :: proc(player: Player) -> bool {
    if player == null return false;
    return Purchasing.owns_product(player, TWO_X_MONEY_PRODUCT_ID);
}

has_2x_speed :: proc(player: Player) -> bool {
    if player == null return false;
    return Purchasing.owns_product(player, TWO_X_SPEED_PRODUCT_ID);
}

// ===== Bundles (shop_v3) =====
// Consumable packs. Brainrots are granted via grant_brainrot, which routes any
// that don't fit to the player's mailbox (unclaimed items) instead of losing
// them. Levels are high so the packs feel like real value.

STARTER_PACK_PRODUCT_ID :: "6a22d0fc40c27018a8bbfebd"; // 67
RAINBOW_PACK_PRODUCT_ID :: "6a22d10654407744c2f8e47b"; // 249

STARTER_PACK_CASH       :: 50000000.0; // $50M
STARTER_PACK_BRAINROT   :: "lirili_larila";
STARTER_PACK_LEVEL      :: 25;
RAINBOW_PACK_LEVEL      :: 25;
BUNDLE_BRAINROT_LEVEL   :: 10;

grant_starter_pack :: proc(player: Player) {
    deposit_cash(player, STARTER_PACK_CASH);
    grant_brainrot(player, STARTER_PACK_BRAINROT, STARTER_PACK_LEVEL, Mutation.NONE);
}

grant_rainbow_pack :: proc(player: Player) {
    grant_brainrot(player, "chimpanzini", RAINBOW_PACK_LEVEL, Mutation.RAINBOW);
    grant_brainrot(player, "spijuniro",   RAINBOW_PACK_LEVEL, Mutation.RAINBOW);
    grant_brainrot(player, "garama",      RAINBOW_PACK_LEVEL, Mutation.RAINBOW);
}

// ===== Premium brainrot: Wooow My Examen (sparks-only) =====
// Bought for sparks and granted at level 70 into the inventory. Right after the
// grant, the "ADD A MODIFIER" popup offers an optional mutation — that's a
// SEPARATE consumable purchase (gold/diamond/rainbow) applied to the item we
// stash in player.pending_modifier_item.

WOOOW_MY_EXAMEN_PRODUCT_ID  :: "6a26c19f62fbf2c09d555b25"; // 1499
MODIFIER_GOLD_PRODUCT_ID    :: "6a26c1b30bd8548e470d2af4"; // 399
MODIFIER_DIAMOND_PRODUCT_ID :: "6a26c1b6c78200e158f5be1e"; // 499
MODIFIER_RAINBOW_PRODUCT_ID :: "6a26c1b80bd8548e470d2afe"; // 799

WOOOW_MY_EXAMEN_ID    :: "wooow_my_examen";
WOOOW_MY_EXAMEN_LEVEL :: 70;

// Grant the premium brainrot at level 70 and remember it so a follow-up modifier
// purchase can target it. Full inventory routes to the mailbox (no modifier
// target then). Always returns true — the item is always granted somewhere.
grant_examen_brainrot :: proc(player: Player) -> bool {
    if player == null return false;
    mark_brainrot_discovered(player, WOOOW_MY_EXAMEN_ID, Mutation.NONE);
    item, ok := try_give_brainrot_item_ret(player, WOOOW_MY_EXAMEN_ID, WOOOW_MY_EXAMEN_LEVEL, Mutation.NONE);
    if ok {
        player.pending_modifier_item = item;
        // Offer the optional modifier right after the grant.
        player.show_modifier_popup = true;
        player.show_modifier_skip_confirm = false;
    } else {
        player.pending_modifier_item = null;
        player.show_modifier_popup = false;
        add_unclaimed_brainrot(player, WOOOW_MY_EXAMEN_ID, WOOOW_MY_EXAMEN_LEVEL, Mutation.NONE);
        show_notification(player, "Inventory full! Wooow My Examen sent to your mailbox.");
    }
    return true;
}

// Per-player log of premium-brainrot modifier purchases, for tracking. Each
// entry is "brainrot_id:modifier:YYYY-MM-DD-HH" (UTC hour of purchase).
PREMIUM_MODIFIER_LOG_KEY :: "brainrots_bought_modifiers";

Bought_Modifier_Log :: class {
    entries: [..]string @ao_serialize;
}

record_bought_modifier :: proc(player: Player, brainrot_id: string, mutation: Mutation) {
    if player == null return;
    log: Bought_Modifier_Log;
    Save.try_get_json(player, PREMIUM_MODIFIER_LOG_KEY, ref log);
    if log == null log = new(Bought_Modifier_Log);
    dt := get_utc_datetime();
    stamp := format_string("%-%-%-%", {dt.year, dt.month, dt.day, dt.hour});
    append(ref log.entries, format_string("%:%:%", {brainrot_id, get_mutation_name(mutation), stamp}));
    Save.set_json(player, PREMIUM_MODIFIER_LOG_KEY, ref log);
}

// Apply a purchased modifier to the brainrot from the most recent premium buy.
// Returns false (rejects/refunds the purchase) when there's no valid target.
apply_pending_modifier :: proc(player: Player, mutation: Mutation) -> bool {
    if player == null return false;
    item := player.pending_modifier_item;
    if item == null || !#alive(item) {
        show_notification(player, "No brainrot to apply that modifier to.");
        return false;
    }

    // Capture the item's identity before replacing it.
    brainrot_id := WOOOW_MY_EXAMEN_ID;
    level := item.level;
    defn := item.get_definition();
    if defn != null && defn.#type == Brainrot_Item_Definition {
        brainrot_id = defn.(Brainrot_Item_Definition).config_id;
    }

    // Re-create the item WITH the mutation rather than writing item.mutation in
    // place. The inventory auto-save only captures structural changes, so an
    // in-place field write was lost on rejoin if the player never placed it.
    // create+move IS persisted (same path the base grant uses), so the modifier
    // now survives a quit.
    Items.destroy_item_instance(item);
    player.pending_modifier_item = null;
    _, ok := try_give_brainrot_item_ret(player, brainrot_id, level, mutation);
    if !ok add_unclaimed_brainrot(player, brainrot_id, level, mutation);

    player.show_modifier_popup = false;
    player.show_modifier_skip_confirm = false;

    record_bought_modifier(player, brainrot_id, mutation);
    show_notification(player, "Applied % modifier!", {get_mutation_name(mutation)});
    return true;
}

// Debug: grant the premium brainrot for free and open the modifier popup so the
// UI can be eyeballed without a real purchase.
open_modifier_popup_cmd :: proc(player: Player) {
    grant_examen_brainrot(player);
} @chat_command

// ===== Offline earnings (Welcome Back popup) =====
// Consumable. "Claim X10" on the Welcome Back popup prompts this; on a
// successful purchase we pay out 10x the player's pending offline earnings and
// settle the popup. See offline_earnings.csl.

OFFLINE_EARNINGS_X10_PRODUCT_ID :: "6a28b07990944b497358324c"; // 79

// ===== Central purchase dispatcher =====
// Engine calls this when ANY purchase completes. Return true to confirm the
// grant (and consume, if consumable). Add new product branches here as the
// shop grows so every paid item is handled in one place.

ao_purchase_handler :: proc(player: Player, id: string) -> bool {
    // Premium brainrot + its optional modifier add-ons (consumable).
    if id == WOOOW_MY_EXAMEN_PRODUCT_ID  return grant_examen_brainrot(player);
    if id == MODIFIER_GOLD_PRODUCT_ID    return apply_pending_modifier(player, Mutation.GOLD);
    if id == MODIFIER_DIAMOND_PRODUCT_ID return apply_pending_modifier(player, Mutation.DIAMOND);
    if id == MODIFIER_RAINBOW_PRODUCT_ID return apply_pending_modifier(player, Mutation.RAINBOW);

    // Offline earnings "Claim X10" — pay 10x the pending offline reward, settle
    // the popup. Return whether anything was actually settled: if the popup was
    // already resolved (e.g. the player hit Claim! while the purchase dialog was
    // up), this returns false so the engine blocks the transaction and the
    // player isn't charged sparks for a no-op.
    if id == OFFLINE_EARNINGS_X10_PRODUCT_ID {
        return settle_offline_earnings(player, 10.0);
    }

    // Bundles — consumable. Grant their contents (overflow goes to the mailbox).
    if id == STARTER_PACK_PRODUCT_ID {
        grant_starter_pack(player);
        return true;
    }
    if id == RAINBOW_PACK_PRODUCT_ID {
        grant_rainbow_pack(player);
        return true;
    }

    // SkipRebirthN — consumable. Grant the matching rebirth (bypass the speed
    // gate, keep cash/speed) when the id matches the player's next rebirth.
    for i: 0..SKIP_REBIRTH_PRODUCT_IDS.count - 1 {
        if SKIP_REBIRTH_PRODUCT_IDS[i] == id {
            if i + 1 != player.rebirth_level + 1 return false;
            return do_rebirth(player, true);
        }
    }
    // SpeedSkipT* — consumable. Grants +SPEED_SKIP_GRANT_AMOUNT speed when the
    // product matches the player's current tier (prevents using a stale prompt
    // from a lower tier). Bumps purchased_speed so the boost survives rebirth.
    for t: 0..SPEED_SKIP_PRODUCT_IDS.count - 1 {
        if SPEED_SKIP_PRODUCT_IDS[t] == id {
            if t != speed_skip_tier_index(player.speed) return false;
            add_speed(player, SPEED_SKIP_GRANT_AMOUNT);
            player.set_permanent_speed(player.purchased_speed + SPEED_SKIP_GRANT_AMOUNT);
            play_speed_buy_sfx(player);
            return true;
        }
    }
    // Anything else (skin unlocks, etc.) — non-consumable, engine just needs a
    // green-light to mark it owned.
    return true;
}
