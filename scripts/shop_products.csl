// BuySkinRebirth1..30 — each unlocks the skin gated behind that rebirth level
// without having to grind to it.

SKIN_PRODUCT_IDS: [30]string = {
    "6a11a49b3dfc01a7251a1c6a", // BuySkinRebirth1
    "6a11a49d3dfc01a7251a1c6b", // BuySkinRebirth2
