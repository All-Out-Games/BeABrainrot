// Shop v3 — UIK layout with box_panel / ray_spin shader backgrounds applied
// through Panel_Desc.background_material_override.
//
// panel_begin_interactive().rect only resolves for an interactive panel that
// is NOT nested inside another interactive panel. So the shell is a plain
// (non-interactive) native modal, and the banner + cards are the only
// interactive panels — none nested in another — so each gets a real rect,
// which is fed to its material as rect_px every frame.
//
// box_panel.aosl is shared with shop_v2 (it takes rect_px).
//
// Toggle with /shop3.

// ===== Materials ===== (one per panel — UIK batches draws at UIK.end()).

SHOP3_MAT_ORANGE:     Material;
SHOP3_MAT_YELLOW:     Material;
SHOP3_MAT_RAINBOW:    Material;
SHOP3_MAT_PURPLE:     Material;
SHOP3_MAT_BANNER:     Material; // rainbow background for the PRIME pass banner
SHOP3_MAT_PRICE:      Material; // gold shader for the PRIME price button
SHOP3_MAT_BUNDLE_A:   Material; // starter bundle background (green)
SHOP3_MAT_BUNDLE_B:   Material; // rainbow bundle background (rainbow)
SHOP3_MAT_PRICE_A:    Material; // starter bundle price button
SHOP3_MAT_PRICE_B:    Material; // rainbow bundle price button
SHOP3_MAT_GP_MONEY:   Material; // 2x money gamepass card background (green)
SHOP3_MAT_GP_SPEED:   Material; // 2x speed gamepass card background (blue)
SHOP3_MAT_RAY_D:      Material; // ray behind the 2x money icon
SHOP3_MAT_RAY_E:      Material; // ray behind the 2x speed icon
SHOP3_MAT_PRICE_C:    Material; // 2x money price button
SHOP3_MAT_PRICE_D:    Material; // 2x speed price button
SHOP3_MAT_RAY_A:      Material; // spinning ray burst behind each card icon
SHOP3_MAT_RAY_B:      Material;
SHOP3_MAT_RAY_C:      Material;
SHOP3_MAT_RAY_BANNER: Material; // rays behind the PRIME icon
SHOP3_MATS_READY:     bool;

// PRIME icon "breathing" pulse (1080p ref px).
PRIME_ICON_BASE   :: 150.0;
PRIME_PULSE_AMP   :: 12.0;
PRIME_PULSE_SPEED :: 2.5;

shop3_make_box_material :: proc(box: Shop2_Box) -> Material {
    shader := get_asset(Shader_Asset, "shaders/box_panel.aosl");
    if shader == null return null;
    mat := Material.create(shader);
    mat.set_float4("top_color",         box.top);
    mat.set_float4("bottom_color",      box.bottom);
    mat.set_float ("dot_cell_px",       box.dot_cell);
    mat.set_float ("dot_min_radius",    box.dot_min_radius);
    mat.set_float ("dot_max_radius",    box.dot_max_radius);
    mat.set_float ("dot_alpha",         box.dot_alpha);
    mat.set_float ("bottom_band_h",     box.band_h);
    mat.set_float4("bottom_band_color", box.band_color);
    mat.set_float ("outline_px",        box.outline_px);
    mat.set_float4("outline_color",     box.outline_color);
    mat.set_float ("corner_radius_px",  box.corner_radius);
    mat.set_float ("rainbow_strength",  box.rainbow);
    mat.set_float ("rainbow_speed",     box.rainbow_speed);
    mat.set_float ("rainbow_hue_span",  box.rainbow_hue_span);
    mat.set_float ("shine_strength",    0.0);
    mat.set_float ("shine_speed",       1.0);
    return mat;
}

shop3_make_ray_material :: proc() -> Material {
    shader := get_asset(Shader_Asset, "shaders/ray_spin.aosl");
    if shader == null return null;
    mat := Material.create(shader);
    mat.set_float("spin_speed", 0.44); // ~25 deg/sec, matches v2
    mat.set_float("fill_scale", 1.6);  // overflow the media panel
    return mat;
}

shop3_ensure_materials :: proc() -> bool {
    if SHOP3_MATS_READY return true;
    SHOP3_MAT_ORANGE  = shop3_make_box_material(shop2_box_orange());
    SHOP3_MAT_YELLOW  = shop3_make_box_material(shop2_box_yellow());
    SHOP3_MAT_RAINBOW = shop3_make_box_material(shop2_box_rainbow());
    SHOP3_MAT_PURPLE  = shop3_make_box_material(shop2_box_purple());
    SHOP3_MAT_BANNER  = shop3_make_box_material(shop2_box_rainbow());
    SHOP3_MAT_PRICE   = shop3_make_box_material(shop2_box_green());
    SHOP3_MAT_BUNDLE_A = shop3_make_box_material(shop2_box_green());
    SHOP3_MAT_BUNDLE_B = shop3_make_box_material(shop2_box_rainbow());
    SHOP3_MAT_PRICE_A  = shop3_make_box_material(shop2_box_green());
    SHOP3_MAT_PRICE_B  = shop3_make_box_material(shop2_box_green());
    SHOP3_MAT_GP_MONEY = shop3_make_box_material(shop2_box_green());
    gp_speed_box := shop2_box_dark();
    gp_speed_box.top        = v4{0.26, 0.55, 0.98, 1};
    gp_speed_box.bottom     = v4{0.10, 0.30, 0.78, 1};
    gp_speed_box.band_color = v4{0.04, 0.12, 0.40, 1};
    SHOP3_MAT_GP_SPEED = shop3_make_box_material(gp_speed_box);
    SHOP3_MAT_PRICE_C  = shop3_make_box_material(shop2_box_green());
    SHOP3_MAT_PRICE_D  = shop3_make_box_material(shop2_box_green());
    if SHOP3_MAT_ORANGE == null return false; // shader still loading
    SHOP3_MAT_RAY_A = shop3_make_ray_material();
    SHOP3_MAT_RAY_B = shop3_make_ray_material();
    SHOP3_MAT_RAY_C = shop3_make_ray_material();
    SHOP3_MAT_RAY_D = shop3_make_ray_material();
    SHOP3_MAT_RAY_E = shop3_make_ray_material();
    SHOP3_MAT_RAY_BANNER = shop3_make_ray_material();
    // Smaller burst radius so the rays fade fully to transparent INSIDE the
    // panel (no hard rectangular cut against the banner). The cards use 1.6 to
    // intentionally overflow their square; the banner panel must not.
    SHOP3_MAT_RAY_BANNER.set_float("fill_scale", 0.95);
    SHOP3_MATS_READY = true;
    return true;
}

// Feed a panel's resolved screen rect to its background material as rect_px.
shop3_feed_rect :: proc(mat: Material, r: Rect) {
    if mat == null return;
    mat.set_float4("rect_px", v4{r.min.x, r.min.y, r.max.x, r.max.y});
}

// Box_panel shader price button: spark icon + current price. The original
// (pre-discount) price, if any, is drawn separately in the banner above this.
draw_shop3_price_button :: proc(id: string, product_id: string, mat: Material) -> Interact_Result {
    price, _, _ := product_pricing(product_id);
    spark := get_asset(Texture_Asset, "$AO/new/icons/sparks/spark_icon.png");

    btn := UIK.layout_row();
    btn.width                       = UIK.pixels(300);
    btn.height                      = UIK.pixels(100);
    btn.gap                         = 8;
    btn.main_align                  = .CENTER;
    btn.cross_align                 = .CENTER;
    btn.show_background              = true;
    btn.tint                        = v4{1, 1, 1, 1};
    btn.background_sprite_override   = core_globals.white_sprite;
    btn.background_material_override = mat;
    h := UIK.panel_begin_interactive(id, btn);
    shop3_feed_rect(mat, h.rect);
    mat.set_float("press", h.active_t_eased);

    icon_holder := UIK.layout_centered(UIK.pixels(36), UIK.pixels(36));
    UIK.panel_begin(icon_holder);
    if spark != null UIK.image_fitted(spark, UIK.image_desc(.CONTAIN));
    UIK.panel_end();

    UIK.text(format_string("%", {price}), UIK.text_button());

    UIK.panel_end(); // btn
    return h;
}

// The original price (red) drawn in the banner above the price button when a
// product is on sale. Returns the text's screen rect so the caller can draw a
// diagonal strike line over it after UIK.end() (UIK can't rotate).
draw_shop3_struck_price :: proc(orig: s64) -> Rect {
    wrap := UIK.layout_row();
    wrap.width  = UIK.fit();
    wrap.height = UIK.fit();
    h := UIK.panel_begin_interactive("shop3_struck", wrap);
    od := UIK.text_title();
    od.set_size_mult(0.6);
    od.set_color({1.0, 0.3, 0.3, 1});
    od.set_outline(true, 3.0, v4{0, 0, 0, 1});
    UIK.text(format_string("%", {orig}), od);
    UIK.panel_end(); // wrap
    return h.rect;
}

// Wide bundle banner: brainrot preview(s) over a ray burst on the left, an
// optional cash reward in the middle, and the pack title + shader price button
// on the right. Returns the price button's Interact_Result.
draw_shop3_bundle :: proc(panel_id: string, product_id: string, bg_mat: Material, ray_mat: Material, price_mat: Material, title: string, brainrot_ids: []string, cash_text: string) -> Interact_Result {
    banner := UIK.layout_row();
    banner.width                       = UIK.flex(1);
    banner.height                      = UIK.pixels(210);
    banner.gap                         = 12;
    banner.padding                     = v4{12, 14, 12, 14};
    banner.cross_align                 = .CENTER;
    banner.show_background              = true;
    banner.tint                        = v4{1, 1, 1, 1};
    banner.background_sprite_override   = core_globals.white_sprite;
    banner.background_material_override = bg_mat;
    h := UIK.panel_begin_interactive(panel_id, banner);
    shop3_feed_rect(bg_mat, h.rect);

    // Content: brainrot icon(s) and the cash reward spread evenly across the
    // bar (each is its own flex cell) over a single ray burst.
    content := UIK.layout_row();
    content.width                       = UIK.flex(1);
    content.height                      = UIK.flex(1);
    content.cross_align                 = .CENTER;
    content.show_background              = true;
    content.tint                        = v4{1, 1, 1, 0.9};
    content.background_sprite_override   = core_globals.white_sprite;
    content.background_material_override = ray_mat;
    ch := UIK.panel_begin_interactive(format_string("%_rays", {panel_id}), content);
    shop3_feed_rect(ray_mat, ch.rect);

    icon_size := 130.0;
    if brainrot_ids.count > 1 icon_size = 116.0;
    for cid: brainrot_ids {
        d := find_brainrot_definition(cid);
        cell := UIK.layout_column();
        cell.width       = UIK.flex(1);
        cell.height      = UIK.flex(1);
        cell.main_align  = .CENTER;
        cell.cross_align = .CENTER;
        UIK.panel_begin(cell);
        holder := UIK.layout_centered(UIK.pixels(icon_size), UIK.pixels(icon_size));
        UIK.panel_begin(holder);
        if d != null {
            ic := d.get_icon();
            if ic != null UIK.image_fitted(ic, UIK.image_desc(.CONTAIN));
        }
        UIK.panel_end();
        UIK.panel_end(); // cell
    }
    if cash_text.count > 0 {
        cell := UIK.layout_column();
        cell.width       = UIK.flex(1);
        cell.height      = UIK.flex(1);
        cell.main_align  = .CENTER;
        cell.cross_align = .CENTER;
        cell.gap = 2;
        UIK.panel_begin(cell);
        money := get_asset(Texture_Asset, "money_stack_1_f9a568.png");
        mh := UIK.layout_centered(UIK.pixels(96), UIK.pixels(96));
        UIK.panel_begin(mh);
        if money != null UIK.image_fitted(money, UIK.image_desc(.CONTAIN));
        UIK.panel_end();
        ct := UIK.text_title();
        UIK.text(cash_text, ct);
        UIK.panel_end(); // cell
    }
    UIK.panel_end(); // content

    // Right: title + price button.
    right := UIK.layout_column();
    right.width       = UIK.pixels(320);
    right.height      = UIK.flex(1);
    right.main_align  = .CENTER;
    right.cross_align = .CENTER;
    right.gap = 8;
    UIK.panel_begin(right);
    tt := UIK.text_title();
    UIK.text(title, tt);
    buy_h := draw_shop3_price_button(format_string("%_buy", {panel_id}), product_id, price_mat);
    UIK.panel_end(); // right

    UIK.panel_end(); // banner
    return buy_h;
}

// Square gamepass card: title + subtitle on top, icon over a ray burst, and a
// shader price button at the bottom. Returns the price button's Interact_Result.
draw_shop3_gamepass_card :: proc(panel_id: string, product_id: string, bg_mat: Material, ray_mat: Material, price_mat: Material, title: string, subtitle: string, icon: Texture_Asset) -> Interact_Result {
    card := UIK.layout_column();
    card.width                       = UIK.flex(1);
    card.height                      = UIK.pixels(230);
    card.gap                         = 4;
    card.padding                     = v4{12, 12, 12, 12};
    card.cross_align                 = .CENTER;
    card.show_background              = true;
    card.tint                        = v4{1, 1, 1, 1};
    card.background_sprite_override   = core_globals.white_sprite;
    card.background_material_override = bg_mat;
    h := UIK.panel_begin_interactive(panel_id, card);
    shop3_feed_rect(bg_mat, h.rect);

    UIK.text(title, UIK.text_title());
    if subtitle.count > 0 {
        st := UIK.text_body();
        st.set_size_mult(0.7);
        st.set_outline(true, 2.5, v4{0, 0, 0, 1});
        UIK.text(subtitle, st);
    }

    media := UIK.layout_centered(UIK.flex(1), UIK.flex(1));
    media.show_background              = true;
    media.tint                        = v4{1, 1, 1, 0.9};
    media.background_sprite_override   = core_globals.white_sprite;
    media.background_material_override = ray_mat;
    mh := UIK.panel_begin_interactive(format_string("%_rays", {panel_id}), media);
    shop3_feed_rect(ray_mat, mh.rect);
    holder := UIK.layout_centered(UIK.pixels(110), UIK.pixels(110));
    UIK.panel_begin(holder);
    if icon != null UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
    UIK.panel_end();
    UIK.panel_end(); // media

    buy_h := draw_shop3_price_button(format_string("%_buy", {panel_id}), product_id, price_mat);

    UIK.panel_end(); // card
    return buy_h;
}

draw_shop_v3 :: proc(player: Player) {
    if player == null return;
    if !player.show_shop_v3 return;
    if !shop3_ensure_materials() return; // shaders still loading

    UIK.begin(UIK.modal(UIK.rect_window(), 20));

    // Shell — interactive native modal panel. The banner and cards are nested
    // inside it; their Interact_Result.rect resolves fine (engine nesting fix).
    shell := UIK.panel_modal(.BLACK);
    shell.gap     = 10;
    shell.padding = v4{16, 16, 16, 16};
    UIK.panel_begin_interactive("shop3_shell", shell);

    exit_handle := UIK.title_area(UIK.title_area_desc("Store"));

    // Scrollable content — the banners overflow the modal, so everything below
    // the title lives in a scroll view.
    scroll_panel := UIK.layout_column();
    scroll_panel.width  = UIK.flex(1);
    scroll_panel.height = UIK.flex(1);
    scroll_panel.gap    = 10;
    UIK.list_begin("shop3_scroll", scroll_panel);

    // ---- PRIME pass banner ----
    banner_desc := UIK.layout_row();
    banner_desc.height                       = UIK.pixels(220);
    banner_desc.gap                          = 16;
    banner_desc.padding                      = v4{14, 14, 14, 14};
    banner_desc.cross_align                  = .CENTER;
    banner_desc.show_background              = true;
    banner_desc.tint                         = v4{1, 1, 1, 1};
    banner_desc.background_sprite_override   = core_globals.white_sprite;
    banner_desc.background_material_override = SHOP3_MAT_BANNER;
    h_banner := UIK.panel_begin_interactive("shop3_banner", banner_desc);
    shop3_feed_rect(SHOP3_MAT_BANNER, h_banner.rect);

    // PRIME icon over a spinning ray burst, with a breathing pulse. The icon
    // panel is interactive so the ray material gets its own rect (centered on
    // the icon rather than the whole banner).
    icon_panel := UIK.layout_centered(UIK.pixels(260), UIK.flex(1));
    icon_panel.show_background              = true;
    icon_panel.tint                         = v4{1, 1, 1, 0.9};
    icon_panel.background_sprite_override   = core_globals.white_sprite;
    icon_panel.background_material_override = SHOP3_MAT_RAY_BANNER;
    h_icon := UIK.panel_begin_interactive("shop3_prime_rays", icon_panel);
    shop3_feed_rect(SHOP3_MAT_RAY_BANNER, h_icon.rect);

    prime_pulse := sin(get_time() * PRIME_PULSE_SPEED);
    prime_size  := PRIME_ICON_BASE + prime_pulse * PRIME_PULSE_AMP;
    prime_holder := UIK.layout_centered(UIK.pixels(prime_size), UIK.pixels(prime_size));
    UIK.panel_begin(prime_holder);
    prime_icon := get_asset(Texture_Asset, "Textures/PRIME_Icon.png");
    if prime_icon != null UIK.image_fitted(prime_icon, UIK.image_desc(.CONTAIN));
    UIK.panel_end();
    UIK.panel_end(); // icon_panel

    text_col := UIK.layout_column();
    text_col.width      = UIK.flex(1);
    text_col.height     = UIK.flex(1);
    text_col.gap        = 4;
    text_col.main_align = .CENTER;
    UIK.panel_begin(text_col);
    UIK.text("PRIME Pass", UIK.text_title());
    sub_ts := UIK.text_title();
    UIK.text_set_size_mult(&sub_ts, 0.5);
    UIK.text("VIP floor + boosted brainrots", sub_ts);
    UIK.text("Auto-collects your coins", sub_ts);
    UIK.panel_end();

    _, prime_orig, prime_on_sale := product_pricing(PRIME_PASS_PRODUCT_ID);
    prime_struck_rect: Rect;
    price_col := UIK.layout_column();
    price_col.width       = UIK.pixels(300);
    price_col.height      = UIK.fit();
    price_col.cross_align = .CENTER;
    price_col.gap         = 2;
    UIK.panel_begin(price_col);
    if prime_on_sale prime_struck_rect = draw_shop3_struck_price(prime_orig);
    sub_handle := draw_shop3_price_button("shop3_sub", PRIME_PASS_PRODUCT_ID, SHOP3_MAT_PRICE);
    UIK.panel_end(); // price_col

    UIK.panel_end(); // banner

    // ---- Gamepasses header + cards ----
    UIK.spacer(UIK.pixels(1), UIK.pixels(6));
    UIK.text("Gamepasses", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));

    gp_row := UIK.layout_row();
    gp_row.width  = UIK.flex(1);
    gp_row.height = UIK.pixels(230);
    gp_row.gap    = 12;
    UIK.panel_begin(gp_row);
    money_icon := get_asset(Texture_Asset, "money_stack_1_f9a568.png");
    speed_icon := get_asset(Texture_Asset, "arrow_right_e47b99.png");
    money_h := draw_shop3_gamepass_card("shop3_2xmoney", TWO_X_MONEY_PRODUCT_ID, SHOP3_MAT_GP_MONEY, SHOP3_MAT_RAY_D, SHOP3_MAT_PRICE_C, "2X Money", "Earn double money!", money_icon);
    speed_h := draw_shop3_gamepass_card("shop3_2xspeed", TWO_X_SPEED_PRODUCT_ID, SHOP3_MAT_GP_SPEED, SHOP3_MAT_RAY_E, SHOP3_MAT_PRICE_D, "2X Speed", "Double your speed!", speed_icon);
    UIK.panel_end(); // gp_row

    // ---- Bundles header ----
    UIK.spacer(UIK.pixels(1), UIK.pixels(6));
    UIK.text("Bundles", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));

    // ---- Bundle banners ----
    bundles_col := UIK.layout_column();
    bundles_col.width  = UIK.flex(1);
    bundles_col.gap    = 12;
    UIK.panel_begin(bundles_col);

    starter_brainrots: [..]string;
    append(ref starter_brainrots, STARTER_PACK_BRAINROT);
    rainbow_brainrots: [..]string;
    append(ref rainbow_brainrots, "chimpanzini");
    append(ref rainbow_brainrots, "racooni");
    append(ref rainbow_brainrots, "garama");

    starter_h := draw_shop3_bundle("shop3_starter", STARTER_PACK_PRODUCT_ID, SHOP3_MAT_BUNDLE_A, SHOP3_MAT_RAY_A, SHOP3_MAT_PRICE_A, "Starter Pack!", starter_brainrots, "$100,000,000");
    rainbow_h := draw_shop3_bundle("shop3_rainbow", RAINBOW_PACK_PRODUCT_ID, SHOP3_MAT_BUNDLE_B, SHOP3_MAT_RAY_B, SHOP3_MAT_PRICE_B, "Rainbow Pack!", rainbow_brainrots, "");

    UIK.panel_end(); // bundles_col

    UIK.list_end();   // shop3_scroll
    UIK.panel_end();  // shell
    UIK.end();

    UI.push_screen_draw_context();
    UI.push_layer(25);
    // Diagonal strike line over the struck-through original price (bottom-left
    // to top-right, extended past the text), drawn here since UIK can't rotate.
    if prime_on_sale && prime_struck_rect.max.x > prime_struck_rect.min.x {
        sf   := UI.get_current_scale_factor();
        lo   := prime_struck_rect.min; // bottom-left (Y grows up)
        hi   := prime_struck_rect.max; // top-right
        dir  := normalize(hi - lo);
        ext  := 18.0 * sf;
        UI.line(lo - dir * ext, hi + dir * ext, 6.0 * sf, core_globals.white_sprite, v4{1.0, 0.15, 0.15, 1});
    }
    UI.pop_layer();
    UI.pop_draw_context();

    if UIK.clicked(exit_handle) {
        player.show_shop_v3 = false;
        player.shop3_popup_text = "";
        return;
    }
    if UIK.clicked(sub_handle) {
        if has_prime(player) {
            show_notification(player, "You already own PRIME!");
        } else {
            Purchasing.prompt_purchase(player, PRIME_PASS_PRODUCT_ID);
        }
    }
    if UIK.clicked(money_h)   Purchasing.prompt_purchase(player, TWO_X_MONEY_PRODUCT_ID);
    if UIK.clicked(speed_h)   Purchasing.prompt_purchase(player, TWO_X_SPEED_PRODUCT_ID);
    if UIK.clicked(starter_h) Purchasing.prompt_purchase(player, STARTER_PACK_PRODUCT_ID);
    if UIK.clicked(rainbow_h) Purchasing.prompt_purchase(player, RAINBOW_PACK_PRODUCT_ID);
}

// Card-click test popup — confirms a card click registered.
draw_shop_v3_popup :: proc(player: Player) {
    if player.shop3_popup_text == "" return;

    UIK.begin(UIK.modal(UIK.rect_window_small(), 30));

    shell := UIK.panel_modal(.BLUE);
    UIK.panel_begin(shell);

    exit_result := UIK.title_area(UIK.title_area_desc("Card Clicked"));
    if exit_result.clicked {
        player.shop3_popup_text = "";
    }

    UIK.spacer(UIK.pixels(1), UIK.flex(1));
    UIK.text(format_string("You clicked:\n%", {player.shop3_popup_text}), UIK.text_body());
    UIK.spacer(UIK.pixels(1), UIK.flex(1));

    ok_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_GREEN);
    ok_desc.panel.width  = UIK.flex(1);
    ok_desc.panel.height = UIK.pixels(90);
    ok_result := UIK.button("shop3_popup_ok", "OK", ok_desc);
    if ok_result.clicked {
        player.shop3_popup_text = "";
    }

    UIK.panel_end();
    UIK.end();
}

// Rotated "sale" sticker at a card's top-right corner. Legacy UI.* draw, so
// it must be called after UIK.end() inside a screen draw context.
draw_shop_v3_badge :: proc(card_rect: Rect, label: string) {
    badge_anchor := card_rect.top_right_rect().offset(-110, -70);
    badge_rect   := badge_anchor.grow(40, 90, 40, 90);
    ts := UI.default_text_settings();
    ts.size              = 36;
    ts.color             = v4{1.00, 0.92, 0.20, 1};
    ts.do_outline        = true;
    ts.outline_thickness = 4.0;
    ts.outline_color     = v4{0, 0, 0, 1};
    UI.push_matrix(Matrix4.rotate_about_point(badge_rect.center(), -18.0));
    UI.text(badge_rect, ts, label);
    UI.pop_matrix();
}

draw_shop_v3_card :: proc(name: string, price: s64, icon: Texture_Asset, button_id: string, bg_mat: Material, ray_mat: Material) -> Interact_Result {
    card_desc := UIK.layout_column();
    card_desc.gap                         = 6;
    card_desc.padding                     = v4{14, 14, 14, 14};
    card_desc.cross_align                 = .CENTER;
    card_desc.show_background              = true;
    card_desc.tint                        = v4{1, 1, 1, 1};
    card_desc.background_sprite_override   = core_globals.white_sprite;
    card_desc.background_material_override = bg_mat;
    handle := UIK.panel_begin_interactive(button_id, card_desc);
    // Feed the card rect to both the box material and the ray material — the
    // ray's media panel is nested inside this (interactive) card, so it can't
    // get its own rect; the ray simply centers in the card instead.
    shop3_feed_rect(bg_mat,  handle.rect);
    shop3_feed_rect(ray_mat, handle.rect);
    bg_mat.set_float("press", handle.active_t_eased); // darken the card while held

    UIK.text(name, UIK.text_button());

    // Rotating sun-ray burst — ray_spin draws it procedurally from the card
    // rect (already fed to ray_mat). The media panel is plain; the white
    // sprite is just a carrier so draw_panel_image doesn't early-return.
    media := UIK.layout_centered(UIK.flex(1), UIK.flex(1));
    media.show_background              = true;
    media.tint                        = v4{1, 0.95, 0.55, 0.85};
    media.background_sprite_override   = core_globals.white_sprite;
    media.background_material_override = ray_mat;
    UIK.panel_begin(media);
    if icon != null UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
    UIK.panel_end();

    spark := get_asset(Texture_Asset, "$AO/new/icons/sparks/spark_icon.png");
    UIK.currency(spark, price, UIK.text_title());

    UIK.panel_end();
    return handle;
}
