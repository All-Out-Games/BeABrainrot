// Shop v3 — UIK layout with box_panel / ray_spin shader backgrounds applied
// through Panel_Desc.background_material_override.
//
// panel_begin_interactive().rect only resolves for an interactive panel that
// is NOT nested inside another interactive panel. So the shell is a plain
// (non-interactive) native modal, and the banner + cards are the only
// interactive panels — none nested in another — so each gets a real rect,
// which is fed to its material as rect_px every frame.
//
// box_panel.aosl is shared with shop_v2 (it takes rect_px).
//
// Toggle with /shop3.

// ===== Materials ===== (one per panel — UIK batches draws at UIK.end()).

SHOP3_MAT_ORANGE:  Material;
SHOP3_MAT_YELLOW:  Material;
SHOP3_MAT_RAINBOW: Material;
SHOP3_MAT_PURPLE:  Material;
SHOP3_MAT_RAY_A:   Material; // spinning ray burst behind each card icon
SHOP3_MAT_RAY_B:   Material;
SHOP3_MAT_RAY_C:   Material;
SHOP3_MATS_READY:  bool;

shop3_make_box_material :: proc(box: Shop2_Box) -> Material {
    shader := get_asset(Shader_Asset, "shaders/box_panel.aosl");
    if shader == null return null;
    mat := Material.create(shader);
    mat.set_float4("top_color",         box.top);
    mat.set_float4("bottom_color",      box.bottom);
    mat.set_float ("dot_cell_px",       box.dot_cell);
    mat.set_float ("dot_min_radius",    box.dot_min_radius);
    mat.set_float ("dot_max_radius",    box.dot_max_radius);
    mat.set_float ("dot_alpha",         box.dot_alpha);
    mat.set_float ("bottom_band_h",     box.band_h);
    mat.set_float4("bottom_band_color", box.band_color);
    mat.set_float ("outline_px",        box.outline_px);
    mat.set_float4("outline_color",     box.outline_color);
    mat.set_float ("corner_radius_px",  box.corner_radius);
    mat.set_float ("rainbow_strength",  box.rainbow);
    mat.set_float ("rainbow_speed",     box.rainbow_speed);
    mat.set_float ("rainbow_hue_span",  box.rainbow_hue_span);
    return mat;
}

shop3_make_ray_material :: proc() -> Material {
    shader := get_asset(Shader_Asset, "shaders/ray_spin.aosl");
    if shader == null return null;
    mat := Material.create(shader);
    mat.set_float("spin_speed", 0.44); // ~25 deg/sec, matches v2
    mat.set_float("fill_scale", 1.6);  // overflow the media panel
    return mat;
}

shop3_ensure_materials :: proc() -> bool {
    if SHOP3_MATS_READY return true;
    SHOP3_MAT_ORANGE  = shop3_make_box_material(shop2_box_orange());
    SHOP3_MAT_YELLOW  = shop3_make_box_material(shop2_box_yellow());
    SHOP3_MAT_RAINBOW = shop3_make_box_material(shop2_box_rainbow());
    SHOP3_MAT_PURPLE  = shop3_make_box_material(shop2_box_purple());
    if SHOP3_MAT_ORANGE == null return false; // shader still loading
    SHOP3_MAT_RAY_A = shop3_make_ray_material();
    SHOP3_MAT_RAY_B = shop3_make_ray_material();
    SHOP3_MAT_RAY_C = shop3_make_ray_material();
    SHOP3_MATS_READY = true;
    return true;
}

// Feed a panel's resolved screen rect to its background material as rect_px.
shop3_feed_rect :: proc(mat: Material, r: Rect) {
    if mat == null return;
    mat.set_float4("rect_px", v4{r.min.x, r.min.y, r.max.x, r.max.y});
}

draw_shop_v3 :: proc(player: Player) {
    if player == null return;
    if !player.show_shop_v3 return;
    if !shop3_ensure_materials() return; // shaders still loading

    UIK.begin(UIK.modal(UIK.rect_window(), 20));

    // Shell — interactive native modal panel. The banner and cards are nested
    // inside it; their Interact_Result.rect resolves fine (engine nesting fix).
    shell := UIK.panel_modal(.BLACK);
    shell.gap     = 10;
    shell.padding = v4{16, 16, 16, 16};
    UIK.panel_begin_interactive("shop3_shell", shell);

    exit_handle := UIK.title_area(UIK.title_area_desc("Store"));

    // ---- Subscription banner ----
    banner_desc := UIK.layout_row();
    banner_desc.height                       = UIK.pixels(220);
    banner_desc.gap                          = 16;
    banner_desc.padding                      = v4{14, 14, 14, 14};
    banner_desc.show_background              = true;
    banner_desc.tint                         = v4{1, 1, 1, 1};
    banner_desc.background_sprite_override   = core_globals.white_sprite;
    banner_desc.background_material_override = SHOP3_MAT_ORANGE;
    h_banner := UIK.panel_begin_interactive("shop3_banner", banner_desc);
    shop3_feed_rect(SHOP3_MAT_ORANGE, h_banner.rect);

    icon_panel := UIK.layout_centered(UIK.pixels(180), UIK.flex(1));
    UIK.panel_begin(icon_panel);
    coin := get_asset(Texture_Asset, "Textures/UI/coin2_deef5c.png");
    if coin != null UIK.image_fitted(coin, UIK.image_desc(.CONTAIN));
    UIK.panel_end();

    text_col := UIK.layout_column();
    text_col.width      = UIK.flex(1);
    text_col.height     = UIK.flex(1);
    text_col.gap        = 4;
    text_col.main_align = .CENTER;
    UIK.panel_begin(text_col);
    UIK.text("Trade Pack Subscription", UIK.text_title());
    sub_ts := UIK.text_title();
    UIK.text_set_size_mult(&sub_ts, 0.55);
    UIK.text("First 20 are granted instantly!", sub_ts);
    UIK.panel_end();

    price_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_PURPLE);
    price_desc.panel.width  = UIK.pixels(220);
    price_desc.panel.height = UIK.pixels(100);
    spark_icon := get_asset(Texture_Asset, "$AO/new/icons/sparks/spark_icon.png");
    sub_handle := UIK.icon_button_label("shop3_sub", spark_icon, "100/mo", price_desc);

    UIK.panel_end(); // banner

    // ---- Section header ----
    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    UIK.text("Trade Tokens", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));

    // ---- Cards row (plain panel, so the cards inside are not nested in an
    //      interactive panel) ----
    cards_row := UIK.layout_row();
    cards_row.gap = 12;
    UIK.panel_begin(cards_row);

    coins_100  := get_asset(Texture_Asset, "Textures/UI/gold_coins_7fa0a9.png");
    coins_500  := get_asset(Texture_Asset, "Textures/UI/gold_coin_stacks_c55048.png");
    chest_2000 := get_asset(Texture_Asset, "Textures/UI/open-treasure-chest_1c03dc.png");

    h100  := draw_shop_v3_card("100 Trade Tokens",   100,  coins_100,  "shop3_buy_100",  SHOP3_MAT_YELLOW,  SHOP3_MAT_RAY_A);
    h500  := draw_shop_v3_card("500 Trade Tokens",   500,  coins_500,  "shop3_buy_500",  SHOP3_MAT_RAINBOW, SHOP3_MAT_RAY_B);
    h2000 := draw_shop_v3_card("2,000 Trade Tokens", 2000, chest_2000, "shop3_buy_2000", SHOP3_MAT_PURPLE,  SHOP3_MAT_RAY_C);

    UIK.panel_end(); // cards_row

    UIK.panel_end(); // shell
    UIK.end();

    // Rotated sale badges — drawn after UIK.end(): UIK text can't rotate, but
    // legacy UI.text + a rotation matrix can. Layer 25 sits above UIK content.
    // h500/h2000.rect are last frame's card rects (zero on frame 1 — skipped).
    UI.push_screen_draw_context();
    UI.push_layer(25);
    c500 := h500.rect;
    if c500.max.x > c500.min.x {
        draw_shop_v3_badge(c500, "+25 Free");
    }
    c2000 := h2000.rect;
    if c2000.max.x > c2000.min.x {
        draw_shop_v3_badge(c2000, "+100 Free");
    }
    UI.pop_layer();
    UI.pop_draw_context();

    if UIK.clicked(exit_handle) {
        player.show_shop_v3 = false;
        player.shop3_popup_text = "";
        return;
    }
    if UIK.clicked(sub_handle) {}
    if UIK.clicked(h100)  player.shop3_popup_text = "100 Trade Tokens";
    if UIK.clicked(h500)  player.shop3_popup_text = "500 Trade Tokens";
    if UIK.clicked(h2000) player.shop3_popup_text = "2,000 Trade Tokens";

    draw_shop_v3_popup(player);
}

// Card-click test popup — confirms a card click registered.
draw_shop_v3_popup :: proc(player: Player) {
    if player.shop3_popup_text == "" return;

    UIK.begin(UIK.modal(UIK.rect_window_small(), 30));

    shell := UIK.panel_modal(.BLUE);
    UIK.panel_begin(shell);

    exit_result := UIK.title_area(UIK.title_area_desc("Card Clicked"));
    if exit_result.clicked {
        player.shop3_popup_text = "";
    }

    UIK.spacer(UIK.pixels(1), UIK.flex(1));
    UIK.text(format_string("You clicked:\n%", {player.shop3_popup_text}), UIK.text_body());
    UIK.spacer(UIK.pixels(1), UIK.flex(1));

    ok_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_GREEN);
    ok_desc.panel.width  = UIK.flex(1);
    ok_desc.panel.height = UIK.pixels(90);
    ok_result := UIK.button("shop3_popup_ok", "OK", ok_desc);
    if ok_result.clicked {
        player.shop3_popup_text = "";
    }

    UIK.panel_end();
    UIK.end();
}

// Rotated "sale" sticker at a card's top-right corner. Legacy UI.* draw, so
// it must be called after UIK.end() inside a screen draw context.
draw_shop_v3_badge :: proc(card_rect: Rect, label: string) {
    badge_anchor := card_rect.top_right_rect().offset(-110, -70);
    badge_rect   := badge_anchor.grow(40, 90, 40, 90);
    ts := UI.default_text_settings();
    ts.size              = 36;
    ts.color             = v4{1.00, 0.92, 0.20, 1};
    ts.do_outline        = true;
    ts.outline_thickness = 4.0;
    ts.outline_color     = v4{0, 0, 0, 1};
    UI.push_matrix(Matrix4.rotate_about_point(badge_rect.center(), -18.0));
    UI.text(badge_rect, ts, label);
    UI.pop_matrix();
}

draw_shop_v3_card :: proc(name: string, price: s64, icon: Texture_Asset, button_id: string, bg_mat: Material, ray_mat: Material) -> Interact_Result {
    card_desc := UIK.layout_column();
    card_desc.gap                         = 6;
    card_desc.padding                     = v4{14, 14, 14, 14};
    card_desc.cross_align                 = .CENTER;
    card_desc.show_background              = true;
    card_desc.tint                        = v4{1, 1, 1, 1};
    card_desc.background_sprite_override   = core_globals.white_sprite;
    card_desc.background_material_override = bg_mat;
    handle := UIK.panel_begin_interactive(button_id, card_desc);
    // Feed the card rect to both the box material and the ray material — the
    // ray's media panel is nested inside this (interactive) card, so it can't
    // get its own rect; the ray simply centers in the card instead.
    shop3_feed_rect(bg_mat,  handle.rect);
    shop3_feed_rect(ray_mat, handle.rect);
    bg_mat.set_float("press", handle.active_t_eased); // darken the card while held

    UIK.text(name, UIK.text_button());

    // Rotating sun-ray burst — ray_spin draws it procedurally from the card
    // rect (already fed to ray_mat). The media panel is plain; the white
    // sprite is just a carrier so draw_panel_image doesn't early-return.
    media := UIK.layout_centered(UIK.flex(1), UIK.flex(1));
    media.show_background              = true;
    media.tint                        = v4{1, 0.95, 0.55, 0.85};
    media.background_sprite_override   = core_globals.white_sprite;
    media.background_material_override = ray_mat;
    UIK.panel_begin(media);
    if icon != null UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
    UIK.panel_end();

    spark := get_asset(Texture_Asset, "$AO/new/icons/sparks/spark_icon.png");
    UIK.currency(spark, price, UIK.text_title());

    UIK.panel_end();
    return handle;
}
