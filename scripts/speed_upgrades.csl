SPARKS_CURRENCY :: "Sparks";

BASE_SPEED :: 18;

// --- Real movement tuning ---
// agent.movement_speed scales LINEARLY from BASE_AGENT_SPEED at stat BASE_SPEED
// up to MAX_AGENT_SPEED at stat SPEED_STAT_AT_MAX, then flattens.
//   stat 18  -> 300  agent speed (engine default per AGENTS.md)
//   stat 300 -> 2500 agent speed (cap)
// Defining it by endpoints keeps the cap meaningful for the chase clamp — a
// stat-109 chaser and a stat-280 player end up at clearly different speeds.
BASE_AGENT_SPEED  :: 300.0;
MAX_AGENT_SPEED   :: 2500.0;
SPEED_STAT_AT_MAX :: 300;

// --- Price curve (from game reference) ---
// Cost grows as a cumulative product whose multiplier itself grows with speed:
//   m(S) = SPEED_PRICE_MULT_START + (S - BASE_SPEED) * SPEED_PRICE_MULT_GROW
// cost_plus_1(S) = 100 * prod(m(18), m(19), ..., m(S-1))
SPEED_PRICE_BASE       :: 100.0;
SPEED_PRICE_MULT_START :: 1.165;
SPEED_PRICE_MULT_GROW  :: 0.0002;

speed_price_mult_at :: proc(s: s64) -> float {
    return SPEED_PRICE_MULT_START + (s - BASE_SPEED).(float) * SPEED_PRICE_MULT_GROW;
}

speed_price_single_at :: proc(s: s64) -> float {
    cost := SPEED_PRICE_BASE;
    for i: BASE_SPEED..s - 1 {
        cost *= speed_price_mult_at(i);
    }
    return cost;
}

compute_agent_movement_speed :: proc(stat_speed: s64) -> float {
    over := (stat_speed - BASE_SPEED).(float);
    if over < 0 over = 0;
    span := (SPEED_STAT_AT_MAX - BASE_SPEED).(float);
    t := over / span;
    if t > 1.0 t = 1.0;
    return BASE_AGENT_SPEED + (MAX_AGENT_SPEED - BASE_AGENT_SPEED) * t;
}

// Same linear curve as compute_agent_movement_speed but WITHOUT the cap, so
// stats above SPEED_STAT_AT_MAX still differentiate. Used only by NPC chasers
// for their speed comparison — a stat-339 chaser must read as faster than a
// stat-309 player even though both players' real movement caps at MAX_AGENT_SPEED.
compute_agent_movement_speed_uncapped :: proc(stat_speed: s64) -> float {
    over := (stat_speed - BASE_SPEED).(float);
    if over < 0 over = 0;
    span := (SPEED_STAT_AT_MAX - BASE_SPEED).(float);
    per_stat := (MAX_AGENT_SPEED - BASE_AGENT_SPEED) / span;
    return BASE_AGENT_SPEED + over * per_stat;
}

speed_upgrade_cash_cost :: proc(current_speed: s64, amount: s64) -> float {
    if amount <= 0 return 0;
    cost := speed_price_single_at(current_speed);
    total := cost;
    for i: current_speed..current_speed + amount - 2 {
        cost *= speed_price_mult_at(i);
        total += cost;
    }
    return total;
}

// Sparks price now lives on the product itself — query via
// `Purchasing.get_product(speed_skip_product_id(speed)).price`.

// Local "ka-ching" played for the buyer on any speed upgrade purchase.
play_speed_buy_sfx :: proc(player: Player) {
    if player == null return;
    sfx := get_asset(SFX_Asset, "SFX/gain_money_03.wav");
    if sfx == null return;
    desc := SFX.default_sfx_desc();
    desc.specific_to_player = player;
    desc.positional = false;
    desc.volume = 0.7;
    SFX.play(sfx, desc);
}

try_buy_speed_upgrade_cash :: proc(player: Player, amount: s64) -> bool {
    cash_cost := speed_upgrade_cash_cost(player.speed, amount);
    if player.cash < cash_cost {
        show_notification(player, "Not enough Cash!");
        return false;
    }
    withdraw_cash(player, cash_cost);
    add_speed(player, amount);
    play_speed_buy_sfx(player);
    return true;
}

// Triggers the All Out purchase prompt for the tier's SpeedSkip product. All
// three sparks buttons (rows +1/+5/+10) prompt the same product and always
// grant +10 speed via ao_purchase_handler.
prompt_buy_speed_upgrade_sparks :: proc(player: Player) {
    id := speed_skip_product_id(player.speed);
    if id.count == 0 return;
    Purchasing.prompt_purchase(player, id);
}

Speed_Upgrade_Row_Handles :: struct {
    cash: Interact_Result;
}

Speed_Upgrade_Handles :: struct {
    exit:   Interact_Result;
    sparks: Interact_Result; // single sparks CTA below all rows
    row_1:  Speed_Upgrade_Row_Handles;
    row_5:  Speed_Upgrade_Row_Handles;
    row_10: Speed_Upgrade_Row_Handles;
}

// ----- Shader-backed UI (box_panel.aosl) -----
// One material per interactive panel: rect_px is set per-frame and the last
// write wins, so each of the three cash buttons gets its own material
// instance. The sparks CTA is a single button below all rows so it only
// needs one material.

SPEED_MAT_SHELL:  Material;
SPEED_MAT_CASH_A: Material;
SPEED_MAT_CASH_B: Material;
SPEED_MAT_CASH_C: Material;
SPEED_MAT_SPARKS: Material;
SPEED_MATS_READY: bool;

speed_make_box_material :: proc(box: Shop2_Box) -> Material {
    shader := get_asset(Shader_Asset, "shaders/box_panel.aosl");
    if shader == null return null;
    mat := Material.create(shader);
    mat.set_float4("top_color",         box.top);
    mat.set_float4("bottom_color",      box.bottom);
    mat.set_float ("dot_cell_px",       box.dot_cell);
    mat.set_float ("dot_min_radius",    box.dot_min_radius);
    mat.set_float ("dot_max_radius",    box.dot_max_radius);
    mat.set_float ("dot_alpha",         box.dot_alpha);
    mat.set_float ("bottom_band_h",     box.band_h);
    mat.set_float4("bottom_band_color", box.band_color);
    mat.set_float ("outline_px",        box.outline_px);
    mat.set_float4("outline_color",     box.outline_color);
    mat.set_float ("corner_radius_px",  box.corner_radius);
    mat.set_float ("rainbow_strength",  box.rainbow);
    mat.set_float ("rainbow_speed",     box.rainbow_speed);
    mat.set_float ("rainbow_hue_span",  box.rainbow_hue_span);
    mat.set_float ("shine_strength",    0.0);
    mat.set_float ("shine_speed",       1.0);
    return mat;
}

speed_feed_rect :: proc(mat: Material, r: Rect) {
    if mat == null return;
    mat.set_float4("rect_px", v4{r.min.x, r.min.y, r.max.x, r.max.y});
}

speed_ensure_materials :: proc() -> bool {
    if SPEED_MATS_READY return true;

    // Sky-blue shell — bright at the top fading to a deep navy at the bottom,
    // distinct from the rebirth indigo and from the cash/sparks colors.
    shell_box := shop2_box_dark();
    shell_box.top            = v4{0.28, 0.52, 0.85, 1};
    shell_box.bottom         = v4{0.08, 0.20, 0.42, 1};
    shell_box.dot_cell       = 28.0;
    shell_box.dot_min_radius = 0.0;
    shell_box.dot_max_radius = 0.22;
    shell_box.dot_alpha      = 0.10;
    shell_box.band_color     = v4{0.55, 0.80, 1.00, 1};
    shell_box.band_h         = 0.0;
    shell_box.corner_radius  = 24.0;
    shell_box.outline_px     = 4.0;

    green_box  := shop2_box_green();
    yellow_box := shop2_box_yellow();

    SPEED_MAT_SHELL  = speed_make_box_material(shell_box);
    SPEED_MAT_CASH_A = speed_make_box_material(green_box);
    SPEED_MAT_CASH_B = speed_make_box_material(green_box);
    SPEED_MAT_CASH_C = speed_make_box_material(green_box);
    SPEED_MAT_SPARKS = speed_make_box_material(yellow_box);
    if SPEED_MAT_SHELL == null return false;

    // Shine on the sparks CTA — pulls the eye to the paid option (same pattern
    // as the Skip Rebirth button in the rebirth modal).
    SPEED_MAT_SPARKS.set_float("shine_strength", 1.0);
    SPEED_MAT_SPARKS.set_float("shine_speed",    1.2);

    SPEED_MATS_READY = true;
    return true;
}

// Full-width horizontal separator between rows. UIK.divider sometimes shrinks
// (apparent width depends on sibling content), so we draw an explicit flex(1)
// panel with a translucent white background instead.
draw_speed_separator :: proc() {
    sep := UIK.layout_row();
    sep.width                       = UIK.flex(1);
    sep.height                      = UIK.pixels(2);
    sep.show_background             = true;
    sep.tint                        = v4{1, 1, 1, 0.35};
    sep.background_sprite_override  = core_globals.white_sprite;
    UIK.panel_begin(sep);
    UIK.panel_end();
}

// Shader-backed button — same pattern as the rebirth modal's. Sized as a
// flex(1) row so it fills the right column of each upgrade row.
speed_shader_button :: proc(id: string, label: string, mat: Material, disabled: bool = false, icon: Texture_Asset = null) -> Interact_Result {
    btn := UIK.layout_row();
    btn.width                       = UIK.flex(1);
    btn.height                      = UIK.pixels(55);
    btn.gap                         = 6;
    btn.main_align                  = .CENTER;
    btn.cross_align                 = .CENTER;
    btn.show_background              = true;
    btn.tint                        = v4{1, 1, 1, 1};
    btn.background_sprite_override   = core_globals.white_sprite;
    btn.background_material_override = mat;
    h := UIK.panel_begin_interactive(id, btn, disabled);
    speed_feed_rect(mat, h.rect);
    mat.set_float("press", h.active_t_eased);
    if icon != null {
        icon_holder := UIK.layout_centered(UIK.pixels(24), UIK.pixels(24));
        UIK.panel_begin(icon_holder);
        UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
        UIK.panel_end();
    }
    UIK.text(label, UIK.text_button());
    UIK.panel_end();
    return h;
}

draw_speed_upgrade_row :: proc(player: Player, amount: s64, id_suffix: string, cash_mat: Material) -> Speed_Upgrade_Row_Handles {
    row := UIK.layout_row();
    row.width = UIK.flex(1);
    row.height = UIK.flex(1);
    row.padding = v4{16, 12, 16, 12};
    row.gap = 16;
    row.cross_align = .CENTER;
    UIK.panel_begin(row);

    // Left: amount tag
    tag := UIK.layout_centered(UIK.pixels(90), UIK.pixels(90));
    UIK.panel_begin(tag);
    UIK.text(format_string("+%", {amount}), UIK.text_title());
    UIK.panel_end();

    // Middle: label + speed transition
    middle := UIK.layout_column();
    middle.width = UIK.flex(1);
    middle.height = UIK.flex(1);
    middle.main_align = .CENTER;
    middle.cross_align = .CENTER;
    middle.gap = 6;
    UIK.panel_begin(middle);
    UIK.text(format_string("+% Speed", {amount}), UIK.text_title());
    UIK.text(format_string("% -> %", {player.speed, player.speed + amount}), UIK.text_body());
    UIK.panel_end();

    // Right: cash button only — the sparks CTA lives once below all rows.
    right := UIK.layout_column();
    right.width = UIK.pixels(220);
    right.height = UIK.flex(1);
    right.main_align = .CENTER;
    UIK.panel_begin(right);

    cash_cost := speed_upgrade_cash_cost(player.speed, amount);

    handles: Speed_Upgrade_Row_Handles;
    handles.cash = speed_shader_button(format_string("speed_buy_cash_%", {id_suffix}), format_cash(cash_cost), cash_mat);

    UIK.panel_end(); // right
    UIK.panel_end(); // row

    return handles;
}

draw_speed_upgrade_ui :: proc(player: Player) {
    if !player.show_speed_upgrades return;
    if !speed_ensure_materials() return;

    // Compact modal sized to the 3-row content (grow args: top, right, bottom, left).
    modal_rect := UI.get_safe_screen_rect().center_rect().grow(380, 460, 380, 460);
    UIK.begin(UIK.modal(modal_rect, 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap                        = 4;
    shell.show_background              = true;
    shell.tint                       = v4{1, 1, 1, 1};
    shell.background_sprite_override   = core_globals.white_sprite;
    shell.background_material_override = SPEED_MAT_SHELL;
    shell_h := UIK.panel_begin_interactive("speed_shell", shell);
    speed_feed_rect(SPEED_MAT_SHELL, shell_h.rect);

    handles: Speed_Upgrade_Handles;
    title_desc := UIK.title_area_desc("SPEED UPGRADES");
    title_desc.tint = v4{0.02, 0.06, 0.22, 1};
    handles.exit = UIK.title_area(title_desc);

    body := UIK.layout_column();
    body.width = UIK.flex(1);
    body.height = UIK.flex(1);
    body.padding = v4{16, 8, 16, 8};
    body.gap = 8;
    UIK.panel_begin(body);

    // Reassure paying players that sparks-bought speed is permanent — it
    // survives the speed reset on rebirth via player.purchased_speed.
    perm_note := UIK.text_body();
    perm_note.set_color({0.7, 0.85, 1.0, 1});
    perm_note.set_word_wrap(false);
    UIK.text("Sparks-bought speed is permanent, kept on rebirth.", perm_note);

    handles.row_1  = draw_speed_upgrade_row(player, 1,  "1",  SPEED_MAT_CASH_A);
    draw_speed_separator();
    handles.row_5  = draw_speed_upgrade_row(player, 5,  "5",  SPEED_MAT_CASH_B);
    draw_speed_separator();
    handles.row_10 = draw_speed_upgrade_row(player, 10, "10", SPEED_MAT_CASH_C);

    // Single big sparks CTA — buys the tier's +10 product no matter what.
    sparks_id := speed_skip_product_id(player.speed);
    sparks_price: s64 = 0;
    if sparks_id.count > 0 sparks_price = Purchasing.get_product(sparks_id).price;
    spark_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/sparks/spark_medium.png");

    sparks_btn := UIK.layout_row();
    sparks_btn.width                       = UIK.flex(1);
    sparks_btn.height                      = UIK.pixels(80);
    sparks_btn.gap                         = 10;
    sparks_btn.main_align                  = .CENTER;
    sparks_btn.cross_align                 = .CENTER;
    sparks_btn.show_background              = true;
    sparks_btn.tint                        = v4{1, 1, 1, 1};
    sparks_btn.background_sprite_override   = core_globals.white_sprite;
    sparks_btn.background_material_override = SPEED_MAT_SPARKS;
    sparks_h := UIK.panel_begin_interactive("speed_buy_sparks", sparks_btn, sparks_id.count == 0);
    speed_feed_rect(SPEED_MAT_SPARKS, sparks_h.rect);
    SPEED_MAT_SPARKS.set_float("press", sparks_h.active_t_eased);

    UIK.text("+10 Speed for", UIK.text_button());
    spark_holder := UIK.layout_centered(UIK.pixels(32), UIK.pixels(32));
    UIK.panel_begin(spark_holder);
    if spark_tex != null UIK.image_fitted(spark_tex, UIK.image_desc(.CONTAIN));
    UIK.panel_end();
    UIK.text(format_string("%", {sparks_price}), UIK.text_button());

    UIK.panel_end(); // sparks_btn
    handles.sparks = sparks_h;

    UIK.panel_end(); // body
    UIK.panel_end(); // shell
    UIK.end();

    // Stash the first cash button rect for the tutorial arrow (this frame).
    player.speed_upgrade_rect       = handles.row_1.cash.rect;
    player.speed_upgrade_rect_frame = get_frame_number();

    if UIK.clicked(handles.exit) player.show_speed_upgrades = false;
    if UIK.clicked(handles.row_1.cash)  { if try_buy_speed_upgrade_cash(player, 1)  tutorial_advance(player, TUT_BUY_SPEED); }
    if UIK.clicked(handles.row_5.cash)  { if try_buy_speed_upgrade_cash(player, 5)  tutorial_advance(player, TUT_BUY_SPEED); }
    if UIK.clicked(handles.row_10.cash) { if try_buy_speed_upgrade_cash(player, 10) tutorial_advance(player, TUT_BUY_SPEED); }
    if UIK.clicked(handles.sparks)      prompt_buy_speed_upgrade_sparks(player);
}

